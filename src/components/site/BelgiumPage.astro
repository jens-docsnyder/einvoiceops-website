---
import StoryPage from './StoryPage.astro';
import { be, beBodies, beBodyKeys } from '../../data/stories/be';
import { storyFor } from '../../i18n/stories';
import fanoutFile from '../../data/fanout/BE.json';
import { publications, withBodies, warnBodies } from './format';

// Published at /belgium/, linked from the home page and the top bar. Fan-out data: src/data/fanout/BE.json, written from the product
// data after each weekly run; no count on the page is typed.
//
// Every change in the file carries its issuing body (key "body": law, administration). beBodies in be.ts is only a
// fallback for a change the file gives none; a change with neither stops the build and is named. The split by body, the
// counts since go-live and the box count are computed from the file (format.ts). A body the copy does not list only warns
// in the build log. A box is one publication per issuing body per day, so a day on which two bodies both published is two
// boxes and the split by body always adds up to the boxes.
// What stops the build: the list of changes and the released total disagree (publications() has no answer then), or a
// change has no body.
if ((fanoutFile.changes ?? []).length !== fanoutFile.total) {
  throw new Error(`Belgium page: BE.json holds ${(fanoutFile.changes ?? []).length} changes but a total of ${fanoutFile.total}; the boxes and the counts would disagree.`);
}
if (!publications(fanoutFile)) {
  throw new Error('Belgium page: the changes list does not agree with the released total; the box count cannot be checked.');
}
const fanout = withBodies(fanoutFile, beBodies, 'Belgium page: BE.json');
warnBodies('Belgium page', fanout, beBodyKeys);
const { locale = 'en' } = Astro.props;
const c = storyFor('be', 'be', be, locale);
---
<StoryPage locale={locale} c={c} fanout={fanout} page="/belgium/" segment="standalone" country="BE" followedDisclosure={c.disclosure} />
