---
// The contact section, id="contact". The submit posts the message to the form service (Formspree) as JSON, which emails it
// to jens@einvoiceops.eu; the done line shows only when the service says it took the message. If the post fails, the page
// says so and gives the address, and nothing claims the message went.
// A form on a page in another language also carries a hidden `language` field (the page's locale code) and sends it, so
// the message shows which language's page it came from. The English page carries no such field and sends none: the English
// build stays byte-identical to what it was, and the receiving side treats a message without `language` as English.
// `page` is the address of the page the form is on, in its own language.
import { dictionary } from '../../i18n/dictionaries/index';
import { contactScript } from './contact-script';
import type { Locale } from '../../i18n/registry';

interface Props {
  copy: { h2: any; name: string; email: string; message: string; send: string; done: any; after?: any; hint?: any; mailto?: string };
  page: string;
  segment: string;
  country: string;
  tone?: 'white' | 'tint';
  // Flow C: the person you write to, beside the form: photo, name and email address, no career lines.
  // With a person, the section is one card: photo column left, form right, and copy.hint under the address.
  person?: { name: string; email: string; photo: string; linkedin?: string };
  t: (v: any) => string;
  locale?: Locale;
}
const { copy, page, segment, country, tone = 'tint', person, t, locale = 'en' } = Astro.props;
const ui = dictionary(locale);
const translated = locale !== 'en';
const mail = copy.mailto || 'jens@einvoiceops.eu';
const formError = ui.formError.replace('{mail}', `<a href="mailto:${mail}">${mail}</a>`);
const script = contactScript(ui.formSending, translated);
---
<section class={`band band-${tone} cf-section${person ? ' cf-with-person' : ''}`} id="contact">
  <div class="wrap">
    <h2 class="band-h cf-h" set:html={t(copy.h2)}></h2>
    <div class={person ? 'cf-grid' : undefined}>
    {person && (
      <div class="cf-person">
        <img class="cf-photo" src={person.photo} alt={person.name} width="150" height="150" loading="lazy" />
        <p class="cf-name">{person.name}{person.linkedin && (
          <a class="cf-in" href={person.linkedin} target="_blank" rel="noopener" aria-label={ui.linkedinLabel.replace('{name}', person.name)}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}</p>
        <p class="cf-mail"><a href={`mailto:${person.email}`}>{person.email}</a></p>
        {copy.hint && <p class="cf-hint" set:html={t(copy.hint)}></p>}
      </div>
    )}
    <div class={person ? 'cf-main' : undefined}>
    <form class="cf-form" id="cf-form" onsubmit="return false" novalidate={false} data-mailto={copy.mailto} data-page={page} data-segment={segment} data-country={country}>
      <input type="hidden" name="page" value={page} />
      <input type="hidden" name="segment" value={segment} />
      <input type="hidden" name="country" value={country} />{translated && <input type="hidden" name="language" value={locale} />}
      <input type="hidden" name="lead" value="" />
      <input type="hidden" name="link" value="" />
      <input class="cf-trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="cf-pair">
        <div>
          <label class="cf-label" for="cf-name">{copy.name}</label>
          <input class="cf-input" id="cf-name" name="name_company" type="text" required autocomplete="organization" />
        </div>
        <div>
          <label class="cf-label" for="cf-email">{copy.email}</label>
          <input class="cf-input" id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>
      <label class="cf-label" for="cf-message">{copy.message}</label>
      <textarea class="cf-input cf-area" id="cf-message" name="message" rows="5" required></textarea>
      <button class="btn cf-send" type="submit">{copy.send}</button>
      {copy.after && <p class="cf-after quiet" set:html={t(copy.after)}></p>}
      <p class="cf-error" id="cf-error" role="alert" hidden set:html={formError}></p>
    </form>
    <p class="cf-done measure" id="cf-done" role="status" hidden set:html={t(copy.done)}></p>
    </div>
    </div>
  </div>
</section>

<script is:inline set:html={script}></script>

<style is:global>
  .cf-form { margin-top: 24px; max-width: 760px; }
  .cf-form[hidden] { display: none; }
  .cf-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; }
  .cf-label { display: block; margin: 16px 0 4px; font-size: 0.95rem; font-weight: 600; }
  .cf-input { display: block; width: 100%; min-height: 44px; font: inherit; color: var(--ink); background: #ffffff; border: 1px solid var(--box-border); border-radius: 0; padding: 9px 12px; }
  .cf-input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
  .cf-area { resize: vertical; min-height: 120px; }
  .cf-send { margin-top: 22px; }
  .cf-after { margin: 12px 0 0; font-size: 0.9rem; max-width: 60ch; }
  .cf-done { margin-top: 24px; }
  .cf-error { margin: 14px 0 0; font-weight: 600; }
  .cf-error[hidden] { display: none; }
  .cf-trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  /* One card with the page's orange top line, the photo column tinted. */
  .cf-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); margin-top: 28px; background: var(--page); border: 1px solid var(--box-border); border-top: 3px solid var(--accent); }
  .cf-grid .cf-form { margin-top: 0; max-width: none; }
  .cf-grid .cf-label { margin-top: 18px; }
  .cf-grid .cf-pair .cf-label, .cf-grid .cf-form > .cf-label:first-of-type { margin-top: 0; }
  .cf-grid .cf-pair { margin-bottom: 18px; }
  .cf-grid .cf-area { min-height: 190px; }
  .cf-person { background: var(--tint); padding: 36px 32px; border-right: 1px solid var(--inner-rule); }
  .cf-person p { margin: 0; }
  /* Smaller than the column: the full-width photo was too imposing. */
  .cf-photo { display: block; width: 150px; height: 150px; object-fit: cover; border: 1px solid var(--box-border); }
  .cf-person .cf-name { font-family: var(--serif); font-size: 1.3rem; font-weight: 700; margin-top: 20px; }
  /* A LinkedIn icon beside the name links to the profile when the page gives one; the name itself
     stays plain text. The icon takes the text colour, the accent on hover, and a tap area of 32 px. */
  .cf-person .cf-name .cf-in { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; margin-left: 6px; vertical-align: middle; color: inherit; }
  .cf-person .cf-name .cf-in:hover { color: var(--accent); }
  .cf-mail a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .cf-hint { margin-top: 12px !important; padding-top: 16px; border-top: 1px solid var(--inner-rule); color: var(--quiet); font-size: 0.98rem; }
  .cf-main { padding: 36px 40px; }
  @media (max-width: 859px) {
    .cf-grid { display: block; }
    .cf-person { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: 18px; align-items: start; padding: 24px 20px; border-right: 0; border-bottom: 1px solid var(--inner-rule); }
    .cf-photo { grid-row: 1 / span 2; width: 112px; height: 112px; }
    .cf-person .cf-name { margin-top: 0; align-self: end; }
    .cf-person .cf-mail { align-self: start; }
    .cf-hint { grid-column: 1 / -1; margin-top: 16px !important; }
    .cf-main { padding: 24px 20px; }
  }
  /* At 420 px and under the address (173 px) is wider than the column beside the photo: it takes the row below instead. */
  @media (max-width: 420px) { .cf-photo { grid-row: 1; } .cf-person .cf-mail { grid-column: 1 / -1; margin-top: 8px; } }
  /* At 420 px and under the name and the LinkedIn icon have to share the 144 px beside the photo (#1203): the photo is 96 px,
     the name a little smaller and kept on one line, and the icon keeps its 32 px tap area with a smaller gap, so the icon
     stays on the name's line at 320 px with no sideways scroll. */
  @media (max-width: 420px) {
    .cf-person { grid-template-columns: 96px minmax(0, 1fr); column-gap: 14px; }
    .cf-photo { width: 96px; height: 96px; }
    .cf-person .cf-name { font-size: 1.15rem; white-space: nowrap; }
    .cf-person .cf-name .cf-in { margin-left: 2px; }
  }
  @media (max-width: 639px) { .cf-pair { display: block; } .cf-pair > div + div .cf-label { margin-top: 18px !important; } }
</style>
