---
// The home page (Website - page and site structure.md, part 2, "The home page under this standard"): the opening, the
// country pages as cards with their live counts, the six functions, starting and the limits, the countries again.
// The countries and their order come from src/data/countries.ts and each count from that country's fan-out file, counted
// exactly as the country page's proof strip counts it (publications() in format.ts), so the two never disagree.
// "Get in touch" and "Get started" go to the contact form at the foot of the page, the same form the country pages carry.
import Site from '../../layouts/Site.astro';
import StartAndLimits from './StartAndLimits.astro';
import ContactForm from './ContactForm.astro';
import { home } from '../../data/stories/home';
import { homeContact } from '../../data/stories/home-contact';
import { storyFor } from '../../i18n/stories';
import { countryPagesFor, countryNav } from '../../data/countries';
import { publications, longDate, withBodies } from './format';
import { dictionary } from '../../i18n/dictionaries/index';
import { urlFor } from '../../i18n/registry';
import { deBodies } from '../../data/stories/de';
import { beBodies } from '../../data/stories/be';
import fr from '../../data/fanout/FR.json';
import de from '../../data/fanout/DE.json';
import be from '../../data/fanout/BE.json';
import frFns from '../../data/changefns/FR.json';
import deFns from '../../data/changefns/DE.json';
import beFns from '../../data/changefns/BE.json';
import frLines from '../../data/changelines/FR.json';
import deLines from '../../data/changelines/DE.json';
import beLines from '../../data/changelines/BE.json';
import bodyNames from '../../data/changelines/bodies.json';

// Each file gets the same issuing-body fallback its country page gives it, so the two counts can never disagree.
// Which functions each counted change touched, by change id (src/data/changefns). A stand-in until the weekly feed carries
// this list in the fan-out file itself; a change with no entry is drawn as not yet sorted, never as touching nothing.
const touched: Record<string, Record<string, string[]>> = { FR: frFns.functions, DE: deFns.functions, BE: beFns.functions };
// The plain-language line of each change that has one (src/data/changelines), a stand-in like the list above; a change without one shows its date and issuing body only.
const linesOf: Record<string, Record<string, { text: string; domain: string }>> = { FR: frLines.lines, DE: deLines.lines, BE: beLines.lines };
const fanouts: Record<string, any> = {
  FR: withBodies(fr, {}, 'Home page: FR.json'),
  DE: withBodies(de, deBodies, 'Home page: DE.json'),
  BE: withBodies(be, beBodies, 'Home page: BE.json'),
};
// The home page is also rendered in the other languages (src/i18n/locale-home.astro); the card and country links then follow the link rule.
const { locale = 'en' } = Astro.props;
const ui = dictionary(locale);
const c = storyFor('home', 'home', home, locale);
const contact = storyFor('home-contact', 'homeContact', homeContact, locale);
const links = countryPagesFor(locale);
// The copy holds {name}-style placeholders (see home.ts); this fills them.
const put = (text: string, vars: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
const cards = links.map((l) => {
  const d = fanouts[l.cc];
  const pubs = publications(d);
  if (!pubs) throw new Error(`Home page: ${l.cc}.json, the changes list does not agree with the released total`);
  // The matrix: one column per month from the count's start to the last check, one sub-column for each change (publication)
  // in the month it was published, and a row for each of the six functions, lit where the change touched it. The columns come
  // from the same list as the number, so the two cannot disagree.
  const monthAt = (date: string) => (Number(date.slice(0, 4)) - Number(d.since.slice(0, 4))) * 12 + (Number(date.slice(5, 7)) - Number(d.since.slice(5, 7)));
  type Col = { date: string; fns: Set<string> | null; idx: number };
  const byPub = new Map<string, { date: string; body: string; ids: string[] }>();
  for (const ch of d.changes) {
    const key = `${ch.date}\u0000${ch.body ?? ''}`;
    if (!byPub.has(key)) byPub.set(key, { date: ch.date, body: ch.body ?? '', ids: [] });
    byPub.get(key)!.ids.push(ch.id);
  }
  const months: Col[][] = Array.from({ length: monthAt(d.checked_on) + 1 }, () => []);
  // What the hover panel shows, one entry per column in the order the columns run: the date, the issuing body and each change's line.
  const names: string[] = c.functions.names;
  const pubsData: any[] = [];
  for (const { date, body, ids } of [...byPub.values()].sort((x, y) => (x.date < y.date ? -1 : x.date > y.date ? 1 : 0))) {
    const i = monthAt(date);
    if (i < 0 || i >= months.length) throw new Error(`Home page: ${l.cc}.json, a change dated ${date} falls outside ${d.since} to ${d.checked_on}`);
    const lists = ids.map((id) => touched[l.cc][id]);
    months[i].push({ date, fns: lists.some((x) => !x) ? null : new Set(lists.flat()), idx: pubsData.length });
    pubsData.push({ q: Math.floor((i + ((Number(d.since.slice(5, 7)) - 1) % 3)) / 3), d: longDate(date, locale), b: (bodyNames as any)[l.cc]?.[body] ?? body, ch: ids.map((id, j) => ({ f: (lists[j] ?? []).map((n) => names.indexOf(n)), t: linesOf[l.cc][id]?.text ?? '', w: linesOf[l.cc][id]?.domain ?? '' })) });
  }
  // What a card shows before anyone points at it, and again after a click anywhere that is not a square: the first function's whole row, every change in time order.
  const def = { fn: 0, pub: null, q: null };
  if (months.reduce((a, m) => a + m.length, 0) !== pubs.length) throw new Error(`Home page: ${l.cc}.json, the matrix and the count disagree`);
  const widths = months.map((m) => Math.max(1, m.length));
  const total = widths.reduce((a, b) => a + b, 0);
  // The time axis in quarters (Q1 to Q4), the year written under each Q1 and under the first quarter shown.
  const startQ = Math.floor((Number(d.since.slice(5, 7)) - 1) / 3);
  const quarters: { label: string; full: string; year: string; left: number }[] = [];
  for (let k = 0; ; k++) {
    const q = (startQ + k) % 4;
    const y = Number(d.since.slice(0, 4)) + Math.floor((startQ + k) / 4);
    const idx = Math.max(0, monthAt(`${y}-${String(q * 3 + 1).padStart(2, '0')}`));
    if (idx >= widths.length) break;
    quarters.push({ label: `Q${q + 1}`, full: `Q${q + 1} ${y}`, year: q === 0 || k === 0 ? String(y) : '', left: (widths.slice(0, idx).reduce((a, b) => a + b, 0) / total) * 100 });
  }
  // The phone's version of the matrix: for each function and quarter, how many of that quarter's changes touched it, shaded by the count.
  const qCount = names.map((_n, fi) => quarters.map((_q, qi) => pubsData.filter((p) => p.q === qi && p.ch.some((x: any) => x.f.includes(fi))).length));
  const qMax = Math.max(1, ...qCount.flat());
  const perFn = c.functions.names.map((n: string) => months.flat().filter((col) => col.fns?.has(n)).length);
  return { ...l, pubs: pubsData, data: JSON.stringify({ pubs: pubsData, def, qs: quarters.map((q) => q.full) }).replaceAll('<', '\\u003c'), changes: pubs.length, since: longDate(d.since, locale), weekly: d.sources_weekly, months, quarters, qCount, qMax, cols: widths.map((w) => `${w}fr`).join(' '), perFn };
});

// A square of the matrix: lit where the change touched the function (and then a button), pale where it did not, hatched where it is not yet sorted.
const lit = (col: { fns: Set<string> | null }, n: string) => !!col.fns?.has(n);
const cellClass = (col: { fns: Set<string> | null }, n: string) => (lit(col, n) ? 'on' : col.fns === null ? 'un' : 'off');

const names = links.map((l) => l.name);
const listed = names.length > 1 ? `${names.slice(0, -1).join(', ')} ${ui.listAnd} ${names[names.length - 1]}` : names[0];

// Starting and the limits go to the shared section as the country pages give it.
const t = (v: string) => v;
---
<Site
  locale={locale}
  pageId="home"
  title={c.meta.title}
  description={put(c.meta.description, { countries: listed })}
  countries={countryNav(undefined, locale)}
  contact="#contact"
>
  <section class="band band-white home-open">
    <div class="wrap">
      <h1 class="home-h1" set:html={c.opening.h1}></h1>
      <p class="home-sub" set:html={put(c.opening.subline, { countries: listed })}></p>
    </div>
  </section>

  <section class="band band-tint band-ruled home-countries" id="countries">
    <div class="wrap">
      <script is:inline>
        // The squares fill in left to right as a card comes into view. Without this script, or with reduced motion, they are all there from the start.
        (function () {
          if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('cs-js');
          document.addEventListener('DOMContentLoaded', function () {
            var io = new IntersectionObserver(function (es) {
              es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
            }, { threshold: 0.35 });
            document.querySelectorAll('.card').forEach(function (c) { io.observe(c); });
          });
        })();
      </script>
      <script is:inline>
        // Pointing at a function name (or its row) zooms the row and lists its changes under the card, Outbound invoicing by default;
        // pointing at (or tabbing to) a square shows that change with the line that touches the function highlighted. A click on a function
        // name or a square holds it until another is clicked; a click anywhere else (or Escape) goes back to the card's default.
        // On a phone the squares are replaced by one cell per function and quarter (tap it for that quarter's changes). Without this
        // script the matrix is the plain picture it was.
        (function () {
          function node(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text) n.textContent = text; return n; }
          var holders = [];
          var phone = window.matchMedia('(max-width: 759px)');
          function init(card) {
            var data = JSON.parse(card.querySelector('.mx-data').textContent);
            var pubs = data.pubs, def = data.def, qs = data.qs;
            var lSource = card.getAttribute('data-l-source'), lFn = card.getAttribute('data-l-fn');
            var panel = card.querySelector('.mx-panel');
            var mx = card.querySelector('.mx');
            var labs = [].slice.call(card.querySelectorAll('.mx-lab'));
            var rows = [].slice.call(card.querySelectorAll('.mx-row'));
            var qrows = [].slice.call(card.querySelectorAll('.mq-row'));
            var boxes = [].slice.call(card.querySelectorAll('.mx-row .on'));
            var cells = [].slice.call(card.querySelectorAll('.mq-c'));
            var pin = null, hover = null;
            function touches(p, fn) { return p.ch.filter(function (c) { return c.f.indexOf(fn) !== -1; }); }
            function lineOf(c) {
              var f = document.createDocumentFragment();
              if (c.t) { f.appendChild(node('span', 'mx-t', c.t)); if (c.w) f.appendChild(node('span', 'mx-w', c.w)); }
              return f;
            }
            function list(hit, fn) {
              var ul = node('ul', 'mx-list');
              hit.slice().reverse().forEach(function (i) {
                var li = node('li');
                li.appendChild(node('span', 'mx-d', pubs[i].d));
                li.appendChild(node('span', 'mx-b', lSource + ': ' + pubs[i].b));
                touches(pubs[i], fn).forEach(function (c) { if (c.t) { var d = node('span', 'mx-line'); d.appendChild(lineOf(c)); li.appendChild(d); } });
                ul.appendChild(li);
              });
              return ul;
            }
            function fill(s) {
              panel.textContent = '';
              if (!s) { panel.appendChild(node('p', 'mx-idle', card.getAttribute('data-panel-idle'))); return; }
              var name = labs[s.fn].textContent;
              var all = pubs.map(function (p, i) { return i; });
              if (s.q != null) {
                var inQ = all.filter(function (i) { return pubs[i].q === s.q; });
                var hitQ = inQ.filter(function (i) { return touches(pubs[i], s.fn).length; });
                panel.appendChild(node('p', 'mx-h', card.getAttribute('data-panel-fn').replace('{fn}', name + ', ' + qs[s.q]).replace('{n}', hitQ.length).replace('{m}', inQ.length)));
                panel.appendChild(list(hitQ, s.fn));
                return;
              }
              if (s.pub == null) {
                var hit = all.filter(function (i) { return touches(pubs[i], s.fn).length; });
                panel.appendChild(node('p', 'mx-h', card.getAttribute('data-panel-fn').replace('{fn}', name).replace('{n}', hit.length).replace('{m}', pubs.length)));
                panel.appendChild(list(hit, s.fn));
                return;
              }
              var p = pubs[s.pub];
              var h = node('p', 'mx-h');
              h.appendChild(node('span', 'mx-d', p.d));
              h.appendChild(node('span', 'mx-b', lSource + ': ' + p.b));
              h.appendChild(node('span', 'mx-fn', lFn + ': ' + name));
              panel.appendChild(h);
              var ul2 = node('ul', 'mx-list mx-one');
              p.ch.forEach(function (c) {
                if (!c.t) return;
                var li = node('li', c.f.indexOf(s.fn) !== -1 ? 'hl' : 'dim');
                li.appendChild(lineOf(c));
                ul2.appendChild(li);
              });
              if (ul2.childNodes.length) panel.appendChild(ul2);
            }
            function render() {
              var s = pin || hover || def;
              if (s) card.setAttribute('data-fn', s.fn); else card.removeAttribute('data-fn');
              var wholeRow = !!s && s.pub == null && s.q == null;
              // The whole row of a function (pointing at its name or at the row) is the only view that changes the rows on a wide screen: the
              // row zooms and the others give up the height. A single square changes nothing but itself. Zoom size: as wide as the widest
              // square of the row, at least the usual 18px and at most 40px.
              var zoom = wholeRow && !phone.matches;
              var z = 18;
              if (zoom) {
                [].slice.call(rows[s.fn].querySelectorAll('.mx-col')).forEach(function (c) {
                  var n = c.children.length;
                  if (n) z = Math.max(z, (c.getBoundingClientRect().width - (n - 1) * (parseFloat(getComputedStyle(c).columnGap) || 0)) / n);
                });
                z = Math.min(40, Math.round(z));
                var o = Math.max(10, Math.round((108 - z) / 5));
                mx.style.gridTemplateRows = labs.map(function (l, i) { return (i === s.fn ? z : o) + 5 + 'px'; }).join(' ') + ' auto';
              } else mx.style.gridTemplateRows = '';
              card.classList.toggle('is-row', zoom);
              labs.forEach(function (l, i) {
                l.classList.toggle('act', !!s && s.fn === i);
                l.setAttribute('aria-pressed', pin && pin.fn === i && pin.pub == null && pin.q == null ? 'true' : 'false');
              });
              rows.forEach(function (r, i) { r.classList.toggle('zoom', zoom && s.fn === i); });
              qrows.forEach(function (r, i) { r.classList.toggle('sel', wholeRow && s.fn === i); });
              boxes.forEach(function (b) {
                var fn = +b.parentNode.parentNode.getAttribute('data-fn');
                b.tabIndex = s && s.fn === fn ? 0 : -1;
                b.classList.toggle('hi', !!s && s.pub != null && s.pub === +b.getAttribute('data-p') && s.fn === fn);
              });
              cells.forEach(function (b) {
                b.classList.toggle('hi', !!s && s.q != null && s.q === +b.getAttribute('data-q') && s.fn === +b.parentNode.getAttribute('data-fn'));
              });
              fill(s);
            }
            function at(t) {
              var l = t.closest('.mx-lab'); if (l) return { fn: +l.getAttribute('data-fn'), pub: null, q: null };
              var b = t.closest('.on'); if (b) return { fn: +b.parentNode.parentNode.getAttribute('data-fn'), pub: +b.getAttribute('data-p'), q: null };
              var m = t.closest('.mq-c'); if (m) return { fn: +m.parentNode.getAttribute('data-fn'), pub: null, q: +m.getAttribute('data-q') };
              var r = t.closest('.mx-row, .mq-row'); if (r) return { fn: +r.getAttribute('data-fn'), pub: null, q: null };
              return null;
            }
            mx.addEventListener('mouseover', function (e) { hover = at(e.target); render(); });
            mx.addEventListener('mouseleave', function () { hover = null; render(); });
            mx.addEventListener('click', function (e) {
              var s = at(e.target);
              if (!s || (e.target.closest('.mx-row, .mq-row') && !e.target.closest('.on, .mq-c'))) return;
              pin = s; hover = null; render();
              holders.forEach(function (h) { if (h !== api) h.release(); });
            });
            mx.addEventListener('focusin', function (e) { var s = e.target.closest('.mx-lab, .on, .mq-c') ? at(e.target) : null; if (s) { hover = s; render(); } });
            mx.addEventListener('focusout', function (e) { if (!e.relatedTarget || !mx.contains(e.relatedTarget)) { hover = null; render(); } });
            mx.addEventListener('keydown', function (e) {
              var t = e.target;
              if (e.key === 'Escape') { pin = null; hover = null; render(); var l = t.closest('.mx-row') ? labs[+t.parentNode.parentNode.getAttribute('data-fn')] : t; if (l && l.focus) l.focus(); return; }
              if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
              if (t.classList.contains('mx-lab')) { var first = rows[+t.getAttribute('data-fn')].querySelector('.on'); if (e.key === 'ArrowRight' && first) { e.preventDefault(); first.focus(); } return; }
              if (!t.classList.contains('on')) return;
              var list = [].slice.call(t.parentNode.parentNode.querySelectorAll('.on'));
              var i = list.indexOf(t) + (e.key === 'ArrowRight' ? 1 : -1);
              if (list[i]) { e.preventDefault(); list[i].focus(); }
            });
            var api = { release: function () { if (pin || hover) { pin = null; hover = null; render(); } } };
            holders.push(api);
            window.addEventListener('resize', function () { render(); });
            // A closed card has no width, so the default row is drawn again when it opens.
            var fold = card.closest('details');
            if (fold) fold.addEventListener('toggle', function () { if (fold.open) render(); });
            render();
          }
          document.addEventListener('DOMContentLoaded', function () { [].slice.call(document.querySelectorAll('.card[data-card]')).forEach(init); });
          document.addEventListener('click', function (e) { if (!e.target.closest('.mx-lab, .mx .on, .mq-c, .mx-panel')) holders.forEach(function (h) { h.release(); }); });
        })();
      </script>
      <ul class="cards">
        {cards.map((k) => (
          <li>
            <details class="fold">
            <summary class="fold-q"><h2 class="fold-h" set:html={put(c.countries.ask, { name: k.name })}></h2><span class="fold-tri" aria-hidden="true"></span></summary>
            <div class="card" data-card={k.cc} data-panel-idle={c.countries.panelIdle} data-panel-fn={c.countries.panelFn} data-l-source={c.countries.labelSource} data-l-fn={c.countries.labelFn}>
              <div class="card-head">
                <span class="card-count"><span class="card-n">{k.changes}</span><span class="card-l" set:html={put(c.countries.changes, { since: k.since })}></span></span>
              </div>
              <p class="mx-head">{c.countries.labelFn}</p>
              <div class="mx">
                {c.functions.names.map((n: string, fi: number) => (
                  <>
                    <button type="button" class="mx-lab" data-fn={fi} aria-pressed="false">{n}</button>
                    <span class="mx-row" data-fn={fi} style={`grid-template-columns: ${k.cols}`}>
                      {k.months.map((m, i) => (
                        <span class="mx-col" style={`--k: ${i}`}>
                          {m.length === 0 ? <b></b> : m.map((col) => <button type="button" class={cellClass(col, n)} data-p={col.idx} disabled={!lit(col, n)} tabindex="-1" aria-label={lit(col, n) ? `${n}, ${k.pubs[col.idx].d}, ${k.pubs[col.idx].b}` : undefined} aria-hidden={lit(col, n) ? undefined : 'true'}></button>)}
                        </span>
                      ))}
                    </span>
                    <span class="mq-row" data-fn={fi} style={`grid-template-columns: repeat(${k.quarters.length}, minmax(0, 1fr))`}>
                      {k.quarters.map((q, qi) => <button type="button" class="mq-c" data-q={qi} style={`--a: ${(k.qCount[fi][qi] / k.qMax).toFixed(2)}`} disabled={k.qCount[fi][qi] === 0} aria-label={k.qCount[fi][qi] ? `${n}, ${q.full}` : undefined} aria-hidden={k.qCount[fi][qi] ? undefined : 'true'}>{k.qCount[fi][qi] || ''}</button>)}
                    </span>
                  </>
                ))}
                <span class="mq-axis" aria-hidden="true"><span class="mq-qs" style={`grid-template-columns: repeat(${k.quarters.length}, minmax(0, 1fr))`}>{k.quarters.map((q) => <span class="mq-q"><span class="mq-ql">{q.label}</span><span class="mq-year">{q.year.slice(2)}</span></span>)}</span></span>
                <span class="mx-axis" aria-hidden="true"><span class="mx-ax">{k.quarters.map((q) => <span class="mx-q" style={`left: ${q.left.toFixed(2)}%`}><span class="mx-ql">{q.label}</span><span class="mx-year">{q.year}</span></span>)}</span></span>
              </div>
              <div class="mx-panel" aria-live="polite"><p class="mx-idle">{c.countries.panelIdle}</p></div>
              <script is:inline type="application/json" class="mx-data" set:html={k.data}></script>
              <span class="sr">{c.functions.names.map((n: string, fi: number) => `${n}: ${k.perFn[fi]}. `).join('')}</span>
              <div class="card-foot">
                <span class="card-w"><span class="card-dot" aria-hidden="true"></span><span set:html={put(c.countries.weekly, { weekly: k.weekly })}></span></span>
                <a class="card-go" href={k.href} set:html={put(c.countries.go, { name: k.name })}></a>
              </div>
            </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-white home-fns">
    <div class="wrap">
      <h2 class="band-h home-h2" set:html={c.functions.h2}></h2>
      <p class="home-fns-p" set:html={c.functions.intro}></p>
      <ul class="tiles">
        {c.functions.names.map((n) => <li class="tile" set:html={n}></li>)}
      </ul>
    </div>
  </section>

  <StartAndLimits start={c.onboarding} limits={c.limits} tone="tint" ctaHref="#contact" t={t} />

  <ContactForm copy={contact} page={locale === 'en' ? 'home' : urlFor('home', locale)} segment="" country="" tone="tint" person={contact.person} t={t} locale={locale} />
</Site>

<style is:global>
  .home-open { padding: 64px 0 52px; }
  .home-h1 { max-width: 26ch; font-size: clamp(1.9rem, 4.4vw, 2.9rem); }
  .home-sub { max-width: 62ch; margin: 22px 0 0; font-size: 1.14rem; line-height: 1.5; font-weight: 500; }
  .home-h2 { max-width: 34ch; }

  .home-countries { padding: 44px 0 48px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  /* Each country folds open from its question; closed, only the question and the triangle show. */
  .fold { background: var(--page); border: 1px solid var(--box-border); border-top: 3px solid var(--ink); }
  .fold:hover, .fold[open] { border-color: var(--ink); }
  .fold-q { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 28px; cursor: pointer; list-style: none; }
  .fold-q::-webkit-details-marker { display: none; }
  .fold-q:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fold-h { margin: 0; font-family: var(--serif); font-size: 1.6rem; line-height: 1.2; font-weight: 700; }
