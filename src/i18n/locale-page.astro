---
// The country pages of the other languages: /de/deutschland/, /fr/france/, /fr/belgique/ and so on. This file is not in
// src/pages: the route is added by the integration in astro.config.mjs, and only when the registry has a ready language.
// While none is ready the route does not exist, so the build holds no trace of it and the English pages are built exactly
// as before. The home pages of the other languages are their own route, src/i18n/locale-home.astro.
// getStaticPaths lists only the pages the registry builds. The text is the language's own story files: the parity gate
// (src/i18n/gate.ts) has already stopped the build if one is missing or does not match the English. Only a test build can
// show the English text here (identity copy). The English pages stay where they are.
import France from '../components/site/FrancePage.astro';
import Germany from '../components/site/GermanyPage.astro';
import Belgium from '../components/site/BelgiumPage.astro';
import { builtPages } from './registry';
import { runGate } from './run-gate';

export function getStaticPaths() {
  runGate();
  const built = builtPages().filter((p) => p.locale !== 'en' && p.page !== 'home');
  return built.map((p) => ({ params: { locale: p.locale, slug: p.slug }, props: { page: p.page, locale: p.locale } }));
}
const { page, locale } = Astro.props;
---
{page === 'FR' && <France locale={locale} />}
{page === 'DE' && <Germany locale={locale} />}
{page === 'BE' && <Belgium locale={locale} />}
