---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>For Service Providers | einvoiceops</title>
  <meta name="description" content="Two commercial models for e-invoice service providers and platform teams: embed the operational readiness layer in your product, or deliver it to your customers under your brand." />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:        #1a2b3c;
      --navy-soft:   #243447;
      --accent:      #2563eb;
      --accent-dark: #1d4ed8;
      --text:        #111827;
      --sub:         #374151;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --bg:          #ffffff;
      --bg-alt:      #f8f9fa;
      --ice:         #eff6ff;
      --teal:        #0f766e;
      --teal-light:  #f0fdfa;
      --teal-border: #99f6e4;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Nav ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem; height: 60px;
      display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    }
    .logo {
      font-size: 1.05rem; font-weight: 800;
      letter-spacing: -0.03em; color: var(--navy);
      text-decoration: none; white-space: nowrap;
    }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a {
      font-size: 0.875rem; color: var(--muted);
      text-decoration: none; font-weight: 500; transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--text); }
    nav a.btn-nav {
      font-size: 0.875rem; font-weight: 600;
      color: var(--bg); background: var(--accent);
      text-decoration: none; padding: 8px 18px;
      border-radius: 8px; transition: background 0.15s;
    }
    nav a.btn-nav:hover { background: var(--accent-dark); }
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 36px; height: 36px;
      background: none; border: none; cursor: pointer;
      padding: 4px; border-radius: 6px;
      transition: background 0.15s;
    }
    .hamburger:hover { background: rgba(0,0,0,0.06); }
    .hamburger span {
      display: block; width: 22px; height: 2px;
      background: var(--navy); border-radius: 2px;
      transition: transform 0.2s, opacity 0.2s;
      transform-origin: center;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu {
      display: none;
      position: fixed;
      top: 60px; left: 0; right: 0;
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 99;
      flex-direction: column;
      padding: 1rem 1.5rem 1.5rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-size: 1rem; font-weight: 500;
      color: var(--text); text-decoration: none;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }
    .mobile-menu a:last-child { border-bottom: none; padding-bottom: 0; }
    .mobile-menu a:hover { color: var(--accent); }
    @media (max-width: 600px) {
      .nav-links .hide-mobile { display: none; }
      .hamburger { display: flex; }
    }

    /* ── Hero ── */
    .page-hero {
      background: var(--navy);
      color: white;
      padding: 80px 2rem 72px;
      text-align: center;
    }
    .page-eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.5); margin-bottom: 20px;
    }
    .page-hero h1 {
      font-size: clamp(1.65rem, 3.5vw, 2.4rem);
      font-weight: 800; letter-spacing: -0.03em;
      color: #ffffff; max-width: 720px;
      margin: 0 auto 20px; line-height: 1.2;
    }
    .page-hero p {
      font-size: 1.05rem; color: rgba(255,255,255,0.65);
      max-width: 580px; margin: 0 auto; line-height: 1.7;
    }

    /* ── Layout ── */
    .inner { max-width: 1000px; margin: 0 auto; padding: 0 2rem; }
    .section { padding: 72px 0; }
    .section.bg-alt { background: var(--bg-alt); }

    /* ── Two-column angles ── */
    .angles-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 760px) {
      .angles-grid { grid-template-columns: 1fr; }
    }

    .angle-card {
      border-radius: 16px;
      padding: 36px 32px;
      border: 2px solid;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .angle-card.angle-product {
      background: var(--ice);
      border-color: var(--accent);
    }
    .angle-card.angle-delivery {
      background: var(--teal-light);
      border-color: var(--teal-border);
    }

    .angle-tag {
      display: inline-block;
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 100px;
    }
    .angle-product .angle-tag {
      background: var(--accent); color: #fff;
    }
    .angle-delivery .angle-tag {
      background: var(--teal); color: #fff;
    }

    .angle-card h2 {
      font-size: 1.25rem; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.25;
      color: var(--navy);
    }

    .angle-pain {
      font-size: 0.9rem; color: var(--sub);
      line-height: 1.7;
      padding: 14px 16px;
      background: rgba(255,255,255,0.7);
      border-radius: 10px;
      border-left: 3px solid;
    }
    .angle-product .angle-pain { border-color: var(--accent); }
    .angle-delivery .angle-pain { border-color: var(--teal); }

    .angle-what-label {
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--muted);
    }

    .angle-bullets {
      list-style: none; padding: 0;
      display: flex; flex-direction: column; gap: 10px;
    }
    .angle-bullets li {
      font-size: 0.875rem; color: var(--sub);
      line-height: 1.6;
      padding-left: 20px;
      position: relative;
    }
    .angle-bullets li::before {
      content: '\00B7';
      position: absolute; left: 4px;
      font-weight: 700; font-size: 1.1rem; line-height: 1.5;
    }
    .angle-product .angle-bullets li::before { color: var(--accent); }
    .angle-delivery .angle-bullets li::before { color: var(--teal); }

    .angle-fit {
      font-size: 0.8rem; color: var(--muted);
      line-height: 1.6;
      border-top: 1px solid rgba(0,0,0,0.08);
      padding-top: 16px;
    }
    .angle-fit strong { color: var(--sub); }

    .angle-cta {
      display: inline-block;
      font-size: 0.875rem; font-weight: 700;
      text-decoration: none;
      padding: 10px 20px; border-radius: 8px;
      transition: opacity 0.15s;
      align-self: flex-start;
    }
    .angle-cta:hover { opacity: 0.85; }
    .angle-product .angle-cta {
      background: var(--accent); color: #fff;
    }
    .angle-delivery .angle-cta {
      background: var(--teal); color: #fff;
    }

    /* ── Intro strip above two columns ── */
    .intro-strip {
      text-align: center;
      padding-bottom: 48px;
    }
    .eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 12px;
    }
    .intro-strip h2 {
      font-size: clamp(1.3rem, 2.5vw, 1.7rem);
      font-weight: 800; letter-spacing: -0.02em;
      color: var(--navy); line-height: 1.25;
      max-width: 640px; margin: 0 auto 14px;
    }
    .intro-strip p {
      font-size: 0.95rem; color: var(--sub);
      line-height: 1.7; max-width: 560px; margin: 0 auto;
    }

    /* ── Contact ── */
    .contact-box {
      background: var(--navy); border-radius: 20px;
      padding: 56px 48px; text-align: center;
    }
    @media (max-width: 600px) { .contact-box { padding: 40px 24px; } }
    .contact-box h2 {
      font-size: clamp(1.2rem, 2.5vw, 1.55rem);
      font-weight: 800; color: #ffffff;
      letter-spacing: -0.02em; margin-bottom: 12px; line-height: 1.3;
    }
    .contact-box p {
      font-size: 0.95rem; color: rgba(255,255,255,0.65);
      margin-bottom: 28px; line-height: 1.65;
      max-width: 460px; margin-left: auto; margin-right: auto;
    }
    .email-link {
      font-size: 1.1rem; font-weight: 700;
      color: #ffffff; text-decoration: none;
      border-bottom: 2px solid rgba(255,255,255,0.3);
      padding-bottom: 2px; transition: border-color 0.15s;
    }
    .email-link:hover { border-color: #ffffff; }

    footer {
      background: var(--navy); color: rgba(255,255,255,0.45);
      padding: 24px 2rem; text-align: center;
      font-size: 0.8rem; display: flex;
      flex-direction: column; gap: 6px;
    }
    footer a { color: rgba(255,255,255,0.45); text-decoration: none; }
    footer a:hover { color: white; }

    .disclaimer {
      background: var(--bg-alt); border-top: 1px solid var(--border);
      padding: 20px 2rem; text-align: center;
    }
    .disclaimer p {
      font-size: 0.72rem; color: #9ca3af;
      max-width: 720px; margin: 0 auto; line-height: 1.65;
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">einvoice<span>ops</span></a>
  <div class="nav-links">
    <a href="/#calculator" class="hide-mobile">Mandate Cost Calculator</a>
    <a href="/services/" class="hide-mobile">Services</a>
    <a href="/map/" class="hide-mobile">Compliance Map</a>
    <a href="/#faq" class="hide-mobile">FAQ</a>
    <a href="/#contact" class="btn-nav">Get in touch</a>
    <button class="hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/#calculator">Mandate Cost Calculator</a>
  <a href="/services/">Services</a>
  <a href="/map/">Compliance Map</a>
  <a href="/#faq">FAQ</a>
  <a href="/#contact">Get in touch</a>
</div>

<div class="page-hero">
  <span class="page-eyebrow">For service providers</span>
  <h1>E-invoice mandate compliance is a buying criterion. Enterprises' internal preparation is where deals get complicated.</h1>
  <p>You handle the exchange. We package how enterprise customers prepare for mandates inside their organisation. Two ways to deliver it.</p>
</div>

<section class="section">
  <div class="inner">

    <div class="intro-strip">
      <span class="eyebrow">Two commercial models</span>
      <h2>Same core problem. Different place in the value chain.</h2>
      <p>When France, Poland, or Germany goes live, your customers need to know what their finance team, IT team, and local accounting partners each need to do. That question is not answered by the exchange layer. Here is how we can work together to close it.</p>
    </div>

    <div class="angles-grid">

      <!-- Angle 1: For your product -->
      <div class="angle-card angle-product">
        <span class="angle-tag">For your product</span>
        <h2>Embed the operational layer in your platform</h2>

        <p class="angle-pain">Your platform covers the mandate exchange. Customers ask what their ERP needs to configure, which master data needs correcting, who inside their organisation owns each preparation step. That question sits outside your product. Building the operational layer from scratch takes 18 months or more.</p>

        <span class="angle-what-label">What you get</span>
        <ul class="angle-bullets">
          <li>Structured, country-by-country mandate readiness content you can surface in your platform or tooling</li>
          <li>Mapped by internal role - Finance Systems, Tax, AP Operations, IT - per mandate</li>
          <li>Inbound and outbound flows covered separately, because the deadlines almost never match</li>
          <li>Updated as mandates change, before your customers' go-live deadlines</li>
          <li>Deployable as a product feature, implementation tool, or CSM enablement layer</li>
        </ul>

        <p class="angle-fit"><strong>Who this fits:</strong> Product and platform teams adding mandate compliance features who run into the internal preparation question at every implementation. Teams where go-live failures trace back to customer prep, not platform coverage.</p>

        <a href="mailto:jens@einvoiceops.eu" class="angle-cta">Talk about the product model</a>
      </div>

      <!-- Angle 2: White-label delivery -->
      <div class="angle-card angle-delivery">
        <span class="angle-tag">For your customers</span>
        <h2>Deliver mandate readiness under your brand</h2>

        <p class="angle-pain">Your customers are in France, Poland, Germany. They know the mandate is coming. They do not know what their finance team, IT team, and local accounting partners each need to do before go-live. You can describe the mandate. The structured, role-specific operational answer is the part you cannot give them.</p>

        <span class="angle-what-label">What you deliver to your customers</span>
        <ul class="angle-bullets">
          <li>Mandate readiness deliverables produced for your customers, under your brand</li>
          <li>Structured by internal role, mapped per mandate, source-linked with snapshot dates</li>
          <li>Inbound and outbound covered separately - because go-live obligations rarely land on the same date</li>
          <li>Named owners, clear action sequence, no ambiguity about who does what</li>
          <li>Jens produces it. Your customer sees your service.</li>
        </ul>

        <p class="angle-fit"><strong>Who this fits:</strong> Consolidators and service providers whose enterprise customers need more than exchange coverage. Teams where "we handle your e-invoice connection" does not get the customer through go-live without support calls.</p>

        <a href="mailto:jens@einvoiceops.eu" class="angle-cta">Talk about the delivery model</a>
      </div>

    </div>
  </div>
</section>

<section class="section bg-alt" id="contact">
  <div class="inner">
    <div class="contact-box">
      <h2>Not sure which model fits? That is the conversation.</h2>
      <p>Tell us what your customers are asking. We will figure out the right shape together - product licence, content layer, or white-label delivery.</p>
      <a href="mailto:jens@einvoiceops.eu" class="email-link">jens@einvoiceops.eu</a>
    </div>
  </div>
</section>

<footer>
  <p>einvoiceops &nbsp;&middot;&nbsp; <a href="mailto:jens@einvoiceops.eu">jens@einvoiceops.eu</a> &nbsp;&middot;&nbsp; Finland</p>
  <p>&copy; 2026 einvoiceops &nbsp;&middot;&nbsp; <a href="/legal/">Legal Notice</a> &nbsp;&middot;&nbsp; <a href="/privacy/">Privacy Policy</a></p>
</footer>

<div class="disclaimer">
  <p>einvoiceops provides operational readiness support and is not a tax advisor, legal advisor, or compliance authority. All content is informational and operational planning support only. Customers remain responsible for all compliance decisions and their execution.</p>
</div>

<script>
  (function () {
    const btn = document.getElementById('nav-hamburger');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    function closeMenu() {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', () => {
      const opening = !menu.classList.contains('open');
      if (opening) { btn.classList.add('open'); menu.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
      else closeMenu();
    });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('click', e => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
  })();
</script>

</body>
</html>
