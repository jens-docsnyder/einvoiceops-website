---
import { getCollection, render } from 'astro:content';
import Nav from '../../components/Nav.astro';
import GlossaryPanel from '../../components/GlossaryPanel.astro';

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  return countries.map(entry => ({
    params: { country: entry.data.code },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

function fmt(val: string | null | undefined): string {
  if (!val || val === 'none') return 'None';
  return val.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

function fmtDate(date: Date | null | undefined): string {
  if (!date) return '—';
  return date.toISOString().slice(0, 10);
}

// Level 1: field label tooltips
const FIELD_TIPS: Record<string, string> = {
  mandate_type: "How this country's e-invoicing system works at a structural level - whether invoices are validated by a government platform before reaching the buyer, exchanged directly between companies, or reported after the fact.",
  vida_alignment: "How this country's mandate relates to the EU's ViDA (VAT in the Digital Age) reform due around 2030. Some countries are ahead of ViDA, some will need to rebuild when ViDA arrives.",
  future_direction: "Known upcoming changes to this country's mandate - format updates, new deadlines, or structural reforms expected in the next 1-3 years.",
  b2b: "Whether business-to-business e-invoicing is legally required between private companies.",
  b2g: "Whether businesses are legally required to send e-invoices to government and public sector buyers. B2G mandates typically came before B2B in most EU countries.",
  b2c_scope: "Whether the mandate covers invoices issued to consumers (private individuals), and if so in what form.",
  status: "Where this country currently sits in the mandate rollout - already live and enforced, in an official pilot period, announced with a confirmed date, or still proposed.",
  phase_in: "Whether the mandate is being introduced gradually for different company sizes or sectors, rather than all at once.",
  phase_in_scope: "Which companies are in the current phase - which ones must comply now versus which ones have more time.",
  formats: "Which structured electronic invoice formats are legally accepted under this mandate. These are XML-based formats - not PDF.",
  cius: "The country-specific implementation of the EU standard (EN 16931). A CIUS adds local requirements on top of the European baseline.",
  platform: "The government platform or infrastructure that handles invoice routing, validation, or registration in this country. Not all countries have one - some use decentralised exchange.",
  platform_model: "How the government platform fits into the invoice flow - whether it sits in the middle of every transaction (clearance), acts as a directory, or is not involved at all.",
  transport_protocol: "The technical standard used to transmit invoices between companies or to the government platform.",
  b2g_signature: "Whether a legally recognised electronic signature is required on invoices sent to government. Different from B2B requirements.",
  b2b_signature: "Whether a legally recognised electronic signature is required on invoices sent to other companies.",
  master_data_id: "The identifier your company and your trading partners use to route e-invoices correctly. Different countries use different identifiers - VAT numbers, registration numbers, or country-specific routing codes.",
  mandatory_pdf_bundle: "Whether a human-readable PDF must be included alongside the structured XML. In some countries it is required; in others the XML alone is the legal document.",
  foreign_resident_scope: "Whether your company is in scope if you have a VAT registration in this country but your business is not legally established here (no permanent establishment).",
  archiving_years: "How many years the original electronic invoice file must be kept, in its original format, with proof that it has not been altered.",
  penalty_max: "The financial penalty for non-compliance. In some countries this is a per-invoice fine; in others the primary consequence is losing the right to deduct VAT.",
  reporting_window: "If this country has a deadline for transmitting invoices after the transaction date (not all countries do), this shows the number of days allowed.",
  correction_mechanism: "The legally approved method for correcting a compliant e-invoice that has already been issued. Countries differ on whether you use a correction invoice or a credit note - and the rules are strict.",
  document_lifecycle_states: "The official status labels an invoice passes through in this country's system - from submission to final acceptance, rejection, or payment. These statuses must flow back into your ERP.",
  has_sandbox: "Whether an official test environment exists where you can validate your invoice format and transmission before going live.",
};

// Level 2: value tooltips (keyed by raw field value from frontmatter)
const VALUE_TIPS: Record<string, Record<string, string>> = {
  mandate_type: {
    interoperability: "Companies exchange invoices directly with each other through a shared network (Peppol) or agreed channels. No government platform sits in the middle. Germany uses this model.",
    'centralized-clearance': "Every invoice must pass through a single government platform that validates it before the buyer receives it. The invoice is only legally issued once the government system has processed it. Italy uses this model.",
    'clearance-pdp': "Similar to centralised clearance, but exchange happens through certified private platforms (PDPs) rather than a single government portal. The government platform acts as a directory and data receiver. France uses this model.",
    'post-audit': "Invoices are exchanged directly and reported to the government after the fact. The government reviews data periodically rather than in real time. The older model - most countries are moving away from it.",
  },
  vida_alignment: {
    'DRR-compliant': "This country's mandate is designed to align with the EU's ViDA Digital Reporting Requirements, which will govern cross-border transactions from around 2030. Germany is positioned here.",
    'legacy-clearance': "This country built its clearance model before ViDA was designed. The existing system will need to be partially rebuilt or bridged when ViDA cross-border rules arrive. Italy is in this category.",
    'ctc-national': "A national continuous transaction control model that predates ViDA and runs independently of it. Alignment with ViDA's cross-border requirements is planned for 2030+. France's PDP model is in this category.",
  },
  b2c_scope: {
    none: "Invoices to private consumers are not covered by this mandate.",
    in_scope: "Consumer transactions are in scope. In Italy, B2C invoices can be transmitted via SdI on request; otherwise daily aggregated data must be reported separately.",
    'e-reporting-only': "Consumer transactions are not subject to e-invoicing, but anonymised daily transaction totals must be reported separately to the tax authority. France uses this model.",
  },
  status: {
    live: "The mandate is active and enforced. Non-compliance can result in penalties or loss of tax deduction rights.",
    pilot: "An official testing period is underway. Companies can transmit compliant invoices now, but the hard enforcement deadline has not yet arrived.",
    announced: "A specific go-live date has been confirmed in legislation or official publication. The mandate is not yet enforced.",
    proposed: "The mandate has been discussed or consulted on, but no confirmed date exists in law.",
  },
  phase_in_scope: {
    pending_micro: "The issuing mandate is deferred for smaller companies. In Germany, companies below EUR 800,000 annual turnover have until January 2028 to begin issuing.",
    all: "The mandate applies to all companies with no ongoing phase-in. Italy completed its final phase-in in January 2024.",
    by_size: "The mandate is being rolled out by company size. In France, large companies must issue from September 2026, SMEs from September 2027.",
    large_taxpayers: "Only large taxpayers (above a defined revenue threshold) are currently required to comply.",
  },
  platform_model: {
    none: "No government platform is involved in B2B invoice exchange. Companies exchange directly, and the government has no real-time visibility into individual transactions. Germany uses this model.",
    centralized: "A single government platform processes every invoice. All traffic flows through one point. Italy's SdI is this model.",
    'Y-Model': "A hybrid model where certified private platforms handle invoice exchange between companies, while a central government portal maintains the routing directory and receives tax data. France uses this model.",
  },
  transport_protocol: {
    'Peppol-BIS-3.0': "The standard used by the Peppol network. Invoices are transmitted via certified access point providers using the AS4 protocol. Peppol is the recommended path for Germany's B2B mandate.",
    SFTP: "Secure file transfer - the high-volume direct channel for connecting to Italy's SdI platform. Used by large-scale senders.",
    PDP: "All B2B invoice exchange in France must go through a certified PDP (Plateforme Agréée). The PDP handles format conversion, transmission, and tax data reporting.",
    'API-OAuth2': "API-based transmission using OAuth2 authentication. Used in clearance models where real-time government validation is required.",
  },
  b2g_signature: {
    none: "No electronic signature is required. Document integrity is guaranteed through the transmission channel or platform certification instead.",
    XAdES: "A specific type of XML-based electronic signature required on B2G invoices in Italy. Legally equivalent to a handwritten signature.",
    optional: "A signature is legally valid and accepted, but not required for compliance.",
  },
  b2b_signature: {
    none: "No electronic signature is required. Document integrity is guaranteed through the transmission channel or platform certification instead.",
    XAdES: "A specific type of XML-based electronic signature required on some invoice types. Legally equivalent to a handwritten signature.",
    optional: "A signature is legally valid and accepted, but not required for compliance.",
  },
  mandatory_pdf_bundle: {
    none: "The XML file is the legal original. No accompanying PDF is required. A PDF may be included for human readability but has no legal status.",
    optional: "A human-readable PDF can be bundled with the XML (as in Factur-X or ZUGFeRD), but pure XML is equally valid.",
  },
  correction_mechanism: {
    correction_invoice: "A new invoice is issued that references and supersedes the original. It must itself be a fully compliant e-invoice - a PDF correction is not valid. Germany uses this model.",
    credit_note: "The original invoice is cancelled by issuing a credit note that references it. A new invoice is then issued if needed. Italy and France use this model. Correction invoices do not exist in these countries.",
  },
};

function getValTip(field: string, val: string | null | undefined): string | undefined {
  if (!val) return undefined;
  return VALUE_TIPS[field]?.[val];
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{d.country} — EU E-invoicing Compliance Map — einvoiceops</title>
  <meta name="description" content={`E-invoicing mandate facts and operational preparation guide for ${d.country}. Who owns the work, what breaks first, what ready means.`} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:   #1a2b3c;
      --accent: #2563eb;
      --text:   #111827;
      --sub:    #374151;
      --muted:  #6b7280;
      --border: #e5e7eb;
      --bg:     #ffffff;
      --bg-alt: #f8f9fa;
      --sans:   -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    main { max-width: 760px; margin: 0 auto; padding: 36px 2rem 80px; }

    .breadcrumb { font-size: 0.82rem; color: var(--muted); margin-bottom: 24px; }
    .breadcrumb a { color: var(--accent); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .country-header {
      display: flex; align-items: flex-start; gap: 20px;
      margin-bottom: 32px; padding-bottom: 28px;
      border-bottom: 2px solid var(--navy);
    }
    .country-flag { font-size: 3rem; line-height: 1; flex-shrink: 0; }
    .country-header h1 {
      font-size: 1.75rem; font-weight: 800;
      color: var(--navy); letter-spacing: -0.03em;
      margin-bottom: 8px;
    }
    .header-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .badge {
      font-size: 0.68rem; font-weight: 700;
      padding: 3px 10px; border-radius: 100px;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .badge-live { background: #dcfce7; color: #166534; }
    .badge-announced { background: #fef9c3; color: #854d0e; }
    .badge-proposed { background: #f3f4f6; color: #6b7280; }
    .badge-mandatory { background: #eff6ff; color: #1d4ed8; }
    .badge-voluntary, .badge-none { background: #f3f4f6; color: #6b7280; }
    .verified { font-size: 0.78rem; color: var(--muted); }

    .section-block { margin-bottom: 28px; }
    .section-block h2 {
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 10px;
    }

    .data-grid { border: 1px solid var(--border); border-radius: 8px; }
    .data-row {
      display: flex; align-items: baseline;
      padding: 10px 14px; gap: 16px;
      border-bottom: 1px solid var(--border);
      font-size: 0.875rem;
      position: relative; z-index: 1;
    }
    .data-row:hover { z-index: 10; }
    .data-row:last-child { border-bottom: none; }
    .data-grid .data-row:first-child { border-radius: 8px 8px 0 0; }
    .data-grid .data-row:last-child  { border-radius: 0 0 8px 8px; }
    .row-label {
      width: 168px; flex-shrink: 0;
      color: var(--muted); font-weight: 500;
    }
    .row-icon {
      width: 18px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .row-val { color: var(--text); }
    .data-row:nth-child(even) { background: var(--bg-alt); }

    /* All grid tooltips: left-aligned so they extend rightward, staying within content margins */
    .data-grid [data-tooltip]::after {
      left: 0;
      transform: none;
    }
    /* First row: show tooltip below so it doesn't clash with the section heading */
    .data-grid .data-row:first-child [data-tooltip]::after {
      bottom: auto;
      top: calc(100% + 8px);
    }

    .deadlines { display: flex; flex-direction: column; gap: 8px; }
    .deadline-row {
      display: flex; align-items: baseline; gap: 16px;
      padding: 10px 14px;
      border: 1px solid var(--border); border-radius: 8px;
      font-size: 0.875rem;
    }
    .deadline-date {
      font-weight: 700; color: var(--navy);
      white-space: nowrap; flex-shrink: 0;
      font-variant-numeric: tabular-nums;
    }
    .deadline-desc { color: var(--sub); }

    hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }

    /* ---- Layer 2 expandable sections ---- */
    .layer2 { margin-bottom: 40px; }

    .layer2 :global(details) {
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 8px;
      /* overflow: hidden removed — it clips tooltip ::after pseudo-elements */
    }
    .layer2 :global(details[open]) {
      border-color: #bfdbfe;
    }
    .layer2 :global(summary) {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 18px;
      font-size: 0.95rem; font-weight: 700;
      color: var(--navy); letter-spacing: -0.01em;
      cursor: pointer;
      user-select: none;
      list-style: none;
      background: var(--bg);
      border-radius: 10px;
    }
    .layer2 :global(details[open] summary) {
      background: #eff6ff;
      border-bottom: 1px solid #bfdbfe;
      border-radius: 10px 10px 0 0;
    }
    .layer2 :global(summary::-webkit-details-marker) { display: none; }
    .layer2 :global(summary::after) {
      content: '+';
      font-size: 1.1rem; font-weight: 400;
      color: var(--accent); flex-shrink: 0; margin-left: 12px;
    }
    .layer2 :global(details[open] summary::after) { content: '−'; }

    .layer2 :global(.section-body) {
      padding: 18px 18px 20px;
      background: var(--bg);
      border-radius: 0 0 10px 10px;
    }
    /* Prose tooltips: anchor left so they extend rightward, not clipped by box edges */
    .layer2 [data-tooltip]::after {
      left: 0;
      transform: none;
    }
    .layer2 :global(p) { font-size: 0.925rem; color: var(--sub); margin-bottom: 12px; line-height: 1.7; }
    .layer2 :global(p:last-child) { margin-bottom: 0; }
    .layer2 :global(strong) { color: var(--text); font-weight: 600; }
    .layer2 :global(ul), .layer2 :global(ol) {
      margin: 8px 0 12px 20px; font-size: 0.925rem; color: var(--sub);
    }
    .layer2 :global(li) { margin-bottom: 4px; line-height: 1.6; }

    .disclaimer {
      font-size: 0.78rem; color: var(--muted);
      padding: 16px 20px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-alt);
      line-height: 1.5;
    }

    .badge-q {
      font-size: 0.72em;
      margin-left: 3px;
      opacity: 0.65;
      vertical-align: middle;
      cursor: help;
    }

    /* Info icon in data-grid rows */
    .field-q {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #dbeafe;
      color: var(--accent);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: help;
      flex-shrink: 0;
      transition: background 0.15s, color 0.15s, transform 0.15s;
      animation: field-q-hint 1.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) 1.2s 1 both;
    }
    .field-q:hover {
      background: var(--accent);
      color: #fff;
      transform: scale(1.15);
    }
    @keyframes field-q-hint {
      0%   { transform: scale(1); }
      14%  { transform: scale(1.45); }
      28%  { transform: scale(1); }
      42%  { transform: scale(1.35); }
      56%  { transform: scale(1); }
      100% { transform: scale(1); }
    }

    @media (max-width: 600px) {
      .country-header { flex-direction: column; gap: 12px; }
      .row-label { width: 120px; }
      .row-icon { width: 16px; }
    }
  </style>
</head>
<body>
  <Nav active="map" />

  <main>
    <div class="breadcrumb">
      <a href="/map/">Compliance Map</a> / {d.country}
    </div>

    <div class="country-header">
      <div class="country-flag">{d.flag}</div>
      <div>
        <h1>{d.country}</h1>
        <div class="header-badges">
          <span
            class={`badge badge-${d.status}`}
            data-tooltip={getValTip('status', d.status)}
          >{d.status}{getValTip('status', d.status) && <span class="badge-q">ℹ</span>}</span>
          <span class={`badge badge-${d.b2b}`}>B2B {d.b2b}</span>
          <span class={`badge badge-${d.b2g}`}>B2G {d.b2g}</span>
        </div>
        <div class="verified">Last verified: {fmtDate(d.last_verified)}</div>
      </div>
    </div>

    <div class="section-block">
      <h2>Mandate Overview</h2>
      <div class="data-grid">
        <div class="data-row">
          <span class="row-label">Mandate type</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.mandate_type}>ℹ</span></span>
          <span
            class={getValTip('mandate_type', d.mandate_type) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('mandate_type', d.mandate_type)}
          >{fmt(d.mandate_type)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">ViDA alignment</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.vida_alignment}>ℹ</span></span>
          <span
            class={getValTip('vida_alignment', d.vida_alignment) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('vida_alignment', d.vida_alignment)}
          >{d.vida_alignment}</span>
        </div>
        {d.future_direction && (
          <div class="data-row">
            <span class="row-label">Future direction</span>
            <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.future_direction}>ℹ</span></span>
            <span class="row-val">{d.future_direction}</span>
          </div>
        )}
        <div class="data-row">
          <span class="row-label">B2C scope</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.b2c_scope}>ℹ</span></span>
          <span
            class={getValTip('b2c_scope', d.b2c_scope) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('b2c_scope', d.b2c_scope)}
          >{fmt(d.b2c_scope)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Phase-in</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.phase_in}>ℹ</span></span>
          <span class="row-val">{d.phase_in ? `Yes - ${fmt(d.phase_in_scope)}` : 'No'}</span>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2>Key Deadlines</h2>
      <div class="deadlines">
        {d.key_deadlines.map(dl => (
          <div class="deadline-row">
            <span class="deadline-date">{fmtDate(dl.date)}</span>
            <span class="deadline-desc">{dl.description}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="section-block">
      <h2>Format & Technical Details</h2>
      <div class="data-grid">
        <div class="data-row">
          <span class="row-label">Formats</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.formats}>ℹ</span></span>
          <span class="row-val">{d.formats.join(', ')}</span>
        </div>
        {d.cius && (
          <div class="data-row">
            <span class="row-label">CIUS</span>
            <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.cius}>ℹ</span></span>
            <span class="row-val">{d.cius}</span>
          </div>
        )}
        <div class="data-row">
          <span class="row-label">Platform</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.platform}>ℹ</span></span>
          <span class="row-val">{d.platform !== 'none' ? d.platform : 'None - direct exchange'}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Platform model</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.platform_model}>ℹ</span></span>
          <span
            class={getValTip('platform_model', d.platform_model) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('platform_model', d.platform_model)}
          >{fmt(d.platform_model)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Transport protocol</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.transport_protocol}>ℹ</span></span>
          <span
            class={getValTip('transport_protocol', d.transport_protocol) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('transport_protocol', d.transport_protocol)}
          >{d.transport_protocol !== 'none' ? d.transport_protocol : 'Not specified'}</span>
        </div>
        <div class="data-row">
          <span class="row-label">B2G signature</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.b2g_signature}>ℹ</span></span>
          <span
            class={getValTip('b2g_signature', d.b2g_signature) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('b2g_signature', d.b2g_signature)}
          >{fmt(d.b2g_signature)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">B2B signature</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.b2b_signature}>ℹ</span></span>
          <span
            class={getValTip('b2b_signature', d.b2b_signature) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('b2b_signature', d.b2b_signature)}
          >{fmt(d.b2b_signature)}</span>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2>Compliance Data</h2>
      <div class="data-grid">
        <div class="data-row">
          <span class="row-label">Master data ID</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.master_data_id}>ℹ</span></span>
          <span class="row-val">{d.master_data_id}</span>
        </div>
        <div class="data-row">
          <span class="row-label">PDF bundle</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.mandatory_pdf_bundle}>ℹ</span></span>
          <span
            class={getValTip('mandatory_pdf_bundle', d.mandatory_pdf_bundle) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('mandatory_pdf_bundle', d.mandatory_pdf_bundle)}
          >{fmt(d.mandatory_pdf_bundle)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Foreign resident scope</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.foreign_resident_scope}>ℹ</span></span>
          <span class="row-val">{d.foreign_resident_scope ? 'Yes' : 'No'}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Archiving</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.archiving_years}>ℹ</span></span>
          <span class="row-val">{d.archiving_years} years</span>
        </div>
        {d.penalty_max && (
          <div class="data-row">
            <span class="row-label">Penalty</span>
            <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.penalty_max}>ℹ</span></span>
            <span class="row-val">{d.penalty_max}</span>
          </div>
        )}
        {d.reporting_window && (
          <div class="data-row">
            <span class="row-label">Reporting window</span>
            <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.reporting_window}>ℹ</span></span>
            <span class="row-val">{d.reporting_window} days</span>
          </div>
        )}
        <div class="data-row">
          <span class="row-label">Correction mechanism</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.correction_mechanism}>ℹ</span></span>
          <span
            class={getValTip('correction_mechanism', d.correction_mechanism) ? 'val-tip row-val' : 'row-val'}
            data-tooltip={getValTip('correction_mechanism', d.correction_mechanism)}
          >{fmt(d.correction_mechanism)}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Document lifecycle</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.document_lifecycle_states}>ℹ</span></span>
          <span class="row-val">{d.document_lifecycle_states.join(' → ')}</span>
        </div>
        <div class="data-row">
          <span class="row-label">Sandbox available</span>
          <span class="row-icon"><span class="field-q" data-tooltip={FIELD_TIPS.has_sandbox}>ℹ</span></span>
          <span class="row-val">{d.has_sandbox ? 'Yes' : 'No'}</span>
        </div>
      </div>
    </div>

    <hr />

    <div class="layer2" id="layer2">
      <Content />
    </div>

    <div class="disclaimer">
      This content is provided for operational preparation purposes only and does not constitute legal, financial, or tax advice. While we strive for accuracy, EU regulatory requirements change frequently. Validate with your legal counsel or tax advisors before implementation. einvoiceops.eu is not an authoritative source of law.
    </div>
  </main>

  <GlossaryPanel country={d.code} />

  <script is:inline>
    // Section transformation: h2 headings → <details> accordions
    var layer2 = document.getElementById('layer2');
    if (layer2) {
      var headings = Array.from(layer2.querySelectorAll('h2'));
      headings.forEach(function(h2, i) {
        var body = document.createElement('div');
        body.className = 'section-body';
        var node = h2.nextSibling;
        while (node && !(node.nodeType === 1 && node.tagName === 'H2')) {
          var next = node.nextSibling;
          body.appendChild(node);
          node = next;
        }
        var details = document.createElement('details');
        details.id = 'sec-' + h2.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
        if (i === 0) details.open = true;
        var summary = document.createElement('summary');
        summary.textContent = h2.textContent;
        details.appendChild(summary);
        details.appendChild(body);
        layer2.insertBefore(details, h2);
        h2.remove();
      });
    }
  </script>

  <script is:inline>
    // Prose term scanner: wraps first occurrence per section, adds tooltip + panel link
    (function() {
      var terms = window.__glossaryTerms;
      if (!terms) return;
      var panel = document.getElementById('glossary-panel');
      var country = panel ? panel.dataset.country : '';

      function isVisible(t) {
        return t.countries.indexOf('general') !== -1 || t.countries.indexOf(country) !== -1;
      }

      var visible = terms
        .filter(isVisible)
        .sort(function(a, b) { return b.match.length - a.match.length; });

      function escapeRx(s) {
        return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function wrapFirstOccurrence(section, term) {
        var rx = new RegExp('\\b' + escapeRx(term.match) + '\\b', 'i');
        var walker = document.createTreeWalker(
          section,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode: function(node) {
              var el = node.parentElement;
              while (el && el !== section) {
                var tag = el.tagName;
                if (tag === 'SUMMARY' || tag === 'A' || tag === 'CODE' || tag === 'PRE' || tag === 'H2' || tag === 'H3' || tag === 'H4') {
                  return NodeFilter.FILTER_REJECT;
                }
                if (tag === 'SPAN' && el.classList && el.classList.contains('glossary-term')) {
                  return NodeFilter.FILTER_REJECT;
                }
                el = el.parentElement;
              }
              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );
        var node;
        while ((node = walker.nextNode())) {
          var text = node.textContent;
          var m = rx.exec(text);
          if (!m) continue;
          var before = text.slice(0, m.index);
          var matched = m[0];
          var after = text.slice(m.index + matched.length);
          var frag = document.createDocumentFragment();
          if (before) frag.appendChild(document.createTextNode(before));
          var span = document.createElement('span');
          span.className = 'glossary-term';
          span.dataset.termId = term.id;
          span.setAttribute('data-tooltip', term.def);
          span.textContent = matched;
          span.addEventListener('click', function() {
            var tid = this.dataset.termId;
            if (window.openGlossaryTo) window.openGlossaryTo(tid);
          });
          frag.appendChild(span);
          if (after) frag.appendChild(document.createTextNode(after));
          node.parentNode.replaceChild(frag, node);
          return true;
        }
        return false;
      }

      document.querySelectorAll('.section-body').forEach(function(section) {
        visible.forEach(function(term) {
          wrapFirstOccurrence(section, term);
        });
      });
    })();
  </script>
</body>
</html>
