---
import { getCollection, render } from 'astro:content';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  return countries.map(entry => ({
    params: { country: entry.data.code },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

function fmt(val: string | null | undefined): string {
  if (!val || val === 'none') return 'None';
  return val.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

function fmtDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{d.country} — EU E-invoicing Compliance Map — einvoiceops</title>
  <meta name="description" content={`E-invoicing mandate facts and operational preparation guide for ${d.country}. Who owns the work, what breaks first, what ready means.`} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:   #1a2b3c;
      --accent: #2563eb;
      --text:   #111827;
      --sub:    #374151;
      --muted:  #6b7280;
      --border: #e5e7eb;
      --bg:     #ffffff;
      --bg-alt: #f8f9fa;
      --sans:   -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    main { max-width: 760px; margin: 0 auto; padding: 36px 2rem 80px; }

    .breadcrumb { font-size: 0.82rem; color: var(--muted); margin-bottom: 24px; }
    .breadcrumb a { color: var(--accent); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .country-header {
      display: flex; align-items: flex-start; gap: 20px;
      margin-bottom: 32px; padding-bottom: 28px;
      border-bottom: 2px solid var(--navy);
    }
    .country-flag { font-size: 3rem; line-height: 1; flex-shrink: 0; }
    .country-header h1 {
      font-size: 1.75rem; font-weight: 800;
      color: var(--navy); letter-spacing: -0.03em;
      margin-bottom: 8px;
    }
    .header-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .badge {
      font-size: 0.68rem; font-weight: 700;
      padding: 3px 10px; border-radius: 100px;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .badge-live { background: #dcfce7; color: #166534; }
    .badge-announced { background: #fef9c3; color: #854d0e; }
    .badge-proposed { background: #f3f4f6; color: #6b7280; }
    .badge-mandatory { background: #eff6ff; color: #1d4ed8; }
    .badge-voluntary, .badge-none { background: #f3f4f6; color: #6b7280; }
    .verified { font-size: 0.78rem; color: var(--muted); }

    .section-block { margin-bottom: 28px; }
    .section-block h2 {
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 10px;
    }

    .data-grid { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .data-row {
      display: flex; align-items: baseline;
      padding: 10px 14px; gap: 16px;
      border-bottom: 1px solid var(--border);
      font-size: 0.875rem;
    }
    .data-row:last-child { border-bottom: none; }
    .data-row span:first-child {
      width: 180px; flex-shrink: 0;
      color: var(--muted); font-weight: 500;
    }
    .data-row span:last-child { color: var(--text); }
    .data-row:nth-child(even) { background: var(--bg-alt); }

    .deadlines { display: flex; flex-direction: column; gap: 8px; }
    .deadline-row {
      display: flex; align-items: baseline; gap: 16px;
      padding: 10px 14px;
      border: 1px solid var(--border); border-radius: 8px;
      font-size: 0.875rem;
    }
    .deadline-date {
      font-weight: 700; color: var(--navy);
      white-space: nowrap; flex-shrink: 0;
      font-variant-numeric: tabular-nums;
    }
    .deadline-desc { color: var(--sub); }

    hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }

    /* ---- Layer 2 expandable sections ---- */
    .layer2 { margin-bottom: 40px; }

    .layer2 :global(details) {
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    .layer2 :global(details[open]) {
      border-color: #bfdbfe;
    }
    .layer2 :global(summary) {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 18px;
      font-size: 0.95rem; font-weight: 700;
      color: var(--navy); letter-spacing: -0.01em;
      cursor: pointer;
      user-select: none;
      list-style: none;
      background: var(--bg);
    }
    .layer2 :global(details[open] summary) {
      background: #eff6ff;
      border-bottom: 1px solid #bfdbfe;
    }
    .layer2 :global(summary::-webkit-details-marker) { display: none; }
    .layer2 :global(summary::after) {
      content: '+';
      font-size: 1.1rem; font-weight: 400;
      color: var(--accent); flex-shrink: 0; margin-left: 12px;
    }
    .layer2 :global(details[open] summary::after) { content: '−'; }

    .layer2 :global(.section-body) {
      padding: 18px 18px 20px;
      background: var(--bg);
    }
    .layer2 :global(p) { font-size: 0.925rem; color: var(--sub); margin-bottom: 12px; line-height: 1.7; }
    .layer2 :global(p:last-child) { margin-bottom: 0; }
    .layer2 :global(strong) { color: var(--text); font-weight: 600; }
    .layer2 :global(ul), .layer2 :global(ol) {
      margin: 8px 0 12px 20px; font-size: 0.925rem; color: var(--sub);
    }
    .layer2 :global(li) { margin-bottom: 4px; line-height: 1.6; }

    .disclaimer {
      font-size: 0.78rem; color: var(--muted);
      padding: 16px 20px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-alt);
      line-height: 1.5;
    }

    @media (max-width: 600px) {
      .country-header { flex-direction: column; gap: 12px; }
      .data-row span:first-child { width: 140px; }
    }
  </style>
</head>
<body>
  <Nav active="map" />

  <main>
    <div class="breadcrumb">
      <a href="/map/">Compliance Map</a> / {d.country}
    </div>

    <div class="country-header">
      <div class="country-flag">{d.flag}</div>
      <div>
        <h1>{d.country}</h1>
        <div class="header-badges">
          <span class={`badge badge-${d.status}`}>{d.status}</span>
          <span class={`badge badge-${d.b2b}`}>B2B {d.b2b}</span>
          <span class={`badge badge-${d.b2g}`}>B2G {d.b2g}</span>
        </div>
        <div class="verified">Last verified: {fmtDate(d.last_verified)}</div>
      </div>
    </div>

    <div class="section-block">
      <h2>Mandate Overview</h2>
      <div class="data-grid">
        <div class="data-row"><span>Mandate type</span><span>{fmt(d.mandate_type)}</span></div>
        <div class="data-row"><span>ViDA alignment</span><span>{d.vida_alignment}</span></div>
        {d.future_direction && <div class="data-row"><span>Future direction</span><span>{d.future_direction}</span></div>}
        <div class="data-row"><span>B2C scope</span><span>{fmt(d.b2c_scope)}</span></div>
        <div class="data-row"><span>Phase-in</span><span>{d.phase_in ? `Yes - ${fmt(d.phase_in_scope)}` : 'No'}</span></div>
      </div>
    </div>

    <div class="section-block">
      <h2>Key Deadlines</h2>
      <div class="deadlines">
        {d.key_deadlines.map(dl => (
          <div class="deadline-row">
            <span class="deadline-date">{fmtDate(dl.date)}</span>
            <span class="deadline-desc">{dl.description}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="section-block">
      <h2>Format & Technical Details</h2>
      <div class="data-grid">
        <div class="data-row"><span>Formats</span><span>{d.formats.join(', ')}</span></div>
        {d.cius && <div class="data-row"><span>CIUS</span><span>{d.cius}</span></div>}
        <div class="data-row"><span>Platform</span><span>{d.platform !== 'none' ? d.platform : 'None - direct exchange'}</span></div>
        <div class="data-row"><span>Platform model</span><span>{fmt(d.platform_model)}</span></div>
        <div class="data-row"><span>Transport protocol</span><span>{d.transport_protocol !== 'none' ? d.transport_protocol : 'Not specified'}</span></div>
        <div class="data-row"><span>B2G signature</span><span>{fmt(d.b2g_signature)}</span></div>
        <div class="data-row"><span>B2B signature</span><span>{fmt(d.b2b_signature)}</span></div>
      </div>
    </div>

    <div class="section-block">
      <h2>Compliance Data</h2>
      <div class="data-grid">
        <div class="data-row"><span>Master data ID</span><span>{d.master_data_id}</span></div>
        <div class="data-row"><span>PDF bundle</span><span>{fmt(d.mandatory_pdf_bundle)}</span></div>
        <div class="data-row"><span>Foreign resident scope</span><span>{d.foreign_resident_scope ? 'Yes' : 'No'}</span></div>
        <div class="data-row"><span>Archiving</span><span>{d.archiving_years} years</span></div>
        {d.penalty_max && <div class="data-row"><span>Penalty</span><span>{d.penalty_max}</span></div>}
        {d.reporting_window && <div class="data-row"><span>Reporting window</span><span>{d.reporting_window} days</span></div>}
        <div class="data-row"><span>Correction mechanism</span><span>{fmt(d.correction_mechanism)}</span></div>
        <div class="data-row"><span>Document lifecycle</span><span>{d.document_lifecycle_states.join(' → ')}</span></div>
        <div class="data-row"><span>Sandbox available</span><span>{d.has_sandbox ? 'Yes' : 'No'}</span></div>
      </div>
    </div>

    <hr />

    <div class="layer2" id="layer2">
      <Content />
    </div>

    <div class="disclaimer">
      This content is provided for operational preparation purposes only and does not constitute legal, financial, or tax advice. While we strive for accuracy, EU regulatory requirements change frequently. Validate with your legal counsel or tax advisors before implementation. einvoiceops.eu is not an authoritative source of law.
    </div>
  </main>
  <script is:inline>
    const layer2 = document.getElementById('layer2');
    if (layer2) {
      const headings = Array.from(layer2.querySelectorAll('h2'));
      headings.forEach((h2, i) => {
        const id = 'sec-' + h2.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');

        // Collect content nodes between this h2 and the next
        const body = document.createElement('div');
        body.className = 'section-body';
        let node = h2.nextSibling;
        while (node && !(node.nodeType === 1 && node.tagName === 'H2')) {
          const next = node.nextSibling;
          body.appendChild(node);
          node = next;
        }

        // Build <details><summary>title</summary><div class="section-body">...</div></details>
        const details = document.createElement('details');
        details.id = id;
        if (i === 0) details.open = true;

        const summary = document.createElement('summary');
        summary.textContent = h2.textContent;

        details.appendChild(summary);
        details.appendChild(body);
        layer2.insertBefore(details, h2);
        h2.remove();

      });
    }
  </script>
</body>
</html>
