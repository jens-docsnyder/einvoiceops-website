---
// /map/ now lives on the homepage at /#map
// Preserve any country hash: /map/#DE → /#DE (homepage picks it up)
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0; url=/#map" />
  <link rel="canonical" href="https://einvoiceops.eu/#map" />
  <title>EU E-invoicing Compliance Map — einvoiceops</title>
</head>
<body>
  <script>
    // Preserve country hash: /map/#DE → /#DE
    var h = location.hash;
    location.replace('/' + (h || '#map'));
  </script>
</body>
</html>
