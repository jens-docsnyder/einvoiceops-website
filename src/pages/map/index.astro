---
import { getCollection } from 'astro:content';
import Nav from '../../components/Nav.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const entries = await getCollection('countries');
const svgRaw = readFileSync(resolve('./public/BlankMap-Europe.svg'), 'utf-8');

// Strip XML declaration, inject id + viewBox, remove inline fills so CSS can control them
const svgContent = svgRaw
  .replace(/<\?xml[^?]*\?>\s*/g, '')
  // <svg tag is followed by a newline, not a space — match with regex
  .replace(/(<svg)(\s)/, '$1 id="eu-map" viewBox="0 0 400.87827 419.87268" preserveAspectRatio="xMidYMid meet"$2')
  // Remove inline fill styles from paths so CSS can override them
  .replace(/\s*style="fill:#c5c5c5;fill-opacity:1"/g, '');

// Country path IDs → codes (verified by bounding box centroid analysis)
const countryPaths: Record<string, string> = {
  path7015: 'DE',
  path7031: 'IT',
  path7041: 'FR',
  path7019: 'BE',
  path7017: 'NL',
  path7039: 'DK',  // Jutland peninsula
  path7021: 'DK',  // Danish islands (Zealand, Funen, Faroe)
  path6999: 'PL',
  path8160: 'RO',
  path7033: 'SE',  // Sweden (path7029 is Norway — no country page)
  path7025: 'FI',
  path7043: 'ES',
};

// Flag overlay positions as % of SVG viewport (400x420)
const overlayPositions: Record<string, { x: number; y: number }> = {
  DE: { x: 46.5, y: 58.9 },
  IT: { x: 55.6, y: 82.8 },
  FR: { x: 34.3, y: 72.7 },
  BE: { x: 36.3, y: 61.2 },
  NL: { x: 37.8, y: 56.7 },
  DK: { x: 43.7, y: 45.4 },
  PL: { x: 61.8, y: 53.3 },
  RO: { x: 70.2, y: 73.6 },
  SE: { x: 49.0, y: 28.0 },
  FI: { x: 62.0, y: 24.0 },
  ES: { x: 21.0, y: 89.0 },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EU E-invoicing Compliance Map — einvoiceops</title>
  <meta name="description" content="EU e-invoicing mandate facts and operational preparation guidance, country by country." />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:   #1a2b3c;
      --accent: #2563eb;
      --text:   #111827;
      --muted:  #6b7280;
      --border: #e5e7eb;
      --bg:     #ffffff;
      --sans:   -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    body { font-family: var(--sans); color: var(--text); background: var(--bg); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }

    main { max-width: 900px; margin: 0 auto; padding: 48px 2rem 80px; }

    .page-header { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 2px solid var(--navy); }
    .page-header h1 { font-size: 1.9rem; font-weight: 800; color: var(--navy); letter-spacing: -0.03em; margin-bottom: 8px; }
    .page-header p { font-size: 0.95rem; color: var(--muted); max-width: 560px; line-height: 1.5; }

    /* ---- SVG MAP ---- */
    .map-wrap { position: relative; width: 100%; max-width: 620px; margin: 0 auto 20px; }

    #eu-map {
      width: 100%;
      height: auto;
      display: block;
    }

    /* All country fills: light gray */
    #eu-map path {
      fill: #e8edf2;
      stroke: #b4bec9;
      stroke-width: 0.4;
      transition: fill 0.12s;
    }

    /* Countries with entries: blue tint */
    #eu-map #path7015,
    #eu-map #path7031,
    #eu-map #path7041,
    #eu-map #path7019,
    #eu-map #path7017,
    #eu-map #path7039,
    #eu-map #path7021,
    #eu-map #path6999,
    #eu-map #path8160,
    #eu-map #path7033,
    #eu-map #path7025,
    #eu-map #path7043 {
      fill: #dbeafe;
      stroke: #93c5fd;
      stroke-width: 0.6;
      cursor: pointer;
    }
    #eu-map #path7015:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7031:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7041:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7019:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7017:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7039:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7021:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path6999:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path8160:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7033:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7025:hover { fill: #2563eb; stroke: #1d4ed8; }
    #eu-map #path7043:hover { fill: #2563eb; stroke: #1d4ed8; }

    /* ---- FLAG TILES overlaid on SVG ---- */
    .flag-overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
    }
    .flag-pin {
      position: absolute;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
      pointer-events: all;
      text-decoration: none;
      cursor: pointer;
    }
    .flag-pin-emoji {
      font-size: clamp(14px, 2.4vw, 22px);
      line-height: 1;
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
      transition: transform 0.12s;
    }
    .flag-pin:hover .flag-pin-emoji { transform: scale(1.25); }
    .flag-pin-code {
      font-size: clamp(7px, 1.1vw, 11px);
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.04em;
      background: rgba(255,255,255,0.85);
      padding: 1px 4px;
      border-radius: 3px;
    }

    /* ---- PATH ID DEBUG TOOLTIP ---- */
    #path-debug {
      font-size: 0.72rem;
      color: var(--muted);
      min-height: 1.2em;
      margin-bottom: 12px;
      text-align: center;
    }

    /* ---- LEGEND ---- */
    .map-legend { display: flex; gap: 20px; font-size: 0.78rem; color: var(--muted); margin-bottom: 36px; align-items: center; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-swatch { width: 14px; height: 10px; border-radius: 2px; border: 1px solid; }
    .legend-swatch-entry { background: #dbeafe; border-color: #93c5fd; }
    .legend-swatch-soon  { background: #e8edf2; border-color: #b4bec9; }

    /* ---- ENTRY LIST ---- */
    .list-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
    .country-list { display: flex; flex-direction: column; gap: 10px; }
    .country-row { display: flex; align-items: center; gap: 16px; padding: 16px 20px; border: 1px solid var(--border); border-radius: 10px; text-decoration: none; color: var(--text); transition: border-color 0.15s, box-shadow 0.12s; }
    .country-row:hover { border-color: var(--accent); box-shadow: 0 2px 12px rgba(37,99,235,0.08); }
    .row-flag { font-size: 1.5rem; flex-shrink: 0; }
    .row-name { font-weight: 700; color: var(--navy); font-size: 0.95rem; }
    .row-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 3px; }
    .badge { font-size: 0.66rem; font-weight: 700; padding: 2px 8px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.04em; }
    .badge-live { background: #dcfce7; color: #166534; }
    .badge-mandatory { background: #eff6ff; color: #1d4ed8; }
    .row-arrow { margin-left: auto; color: var(--muted); font-size: 1rem; }
  </style>
</head>
<body>
  <Nav active="map" />

  <main>
    <div class="page-header">
      <h1>EU E-invoicing Compliance Map</h1>
      <p>Mandate facts and operational preparation guidance, country by country. Who owns the work, what breaks first, what ready actually means.</p>
    </div>

    <div class="map-wrap">
      <Fragment set:html={svgContent} />

      <!-- Flag pins overlaid at country centroids -->
      <div class="flag-overlay">
        {entries.map(entry => {
          const pos = overlayPositions[entry.data.code];
          if (!pos) return null;
          return (
            <a
              href={`/map/${entry.data.code}/`}
              class="flag-pin"
              style={`left: ${pos.x}%; top: ${pos.y}%;`}
              title={entry.data.country}
            >
              <span class="flag-pin-emoji">{entry.data.flag}</span>
              <span class="flag-pin-code">{entry.data.code}</span>
            </a>
          );
        })}
      </div>
    </div>

    <div id="path-debug" style="display:none"></div>

    <div class="map-legend">
      <div class="legend-item"><div class="legend-swatch legend-swatch-entry"></div> Entry available - click to open</div>
      <div class="legend-item"><div class="legend-swatch legend-swatch-soon"></div> Coming soon</div>
    </div>

    {entries.length > 0 && (
      <div>
        <div class="list-label">Available entries</div>
        <div class="country-list">
          {entries.sort((a, b) => a.data.country.localeCompare(b.data.country)).map(entry => (
            <a href={`/map/${entry.data.code}/`} class="country-row">
              <span class="row-flag">{entry.data.flag}</span>
              <div>
                <div class="row-name">{entry.data.country}</div>
                <div class="row-badges">
                  <span class="badge badge-live">{entry.data.status}</span>
                  <span class="badge badge-mandatory">B2B {entry.data.b2b}</span>
                </div>
              </div>
              <span class="row-arrow">&#8594;</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </main>

  <script is:inline>
    // Click navigation for country paths
    const routes = { path7015: '/map/DE/', path7031: '/map/IT/', path7041: '/map/FR/', path7019: '/map/BE/', path7017: '/map/NL/', path7039: '/map/DK/', path7021: '/map/DK/', path6999: '/map/PL/', path8160: '/map/RO/', path7033: '/map/SE/', path7025: '/map/FI/', path7043: '/map/ES/' };
    Object.entries(routes).forEach(([id, href]) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('click', () => location.href = href);
    });

    // Debug: show path ID on hover so you can identify countries
    const debug = document.getElementById('path-debug');
    document.querySelectorAll('#eu-map path').forEach(p => {
      p.addEventListener('mouseenter', () => {
        if (debug) debug.textContent = 'Path ID: ' + p.id + (routes[p.id] ? ' → ' + routes[p.id] : '');
      });
      p.addEventListener('mouseleave', () => {
        if (debug) debug.textContent = 'Hover over a country to see its path ID';
      });
    });
  </script>
</body>
</html>
