---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Service Model | einvoiceops</title>
  <meta name="description" content="How einvoiceops works: Scoping, Readiness Sprint, and Continuous Mandate Coverage. From mapping your mandate footprint to staying ready as e-invoicing laws change." />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:        #1a2b3c;
      --navy-soft:   #243447;
      --accent:      #2563eb;
      --accent-dark: #1d4ed8;
      --text:        #111827;
      --sub:         #374151;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --bg:          #ffffff;
      --bg-alt:      #f8f9fa;
      --ice:         #eff6ff;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem; height: 60px;
      display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    }
    .logo {
      font-size: 1.05rem; font-weight: 800;
      letter-spacing: -0.03em; color: var(--navy);
      text-decoration: none; white-space: nowrap;
    }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a {
      font-size: 0.875rem; color: var(--muted);
      text-decoration: none; font-weight: 500; transition: color 0.15s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--text); }
    nav a.btn-nav {
      font-size: 0.875rem; font-weight: 600;
      color: var(--bg); background: var(--accent);
      text-decoration: none; padding: 8px 18px;
      border-radius: 8px; transition: background 0.15s;
    }
    nav a.btn-nav:hover { background: var(--accent-dark); }
    @media (max-width: 600px) { .nav-links .hide-mobile { display: none; } }

    .page-hero {
      background: var(--navy);
      color: white;
      padding: 72px 2rem 64px;
      text-align: center;
    }
    .page-eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.55); margin-bottom: 16px;
    }
    .page-hero h1 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 800; letter-spacing: -0.03em;
      color: #ffffff; max-width: 680px;
      margin: 0 auto 16px; line-height: 1.2;
    }
    .page-hero p {
      font-size: 1.05rem; color: rgba(255,255,255,0.72);
      max-width: 560px; margin: 0 auto; line-height: 1.65;
    }

    .inner { max-width: 900px; margin: 0 auto; padding: 0 2rem; }
    .section { padding: 72px 0; }
    .section.bg-alt { background: var(--bg-alt); }

    .eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 12px;
    }
    .section-h {
      font-size: clamp(1.4rem, 3vw, 1.85rem);
      font-weight: 800; letter-spacing: -0.02em;
      color: var(--navy); line-height: 1.25; margin-bottom: 12px;
    }
    .section-lead {
      font-size: 1rem; color: var(--sub);
      line-height: 1.7; max-width: 640px; margin-bottom: 40px;
    }

    /* ── Stage cards ── */
    .stages { display: flex; flex-direction: column; gap: 0; margin-top: 32px; }

    .stage {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 0;
      border-radius: 12px;
      padding: 32px;
    }
    @media (max-width: 640px) { .stage { grid-template-columns: 1fr; } }

    .stage.st-pale {
      background: var(--bg-alt);
      border: 1px solid var(--border);
    }
    .stage.st-mid {
      background: var(--ice);
      border: 2px solid var(--accent);
    }
    .stage.st-dark {
      background: var(--accent);
      border: 2px solid var(--accent-dark);
    }

    .stage-label-col { padding-right: 28px; padding-top: 4px; }

    .stage-num {
      display: block;
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 6px;
    }
    .stage-name {
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--navy); line-height: 1.4;
    }
    .stage-body h3 {
      font-size: 1.15rem; font-weight: 800;
      color: var(--navy); margin-bottom: 12px;
      letter-spacing: -0.01em;
    }

    .stage-bullets { list-style: none; padding: 0; margin: 0 0 0 0; }
    .stage-bullets li {
      font-size: 0.875rem; color: var(--sub);
      line-height: 1.6; padding: 3px 0 3px 18px;
      position: relative;
    }
    .stage-bullets li::before {
      content: '\00B7';
      position: absolute; left: 4px;
      color: var(--accent); font-weight: 700; font-size: 1.1rem; line-height: 1.5;
    }

    /* st-mid overrides */
    .st-mid .stage-num  { color: var(--accent); }
    .st-mid .stage-name { color: var(--accent-dark); }

    /* st-dark overrides */
    .st-dark .stage-num  { color: rgba(255,255,255,0.55); }
    .st-dark .stage-name { color: rgba(255,255,255,0.9); }
    .st-dark .stage-body h3   { color: #ffffff; }
    .st-dark .stage-bullets li        { color: rgba(255,255,255,0.82); }
    .st-dark .stage-bullets li::before { color: #93c5fd; }

    /* ── Connectors ── */
    .stage-connector {
      display: flex; flex-direction: column; align-items: center;
      height: 48px;
    }
    .connector-line {
      width: 2px; flex: 1;
      background: var(--border);
      border-radius: 2px; overflow: hidden;
      position: relative;
    }
    .connector-fill {
      position: absolute; top: 0; left: 0; right: 0;
      height: 0%;
      background: var(--accent);
      transition: height 0.55s ease-out;
      border-radius: 2px;
    }
    .stage-connector.active .connector-fill { height: 100%; }

    .connector-arrow {
      font-size: 0.75rem; line-height: 1;
      color: var(--border); margin-top: 3px;
      transition: color 0.3s ease-out 0.45s;
    }
    .stage-connector.active .connector-arrow { color: var(--accent); }

    /* ── Inner deliverables (inside st-mid) ── */
    .inner-deliverables {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 12px; margin: 20px 0 16px;
    }
    @media (max-width: 600px) { .inner-deliverables { grid-template-columns: 1fr; } }

    .inner-deliverable {
      background: white; border-radius: 10px;
      padding: 14px 16px;
    }
    .inner-deliverable h4 {
      font-size: 0.8rem; font-weight: 700;
      color: var(--navy); margin-bottom: 4px;
    }
    .inner-deliverable p {
      font-size: 0.8rem; color: var(--sub); line-height: 1.55; margin: 0;
    }

    /* Orchestrator note (inside st-mid) */
    .orch-note {
      font-size: 0.82rem; font-weight: 600;
      color: var(--accent-dark);
      background: white;
      border-left: 3px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: 10px 14px; margin: 0 0 16px;
      line-height: 1.55;
    }

    /* Sprint compact tag (inside st-mid) */
    .sprint-compact {
      display: flex; flex-wrap: wrap;
      align-items: center; gap: 8px;
      background: white; border: 1px solid var(--border);
      border-radius: 10px; padding: 12px 16px;
    }
    .sprint-compact-title {
      font-size: 0.78rem; color: var(--muted); font-weight: 500;
    }

    /* Event inline (inside st-dark) */
    .event-inline {
      background: rgba(0,0,0,0.18); border-radius: 10px;
      padding: 16px 18px; margin: 20px 0 16px;
    }
    .event-inline-label {
      display: block; font-size: 0.63rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.5); margin-bottom: 7px;
    }
    .event-inline > p {
      font-size: 0.84rem; color: rgba(255,255,255,0.82);
      line-height: 1.7; margin: 0;
    }

    /* Coverage grid (inside st-dark) */
    .inner-coverage {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 12px; margin: 0 0 20px;
    }
    @media (max-width: 600px) { .inner-coverage { grid-template-columns: 1fr; } }

    .inner-coverage-point h4 {
      font-size: 0.8rem; font-weight: 700;
      color: #ffffff; margin-bottom: 4px;
    }
    .inner-coverage-point p {
      font-size: 0.8rem; color: rgba(255,255,255,0.72);
      line-height: 1.55; margin: 0;
    }

    /* Pills shared */
    /* ---- COCKPIT EMBED ---- */
    .cockpit-wrap {
      margin-top: 36px;
    }
    .cockpit-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: #93c5fd;
      margin-bottom: 10px;
      display: block;
    }
    .cockpit-frame {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 8px 40px rgba(0,0,0,0.25), 0 2px 8px rgba(0,0,0,0.12);
    }
    .cockpit-frame img { width: 100%; display: block; }
    .cockpit-caption {
      margin-top: 12px;
      font-size: 0.75rem;
      color: #9ca3af;
      line-height: 1.6;
    }

    .sprint-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .sprint-pill {
      background: var(--bg-alt); border: 1px solid var(--border);
      border-radius: 100px; font-size: 0.72rem; font-weight: 600;
      color: var(--sub); padding: 4px 12px;
    }
    .st-dark .sprint-pill {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.25);
      color: rgba(255,255,255,0.9);
    }
    .sprint-badge {
      display: inline-block;
      background: var(--bg-alt); border: 1px solid var(--border);
      border-radius: 6px; font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted); padding: 3px 9px;
    }

    /* ── Contact ── */
    .contact-box {
      background: var(--navy); border-radius: 20px;
      padding: 56px 48px; text-align: center;
    }
    @media (max-width: 600px) { .contact-box { padding: 40px 24px; } }
    .contact-box h2 {
      font-size: clamp(1.25rem, 3vw, 1.65rem);
      font-weight: 800; color: #ffffff;
      letter-spacing: -0.02em; margin-bottom: 12px; line-height: 1.3;
    }
    .contact-box p {
      font-size: 0.95rem; color: rgba(255,255,255,0.65);
      margin-bottom: 28px; line-height: 1.65;
      max-width: 460px; margin-left: auto; margin-right: auto;
    }
    .email-link {
      font-size: 1.1rem; font-weight: 700;
      color: #ffffff; text-decoration: none;
      border-bottom: 2px solid rgba(255,255,255,0.3);
      padding-bottom: 2px; transition: border-color 0.15s;
    }
    .email-link:hover { border-color: #ffffff; }

    footer {
      background: var(--navy); color: rgba(255,255,255,0.45);
      padding: 24px 2rem; text-align: center;
      font-size: 0.8rem; display: flex;
      flex-direction: column; gap: 6px;
    }
    footer a { color: rgba(255,255,255,0.45); text-decoration: none; }
    footer a:hover { color: white; }

    .disclaimer {
      background: var(--bg-alt); border-top: 1px solid var(--border);
      padding: 20px 2rem; text-align: center;
    }
    .disclaimer p {
      font-size: 0.72rem; color: #9ca3af;
      max-width: 720px; margin: 0 auto; line-height: 1.65;
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">einvoice<span>ops</span></a>
  <div class="nav-links">
    <a href="/#calculator" class="hide-mobile">Mandate Cost Calculator</a>
    <a href="/services/" class="hide-mobile active">Services</a>
    <a href="/map/" class="hide-mobile">Compliance Map</a>
    <a href="/#faq" class="hide-mobile">FAQ</a>
    <a href="/#contact" class="btn-nav">Get in touch</a>
  </div>
</nav>

<div class="page-hero">
  <span class="page-eyebrow">Service model</span>
  <h1>From mapping your mandate footprint to staying ready as laws change.</h1>
</div>

<!-- UNIFIED JOURNEY -->
<section class="section">
  <div class="inner">
    <span class="eyebrow">How it works</span>
    <h2 class="section-h">We enable you to become mandate-ready in three stages.</h2>

    <div class="stages">

      <!-- Stage 1 -->
      <div class="stage st-pale">
        <div class="stage-label-col">
          <span class="stage-num">Stage 1</span>
          <span class="stage-name">Scoping &amp; Onboarding</span>
        </div>
        <div class="stage-body">
          <h3>Mapping your mandate footprint</h3>
          <ul class="stage-bullets">
            <li>Map entities, countries, and which mandates apply - and when</li>
            <li>Assess ERP baseline and agree sprint scope and priority order</li>
            <li>Brief every function on what they will receive and what they own</li>
          </ul>
        </div>
      </div>

      <!-- Connector 1 -->
      <div class="stage-connector" id="connector-1">
        <div class="connector-line"><div class="connector-fill"></div></div>
        <div class="connector-arrow">&#9660;</div>
      </div>

      <!-- Stage 2 -->
      <div class="stage st-mid" id="stage-2">
        <div class="stage-label-col">
          <span class="stage-num">Stage 2</span>
          <span class="stage-name">Readiness Sprint</span>
        </div>
        <div class="stage-body">
          <h3>Structured preparation, routed to the right people</h3>
          <ul class="stage-bullets">
            <li>One work packet per function per mandate in scope</li>
            <li>Named owners, one shared plan, source-linked with snapshot dates</li>
          </ul>

          <div class="inner-deliverables">
            <div class="inner-deliverable">
              <h4>Finance Systems Owner</h4>
              <p>ERP requirements, master data corrections, vendor checklist, week-by-week action sequence.</p>
            </div>
            <div class="inner-deliverable">
              <h4>Tax / Compliance</h4>
              <p>Entity and transaction scope, VAT implications, correction rules, audit retention.</p>
            </div>
            <div class="inner-deliverable">
              <h4>Finance Ops</h4>
              <p>Go-live exception handling, validation failures, escalation paths, first-30-days monitoring.</p>
            </div>
            <div class="inner-deliverable">
              <h4>Local Partner Accountability</h4>
              <p>Structured question set per country entity, deadline per partner, confirmation record.</p>
            </div>
          </div>

          <div class="orch-note">
            Plus: one shared plan across all roles, all mandates, all entities - so the mandate manager sees the full picture, not scattered emails.
          </div>

          <div class="cockpit-wrap">
            <span class="cockpit-label">Readiness cockpit — mid-sprint view</span>
            <div class="cockpit-frame">
              <img
                src="/cockpit-demo.png"
                alt="Mandate readiness cockpit showing cluster matrix, work packet status, and action items for a 3-country engagement across France, Germany, and Poland."
                width="1960"
                height="2200"
              />
            </div>
            <p class="cockpit-caption">3-mandate engagement, week 2 of 4. Each cluster shows the owner function and current status. Work packets ship per role as clusters close. Blocked items surface immediately.</p>
          </div>

          <div class="sprint-compact">
            <span class="sprint-badge">Single mandate example</span>
            <span class="sprint-compact-title">France PA &nbsp;&middot;&nbsp; September 2026 &nbsp;&middot;&nbsp; one legal entity</span>
            <div class="sprint-pills">
              <span class="sprint-pill">Fixed scope</span>
              <span class="sprint-pill">Fixed fee</span>
              <span class="sprint-pill">50/50 milestone</span>
              <span class="sprint-pill">Source-linked</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Connector 2 -->
      <div class="stage-connector" id="connector-2">
        <div class="connector-line"><div class="connector-fill"></div></div>
        <div class="connector-arrow">&#9660;</div>
      </div>

      <!-- Stage 3 -->
      <div class="stage st-dark" id="stage-3">
        <div class="stage-label-col">
          <span class="stage-num">Stage 3</span>
          <span class="stage-name">Continuous Mandate Coverage</span>
        </div>
        <div class="stage-body">
          <h3>Stay ready as requirements change</h3>
          <ul class="stage-bullets">
            <li>We monitor official sources; you receive role-specific work updates, not alerts</li>
            <li>Each change produces a work packet sized to the change, within the business day</li>
            <li>Your mandate manager sees the full picture across all active mandates from one view</li>
          </ul>

          <div class="event-inline">
            <span class="event-inline-label">What a mandate change looks like</span>
            <p>A format update comes through for Poland's KSeF. Your Finance Systems Owner has a work packet before end of day - what changed, what it means for your ERP, what to do next. Your mandate manager sees the change flagged with open tasks per role. Nothing fell through because nobody on your team was monitoring Polish government documentation that week.</p>
          </div>

          <div class="inner-coverage">
            <div class="inner-coverage-point">
              <h4>Event-driven work packets</h4>
              <p>A new deadline is a full packet. A format update is a shorter digest. Sized to the change.</p>
            </div>
            <div class="inner-coverage-point">
              <h4>Manager visibility</h4>
              <p>One view across all active mandates and countries. Open tasks, handled, upcoming deadlines.</p>
            </div>
            <div class="inner-coverage-point">
              <h4>Monitored before the announcement</h4>
              <p>Official sources tracked continuously - before your platform vendor puts out a newsletter.</p>
            </div>
            <div class="inner-coverage-point">
              <h4>Scales with your footprint</h4>
              <p>Scoped to the countries in your sprint. A quiet quarter with no changes is a quiet quarter.</p>
            </div>
          </div>

          <div class="sprint-pills">
            <span class="sprint-pill">Quarterly commitment</span>
            <span class="sprint-pill">Scaled to your footprint</span>
            <span class="sprint-pill">Source-linked</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="section bg-alt" id="contact">
  <div class="inner">
    <div class="contact-box">
      <h2>Tell us your footprint. Get back a frank read of where you stand.</h2>
      <p>Send a short note with your countries, your ERP, and where you stand. We come back with a clear picture of what your situation requires - sprint, coverage, or both - in writing, within 48 hours. No sales sequence.</p>
      <a href="mailto:jens@einvoiceops.eu" class="email-link">jens@einvoiceops.eu</a>
    </div>
  </div>
</section>

<footer>
  <p>einvoiceops &nbsp;·&nbsp; <a href="mailto:jens@einvoiceops.eu">jens@einvoiceops.eu</a> &nbsp;·&nbsp; Finland</p>
  <p>&copy; 2026 einvoiceops &nbsp;·&nbsp; <a href="/legal/">Legal Notice</a> &nbsp;·&nbsp; <a href="/privacy/">Privacy Policy</a></p>
</footer>

<div class="disclaimer">
  <p>einvoiceops provides operational readiness support and is not a tax advisor, legal advisor, or compliance authority. All work packets are informational and operational planning aids only. Customers remain responsible for all compliance decisions and their execution. Confirm regulatory applicability with a qualified advisor where required.</p>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const id = entry.target.id;
      if (id === 'stage-2') document.getElementById('connector-1')?.classList.add('active');
      if (id === 'stage-3') document.getElementById('connector-2')?.classList.add('active');
    });
  }, { threshold: 0.15 });

  ['stage-2', 'stage-3'].forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>

</body>
</html>
