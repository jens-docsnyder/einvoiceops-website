import { getCollection } from 'astro:content';

const allCountries = await getCollection('countries');

function urgencyOrder(data: any): number {
  if (data.status === 'live' && data.b2b === 'mandatory' && data.mandate_hardness !== 'hard-inbound-soft-outbound') return 0;
  if (data.status === 'pilot') return 1;
  if (data.status === 'live' && data.mandate_hardness === 'hard-inbound-soft-outbound') return 2;
  if (data.status === 'live') return 3;
  return 4;
}

const countries = [...allCountries].sort((a, b) => urgencyOrder(a.data) - urgencyOrder(b.data));

function cardClass(data: any): string {
  if (data.status === 'live' && data.b2b === 'mandatory' && data.mandate_hardness !== 'hard-inbound-soft-outbound') return 'c-live';
  if (data.status === 'pilot') return 'c-urgent';
  if (data.status === 'live') return 'c-coming';
  return 'c-future';
}

function statusPill(data: any): string {
  if (data.status === 'live' && data.b2b === 'mandatory' && data.mandate_hardness !== 'hard-inbound-soft-outbound') return 'Live';
  if (data.status === 'pilot' && data.inbound_mandate_date) {
    const months = Math.round((data.inbound_mandate_date.getTime() - Date.now()) / (1000 * 60 * 60 * 24 * 30));
    return months > 0 ? `${months} months` : 'Imminent';
  }
  if (data.mandate_hardness === 'hard-inbound-soft-outbound') return 'Partial';
  if (data.status === 'announced') return 'Announced';
  if (data.status === 'proposed') return 'Proposed';
  if (data.b2b === 'voluntary') return 'B2G only';
  return 'Live';
}

function mandateLabel(data: any): string {
  if (data.mandate_type === 'clearance-pdp') return 'PA / Y-Model';
  if (data.mandate_type === 'centralized-clearance') {
    const m: Record<string, string> = { PL: 'KSeF / Clearance', IT: 'SdI / Clearance', RO: 'RO e-Factura' };
    return m[data.code] ?? `${data.formats?.[0] ?? ''} / Clearance`;
  }
  return data.formats?.[0] ?? 'Peppol BIS';
}

// Hardcoded notes for countries with split timelines; all others are computed.
// When adding a new country with complex phase-in, add an entry here.
const CARD_NOTES: Record<string, string> = {
  FR: 'Large companies Sept 2026<br>SME / micro Sept 2027',
  DE: 'Reception live Jan 2025<br>Issuance from Jan 2027',
  PL: 'Large taxpayers Feb 2026<br>All VAT-registered Apr 2026',
  IT: 'Mandatory since Jan 2019<br>Microenterprises from Jan 2024',
  DK: 'B2G since 2005<br>B2B bookkeeping capability live',
};

function cardNote(data: any): string {
  if (CARD_NOTES[data.code]) return CARD_NOTES[data.code];
  if (data.status === 'live' && data.b2b === 'mandatory') {
    const d: Date = data.inbound_mandate_date ?? new Date();
    return `Mandatory since ${d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}`;
  }
  if (data.b2b === 'voluntary') return 'B2G mandatory<br>B2B voluntary';
  const deadlines = (data.key_deadlines ?? []) as Array<{date: Date; description: string}>;
  const upcoming = deadlines.filter(d => d.date.getTime() >= Date.now());
  if (upcoming.length > 0) {
    const w = upcoming[0].description.split(' ');
    return w.slice(0, 7).join(' ') + (w.length > 7 ? '...' : '');
  }
  return 'No confirmed date yet';
}

const buildMonth = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
