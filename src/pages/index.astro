<script is:inline>
  /* ---- FAQ ---- */
  /* ---- CAROUSEL ---- */
  let carouselPos = 0;

  function carouselVisibleCount() {
    const vp = document.querySelector('.carousel-viewport');
    const card = document.querySelector('.clock-card');
    if (!vp || !card) return 4;
    return Math.max(1, Math.floor(vp.offsetWidth / (card.offsetWidth + 14)));
  }

  function carouselMaxPos() {
    return Math.max(0, document.querySelectorAll('.clock-card').length - carouselVisibleCount());
  }

  function carouselMove(dir) {
    carouselPos = Math.max(0, Math.min(carouselPos + dir, carouselMaxPos()));
    const track = document.getElementById('carousel-track');
    const card = document.querySelector('.clock-card');
    if (!track || !card) return;
    track.style.transform = `translateX(-${carouselPos * (card.offsetWidth + 14)}px)`;
    document.getElementById('carousel-prev').disabled = carouselPos === 0;
    document.getElementById('carousel-next').disabled = carouselPos >= carouselMaxPos();
  }

  function equalizeIcpHeadings() {
    const cards = [...document.querySelectorAll('.icp-card')];
    cards.forEach(c => { const h = c.querySelector('h3'); if (h) h.style.minHeight = ''; });
    const maxH = Math.max(...cards.map(c => c.querySelector('h3')?.offsetHeight || 0));
    if (maxH > 0) cards.forEach(c => { const h = c.querySelector('h3'); if (h) h.style.minHeight = maxH + 'px'; });
  }

  document.addEventListener('DOMContentLoaded', () => {
    carouselMove(0);
    equalizeIcpHeadings();
    window.addEventListener('resize', () => {
      carouselPos = Math.min(carouselPos, carouselMaxPos());
      carouselMove(0);
      equalizeIcpHeadings();
    });

    const track = document.getElementById('carousel-track');
    if (track) {
      let touchStartX = 0;
      let touchStartY = 0;
      let isDragging = false;

      track.addEventListener('touchstart', e => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isDragging = false;
      }, { passive: true });

      track.addEventListener('touchmove', e => {
        const dx = e.touches[0].clientX - touchStartX;
        const dy = e.touches[0].clientY - touchStartY;
        if (!isDragging && Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) {
          isDragging = true;
        }
        if (isDragging) e.preventDefault();
      }, { passive: false });

      track.addEventListener('touchend', e => {
        if (!isDragging) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) carouselMove(dx < 0 ? 1 : -1);
        isDragging = false;
      });
    }
  });

  function toggleIcpCard(card) {
    const isOpen = card.classList.contains('ic-open');
    document.querySelectorAll('.icp-card.ic-open').forEach(c => c.classList.remove('ic-open'));
    if (!isOpen) card.classList.add('ic-open');
  }

  (function () {
    const btn = document.getElementById('nav-hamburger');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    function closeMenu() {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', () => {
      const opening = !menu.classList.contains('open');
      opening ? (btn.classList.add('open'), menu.classList.add('open'), btn.setAttribute('aria-expanded', 'true')) : closeMenu();
    });

    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

    document.addEventListener('click', e => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
  })();

  function toggleJourneyPhase(card) {
    const isOpen = card.classList.contains('jp-open');
    document.querySelectorAll('.journey-phase.jp-open').forEach(c => c.classList.remove('jp-open'));
    if (!isOpen) card.classList.add('jp-open');
  }

  function toggleFaq(btn) {
    const item = btn.closest('.faq-item');
    item.classList.toggle('open');
  }

  /* ---- SOURCES PANEL ---- */
  function toggleSources(btn) {
    const drawer = document.getElementById('sources-drawer');
    const isOpen = drawer.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen);
  }

  /* ---- CALCULATOR ---- */

  // Base hours = readiness-only per mandate per entity
  // Low = 600h full impl × 45% readiness fraction; High = 900h × 45%
  // Source: Ardent Partners / Gartner 2024-26 lighter ERP benchmarks
  const MANDATE_BASE = {
    france:  { name: "France PA",          low: 270, high: 405 },
    poland:  { name: "Poland KSeF",       low: 290, high: 430 },
    germany: { name: "Germany B2B",       low: 270, high: 405 },
    belgium: { name: "Belgium Peppol",    low: 200, high: 300 },
    romania: { name: "Romania e-Factura", low: 200, high: 300 }
  };

  // ERP multiplier and per-entity scaling by named ERP
  // NetSuite / Dynamics: 1.0x baseline - widely accepted, per SAPinsider / implementation patterns
  // Sage X3: 1.2x - directional estimate based on architecture complexity; no published benchmark
  // Oracle Cloud ERP: 1.3x - directional estimate; Forrester ERP Landscape Q1 2026 cites higher config complexity
  // SAP S/4HANA: 1.5x - supported by SAPinsider 2025 complexity benchmarks; Forrester ERP Landscape Q1 2026
  // Multi-ERP: avg mult + 17.5% coordination overhead - modelled on Hackett Group (18% higher IT ops in fragmented envs)
  const ERP_CONFIG = {
    netsuite:  { mult: 1.0, entityScale: 0.15 },
    dynamics:  { mult: 1.0, entityScale: 0.15 },
    sap:       { mult: 1.5, entityScale: 0.60 },
    oracle:    { mult: 1.3, entityScale: 0.40 },
    sage:      { mult: 1.2, entityScale: 0.25 },
    other:     { mult: 1.0, entityScale: 0.15 }
  };

  const MULTI_ERP_COORDINATION = 0.135; // 12-15% integration penalty for mixed ERP - IDC 2025 "SaaS ERP Multi-Cloud Complexity" (midpoint 13.5%)

  function entityFactor(n, erpKey) {
    if (n <= 1) return 1.0;
    const cfg = ERP_CONFIG[erpKey] || ERP_CONFIG.other;
    return 1.0 + (n - 1) * cfg.entityScale;
  }

  /* ---- BANDEROLE RETIRE ---- */
  document.addEventListener('DOMContentLoaded', function() {
    const title = document.querySelector('.range-viz-title');
    if (title) {
      title.addEventListener('animationend', function() {
        title.classList.add('banderole-done');
      });
    }
  });

  function fmt(n) {
    return '€' + Math.round(n).toLocaleString('de-DE');
  }

  function fmtShort(n) {
    if (n >= 1000000) return '€' + (n / 1000000).toFixed(1) + 'M';
    if (n >= 1000)    return '€' + Math.round(n / 1000) + 'K';
    return '€' + Math.round(n);
  }

  function updateRangeBar(costLow, costHigh) {
    document.getElementById('range-viz').style.display = 'block';
    const lblLow  = document.getElementById('range-label-low');
    const lblHigh = document.getElementById('range-label-high');
    if (lblLow)  lblLow.textContent  = fmtShort(costLow);
    if (lblHigh) lblHigh.textContent = fmtShort(costHigh);
  }

  function calcUpdate() {
    const entities = parseInt(document.getElementById('calc-countries').value);
    document.getElementById('countries-display').textContent = entities + (entities >= 10 ? '+' : '');

    // Multi-ERP model: average multiplier across selected ERPs + 17.5% coordination overhead
    // Formula: Total = Σ(effort × ERP_i_mult / n_erps) × (1 + coordination) - Forrester TEI Q1 2026
    // Single ERP: straight multiplier, no coordination overhead
    const selectedERPs = [...document.querySelectorAll('input[name="calc-erp"]:checked')].map(i => i.value);
    const isMultiERP = selectedERPs.length > 1;
    const avgMult = selectedERPs.length > 0
      ? selectedERPs.reduce((sum, key) => sum + (ERP_CONFIG[key]?.mult || 1), 0) / selectedERPs.length
      : 1.0;
    const erpMult = isMultiERP ? avgMult * (1 + MULTI_ERP_COORDINATION) : avgMult;
    // Entity scaling: use worst-case ERP among selected
    const erpKey = selectedERPs.length > 0
      ? selectedERPs.reduce((best, key) =>
          (ERP_CONFIG[key]?.entityScale || 0.25) > (ERP_CONFIG[best]?.entityScale || 0.25) ? key : best
        , selectedERPs[0])
      : 'other';
    const rateEl  = document.querySelector('input[name="calc-rate"]:checked');
    const rate    = rateEl ? parseInt(rateEl.value) : 85;

    const selected = [...document.querySelectorAll('input[name="calc-mandate"]:checked')].map(i => i.value);

    const hoursEl     = document.getElementById('out-hours');
    const hoursNote   = document.getElementById('out-hours-note');
    const rangePills  = document.getElementById('out-range-pills');
    const scopeInt    = document.getElementById('out-scope-internal');
    const penaltyRow        = document.getElementById('penalty-row');
    const penaltyVal        = document.getElementById('penalty-value');
    const polandPenaltyRow  = document.getElementById('poland-penalty-row');
    const germanyPenaltyRow = document.getElementById('germany-penalty-row');

    if (selected.length === 0) {
      hoursEl.textContent    = '--';
      hoursNote.textContent  = 'Select a mandate above';
      rangePills.innerHTML   = '';
      scopeInt.textContent   = '--';
      penaltyRow.style.display     = 'none';
      polandPenaltyRow.style.display  = 'none';
      germanyPenaltyRow.style.display = 'none';
      document.getElementById('range-viz').style.display = 'none';
      return;
    }

    const eFactor = entityFactor(entities, erpKey);

    let totalLow = 0, totalHigh = 0;
    selected.forEach(m => {
      totalLow  += MANDATE_BASE[m].low;
      totalHigh += MANDATE_BASE[m].high;
    });

    const hoursLow  = Math.round(totalLow  * erpMult * eFactor);
    const hoursHigh = Math.round(totalHigh * erpMult * eFactor);
    const hoursMid  = Math.round((hoursLow + hoursHigh) / 2);

    const costLow  = hoursLow  * rate;
    const costHigh = hoursHigh * rate;
    const costMid  = hoursMid  * rate;

    hoursEl.textContent   = hoursLow.toLocaleString('de-DE') + ' – ' + hoursHigh.toLocaleString('de-DE') + 'h';
    hoursNote.textContent = selected.length + ' mandate' + (selected.length > 1 ? 's' : '') +
      ' · ' + entities + ' entit' + (entities > 1 ? 'ies' : 'y') + ' · readiness overhead only';

    rangePills.innerHTML =
      '<span style="font-size:0.72rem;background:var(--ice);color:var(--accent);border:1px solid #bfdbfe;padding:3px 10px;border-radius:100px;font-weight:600">Structured team: ' + hoursLow.toLocaleString('de-DE') + 'h</span>' +
      '<span style="font-size:0.72rem;background:#fffde7;color:#7c5000;border:1px solid #ffe082;padding:3px 10px;border-radius:100px;font-weight:600">Ad-hoc / reactive: ' + hoursHigh.toLocaleString('de-DE') + 'h</span>';

    updateRangeBar(costLow, costHigh);

    scopeInt.textContent = fmt(costMid) + ' (typical midpoint)';

    // France: €50/invoice capped at €15,000/year/entity (2026 Budget Law, confirmed Feb 2026)
    // Previously €15 - increased by 2026 Finance Act. Source: dynatos.com / vatcalc.com
    if (selected.includes('france')) {
      penaltyRow.style.display = 'flex';
      penaltyVal.textContent   = fmt(15000 * entities) + '/year';
    } else {
      penaltyRow.style.display = 'none';
    }

    // Poland: 100% of VAT per invoice, no cap (Art. 106ni VAT Act, post Jan 2027)
    polandPenaltyRow.style.display = selected.includes('poland') ? 'flex' : 'none';

    // Germany: €5K/invoice + €30K GoBD archiving (§26a UStG + BMF March 2026)
    germanyPenaltyRow.style.display = selected.includes('germany') ? 'flex' : 'none';
  }

  function toggleCheck(el) {
    const label = el.closest('.mandate-check');
    if (el.checked) label.classList.add('checked');
    else label.classList.remove('checked');
  }

  function toggleRadioGroup(groupName) {
    document.querySelectorAll('input[name="calc-' + groupName + '"]').forEach(radio => {
      const label = radio.closest('.radio-option');
      if (radio.checked) label.classList.add('checked');
      else label.classList.remove('checked');
    });
  }

  function toggleMethodology() {
    const btn  = document.querySelector('.meth-toggle');
    const body = document.getElementById('meth-body');
    if (!btn || !body) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    body.style.display = isOpen ? 'none' : 'block';
  }

  // Init
  calcUpdate();

  /* ---- CONTACT FORM ---- */
  const cfForm = document.getElementById('contact-form');
  if (cfForm) {
    cfForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('cf-submit');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      const formData = new FormData(cfForm);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData
        });
        const json = await res.json();
        if (json.success) {
          cfForm.style.display = 'none';
          document.getElementById('cf-success').style.display = 'block';
        } else {
          btn.disabled = false;
          btn.textContent = 'Send';
          alert('Web3Forms error: ' + (json.message || JSON.stringify(json)));
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Send';
        alert('Network error: ' + err.message);
      }
    });
  }
</script>

</body>
</html>
