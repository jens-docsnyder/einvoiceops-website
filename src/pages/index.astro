    cy: { name: "Cyprus",                 low: 40,   high: 150  },
  };

  // Annual maintenance hours per live mandate (Gemini research May 2026: schema/API update cycles)
  const MONITOR_BASE = {
    pl: { name: "Poland KSeF",            low: 60,   high: 350  },
    gr: { name: "Greece myDATA",          low: 60,   high: 320  },
    it: { name: "Italy SdI",              low: 45,   high: 280  },
    hu: { name: "Hungary RTIR",           low: 40,   high: 200  },
    hr: { name: "Croatia Fiscalization",  low: 35,   high: 150  },
    ro: { name: "Romania e-Factura",      low: 30,   high: 180  },
    pt: { name: "Portugal",               low: 30,   high: 140  },
    be: { name: "Belgium Peppol",         low: 20,   high: 100  },
    de: { name: "Germany XRechnung",      low: 25,   high: 120  },
    dk: { name: "Denmark Peppol",         low: 15,   high: 80   },
    se: { name: "Sweden Peppol",          low: 15,   high: 80   },
    fi: { name: "Finland Peppol",         low: 15,   high: 80   },
    nl: { name: "Netherlands Peppol",     low: 15,   high: 80   },
    no: { name: "Norway Peppol",          low: 15,   high: 80   },
    at: { name: "Austria",                low: 15,   high: 80   },
    sk: { name: "Slovakia",               low: 20,   high: 80   },
    ch: { name: "Switzerland",            low: 20,   high: 90   },
    lv: { name: "Latvia",                 low: 15,   high: 70   },
    lt: { name: "Lithuania",              low: 15,   high: 70   },
    si: { name: "Slovenia",               low: 15,   high: 70   },
    ee: { name: "Estonia",                low: 15,   high: 60   },
    lu: { name: "Luxembourg",             low: 15,   high: 60   },
  };

  // ERP multiplier and per-entity scaling by named ERP
  // NetSuite / Dynamics: 1.0x baseline - widely accepted, per SAPinsider / implementation patterns
  // Sage X3: 1.2x - directional estimate based on architecture complexity; no published benchmark
  // Oracle Cloud ERP: 1.3x - directional estimate; Forrester ERP Landscape Q1 2026 cites higher config complexity
  // SAP S/4HANA: 1.5x - supported by SAPinsider 2025 complexity benchmarks; Forrester ERP Landscape Q1 2026
  // Multi-ERP: avg mult + 17.5% coordination overhead - modelled on Hackett Group (18% higher IT ops in fragmented envs)
  const ERP_CONFIG = {
    netsuite:  { mult: 1.0, entityScale: 0.15 },
    dynamics:  { mult: 1.0, entityScale: 0.15 },
    sap:       { mult: 1.5, entityScale: 0.60 },
    oracle:    { mult: 1.3, entityScale: 0.40 },
    sage:      { mult: 1.2, entityScale: 0.25 },
    other:     { mult: 1.0, entityScale: 0.15 }
  };

  const MULTI_ERP_COORDINATION = 0.135; // 12-15% integration penalty for mixed ERP - IDC 2025 "SaaS ERP Multi-Cloud Complexity" (midpoint 13.5%)

  function entityFactor(n, erpKey) {
    if (n <= 1) return 1.0;
    const cfg = ERP_CONFIG[erpKey] || ERP_CONFIG.other;
    return 1.0 + (n - 1) * cfg.entityScale;
  }

  /* ---- BANDEROLE RETIRE ---- */
  document.addEventListener('DOMContentLoaded', function() {
    const title = document.querySelector('.range-viz-title');
    if (title) {
      title.addEventListener('animationend', function() {
        title.classList.add('banderole-done');
      });
    }
  });

  function fmt(n) {
    return '€' + Math.round(n).toLocaleString('de-DE');
  }

  function fmtShort(n) {
    if (n >= 1000000) return '€' + (n / 1000000).toFixed(1) + 'M';
    if (n >= 1000)    return '€' + Math.round(n / 1000) + 'K';
    return '€' + Math.round(n);
  }

  function updateRangeBar(costLow, costHigh) {
    document.getElementById('range-viz').style.display = 'block';
    const lblLow  = document.getElementById('range-label-low');
    const lblHigh = document.getElementById('range-label-high');
    if (lblLow)  lblLow.textContent  = fmtShort(costLow);
    if (lblHigh) lblHigh.textContent = fmtShort(costHigh);
  }

  function calcUpdate() {
    const entities = parseInt(document.getElementById('calc-countries').value);
    document.getElementById('countries-display').textContent = entities + (entities >= 10 ? '+' : '');

    const selectedERPs = [...document.querySelectorAll('input[name="calc-erp"]:checked')].map(i => i.value);
    const isMultiERP = selectedERPs.length > 1;
    const avgMult = selectedERPs.length > 0
      ? selectedERPs.reduce((sum, key) => sum + (ERP_CONFIG[key]?.mult || 1), 0) / selectedERPs.length
      : 1.0;
    const erpMult = isMultiERP ? avgMult * (1 + MULTI_ERP_COORDINATION) : avgMult;
    // Entity scaling: use worst-case ERP among selected
    const erpKey = selectedERPs.length > 0
      ? selectedERPs.reduce((best, key) =>
          (ERP_CONFIG[key]?.entityScale || 0.25) > (ERP_CONFIG[best]?.entityScale || 0.25) ? key : best
        , selectedERPs[0])
      : 'other';
    const rateEl  = document.querySelector('input[name="calc-rate"]:checked');
    const rate    = rateEl ? parseInt(rateEl.value) : 85;

    const readySelected   = [...document.querySelectorAll('.tile-btn.tile-ready.on')].map(b => b.dataset.code);
    const maintainSelected = [...document.querySelectorAll('.tile-btn.tile-maint.on')].map(b => b.dataset.code);

    const hoursEl     = document.getElementById(‘out-hours’);
    const hoursNote   = document.getElementById(‘out-hours-note’);
    const rangePills  = document.getElementById(‘out-range-pills’);
    const scopeInt    = document.getElementById(‘out-scope-internal’);
    const penaltyRow        = document.getElementById(‘penalty-row’);
    const penaltyVal        = document.getElementById(‘penalty-value’);
    const polandPenaltyRow  = document.getElementById(‘poland-penalty-row’);
    const germanyPenaltyRow = document.getElementById(‘germany-penalty-row’);
    const maintainBox  = document.getElementById(‘maintain-box’);
    const maintainHrs  = document.getElementById(‘maintain-hours’);
    const maintainNote = document.getElementById(‘maintain-note’);
    const maintainCostLow  = document.getElementById(‘maintain-cost-low’);
    const maintainCostHigh = document.getElementById(‘maintain-cost-high’);

    const eFactor = entityFactor(entities, erpKey);

    // ---- SECTION A: GETTING READY ----
    if (readySelected.length === 0) {
      hoursEl.textContent   = ‘--’;
      hoursNote.textContent = ‘Select mandates above’;
      rangePills.innerHTML  = ‘’;
      scopeInt.textContent  = ‘--’;
      penaltyRow.style.display        = ‘none’;
      polandPenaltyRow.style.display  = ‘none’;
      germanyPenaltyRow.style.display = ‘none’;
      document.getElementById(‘range-viz’).style.display = ‘none’;
    } else {
      const readyEls = [...document.querySelectorAll('.tile-btn.tile-ready.on')];
      const hasLive     = readyEls.some(el => el.dataset.live === ‘1’);
      const hasUpcoming = readyEls.some(el => el.dataset.live === ‘0’);
      const titleEl = document.getElementById(‘range-viz-title’);
      const subEl   = document.getElementById(‘range-viz-sub’);
      if (titleEl && subEl) {
        if (hasLive && !hasUpcoming) {
          titleEl.textContent = ‘Active remediation risk.’;
          subEl.textContent   = ‘These mandates are already live. If compliance was not established, penalty exposure and invoice rejection risk are active now.’;
        } else if (hasUpcoming && !hasLive) {
          titleEl.textContent = ‘Preparation investment - before go-live.’;
          subEl.textContent   = ‘Structured readiness costs less than reactive remediation. This is the internal cost before any external vendor or consulting fee.’;
        } else {
          titleEl.textContent = ‘Unbudgeted. Unavoidable.’;
          subEl.textContent   = "Mandate readiness doesn’t disappear when it’s unplanned - it gets absorbed as coordination, research and post-go-live firefighting.";
        }
      }

      let totalLow = 0, totalHigh = 0;
      readySelected.forEach(m => {
        if (MANDATE_BASE[m]) { totalLow += MANDATE_BASE[m].low; totalHigh += MANDATE_BASE[m].high; }
      });

      const hoursLow  = Math.round(totalLow  * erpMult * eFactor);
      const hoursHigh = Math.round(totalHigh * erpMult * eFactor);
      const hoursMid  = Math.round((hoursLow + hoursHigh) / 2);
      const costLow   = hoursLow  * rate;
      const costHigh  = hoursHigh * rate;
      const costMid   = hoursMid  * rate;

      hoursEl.textContent   = hoursLow.toLocaleString(‘de-DE’) + ‘ – ‘ + hoursHigh.toLocaleString(‘de-DE’) + ‘h’;
      hoursNote.textContent = readySelected.length + ‘ mandate’ + (readySelected.length > 1 ? ‘s’ : ‘’) +
        ‘ · ‘ + entities + ‘ entit’ + (entities > 1 ? ‘ies’ : ‘y’) + ‘ · readiness overhead only’;

      rangePills.innerHTML =
        ‘<span style="font-size:0.72rem;background:var(--ice);color:var(--accent);border:1px solid #bfdbfe;padding:3px 10px;border-radius:100px;font-weight:600">Structured: ‘ + hoursLow.toLocaleString(‘de-DE’) + ‘h</span>’ +
        ‘<span style="font-size:0.72rem;background:#fffde7;color:#7c5000;border:1px solid #ffe082;padding:3px 10px;border-radius:100px;font-weight:600">Ad-hoc: ‘ + hoursHigh.toLocaleString(‘de-DE’) + ‘h</span>’;

      updateRangeBar(costLow, costHigh);
      scopeInt.textContent = fmt(costMid) + ‘ (typical midpoint)’;

      const hasFr = readySelected.includes(‘fr’);
      penaltyRow.style.display = hasFr ? ‘flex’ : ‘none’;
      if (hasFr) penaltyVal.textContent = fmt(15000 * entities) + ‘/year’;

      polandPenaltyRow.style.display  = readySelected.includes(‘pl’) ? ‘flex’ : ‘none’;
      germanyPenaltyRow.style.display = readySelected.includes(‘de’) ? ‘flex’ : ‘none’;
    }

    // ---- SECTION B: STAYING CURRENT ----
    if (maintainSelected.length === 0) {
      maintainBox.style.display = ‘none’;
    } else {
      let mLow = 0, mHigh = 0;
      maintainSelected.forEach(m => {
        if (MONITOR_BASE[m]) { mLow += MONITOR_BASE[m].low; mHigh += MONITOR_BASE[m].high; }
      });

      const mHoursLow  = Math.round(mLow  * entities);
      const mHoursHigh = Math.round(mHigh * entities);

      maintainHrs.textContent  = mHoursLow.toLocaleString(‘de-DE’) + ‘ – ‘ + mHoursHigh.toLocaleString(‘de-DE’) + ‘h/year’;
      maintainNote.textContent = maintainSelected.length + ‘ mandate’ + (maintainSelected.length > 1 ? ‘s’ : ‘’) +
        ‘ · ‘ + entities + ‘ entit’ + (entities > 1 ? ‘ies’ : ‘y’);
      maintainCostLow.textContent  = fmt(mHoursLow  * rate) + ‘/year’;
      maintainCostHigh.textContent = fmt(mHoursHigh * rate) + ‘/year’;
      maintainBox.style.display = ‘block’;
    }
  }

  function tileToggle(btn) {
    btn.classList.toggle('on');
    const tile = btn.closest('.country-tile');
    if (tile) {
      const anyOn = tile.querySelectorAll('.tile-btn.on').length > 0;
      tile.classList.toggle('tile-active', anyOn);
    }
    calcUpdate();
  }

  function toggleCheck(el) {
    const label = el.closest('.mandate-check');
    if (!label) return;
    if (el.checked) label.classList.add('checked');
    else label.classList.remove('checked');
  }

  function toggleRadioGroup(groupName) {
    document.querySelectorAll('input[name="calc-' + groupName + '"]').forEach(radio => {
      const label = radio.closest('.radio-option');
      if (radio.checked) label.classList.add('checked');
      else label.classList.remove('checked');
    });
  }

  function toggleMethodology() {
    const btn  = document.querySelector('.meth-toggle');
    const body = document.getElementById('meth-body');
    if (!btn || !body) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    body.style.display = isOpen ? 'none' : 'block';
  }

  // Init
  calcUpdate();

  /* ---- CONTACT FORM ---- */
  const cfForm = document.getElementById('contact-form');
  if (cfForm) {
    cfForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('cf-submit');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      const data = Object.fromEntries(new FormData(cfForm));
      try {
        const res = await fetch('https://formspree.io/f/xnjwvnvb', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.ok) {
          cfForm.style.display = 'none';
          document.getElementById('cf-success').style.display = 'block';
        } else {
          btn.disabled = false;
          btn.textContent = 'Send';
          alert('Something went wrong. Email jens@einvoiceops.eu directly.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Send';
        alert('Something went wrong. Email jens@einvoiceops.eu directly.');
      }
    });
  }
</script>

</body>
</html>
