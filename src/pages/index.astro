<!-- HERO -->
<section class="hero">
  <h1>E-invoicing mandates multiply and shift. Finance teams need structure.</h1>
  <p class="hero-sub">EU countries are making electronic invoicing mandatory by law - each with its own format, platform, and deadline. Your invoicing platform handles the exchange. The internal preparation across Finance Systems, Tax, and AP Operations is your team's job.</p>
  <div class="hero-actions">
    <a href="#map" class="btn-primary">See what each country requires</a>
    <a href="#calculator" class="btn-ghost">See the enterprise benchmark</a>
  </div>
</section>

<hr class="section-rule" />

<!-- STATS BAR -->
<section class="stats-bar">
  <div class="stats-inner">
    <div class="stat-item">
      <div class="stat-number"><em>4–7</em>+</div>
      <div class="stat-label">e-invoicing regulatory updates per year across a typical 4-6 country EU footprint</div>
      <div class="stat-source">Vertex Regulatory Tracker Q4 2025</div>
    </div>
    <div class="stat-item">
      <div class="stat-number"><em>85</em>%</div>
      <div class="stat-label">of finance team time during an active rollout goes to coordination and triage, not execution</div>
      <div class="stat-source">Accenture 2024</div>
    </div>
    <div class="stat-item">
      <div class="stat-number"><em>15–25</em>%</div>
      <div class="stat-label">of invoices fail validation in the first 30 days after go-live when preparation was unstructured</div>
      <div class="stat-source">IOFM / SoftCo 2026</div>
    </div>
    <div class="stat-item">
      <div class="stat-number"><em>270–430</em>h</div>
      <div class="stat-label">internal preparation hours per mandate per entity, before ERP configuration begins</div>
      <div class="stat-source">Ardent Partners / Gartner 2024-26</div>
    </div>
  </div>
</section>

<!-- CALCULATOR -->
<section class="calc-section" id="calculator">
  <div class="calc-inner">
    <span class="eyebrow">Internal preparation cost</span>
    <h2 class="section-h">What mandate readiness costs for an enterprise</h2>
    <p class="section-lead">Two questions, two cost views. <strong>Getting ready</strong> estimates your one-time internal preparation cost per mandate - structured vs. reactive. <strong>Staying current</strong> estimates what you spend each year keeping live mandates up to date as schemas, APIs, and regulations change. All figures are internal team time only, before any external vendor fee.</p>

    <div class="calc-layout">

      <!-- INPUTS -->
      <div class="calc-inputs">

        <div class="calc-field">
          <label class="calc-label">Legal entities affected <span style="font-weight:400;color:var(--muted)">(across all selected mandates)</span><span class="help-tip" data-tip="A legal entity is a registered company (e.g. French SAS, Polish sp. z o.o., German GmbH). Set how many of your own entities need to comply, not the number of countries you sell into.">?</span></label>
          <div class="calc-slider-wrap">
            <input type="range" id="calc-countries" min="1" max="10" value="1" oninput="calcUpdate()">
            <span class="slider-val" id="countries-display">1</span>
          </div>
        </div>

        <div class="calc-field">
          <label class="calc-label">Your EU mandate footprint</label>
          <p class="calc-section-label">For each country: <strong>New for us</strong> = first-time setup, incl. M&amp;A additions. <strong>Stay current</strong> = mandate live, need to track ongoing changes.</p>
          <div class="country-grid">
            <div class="country-group-head">Upcoming B2B</div>
            <div class="country-tile"><div class="tile-head">🇫🇷 France <span>PDP · Sept 2026</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="fr" data-live="0" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" disabled title="B2B not yet live">Stay current</button></div></div>
            <div class="country-tile"><div class="tile-head">🇩🇪 Germany <span>B2B · Jan 2027</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="de" data-live="0" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" data-code="de" onclick="tileToggle(this)">Stay current</button></div></div>
            <div class="country-tile"><div class="tile-head">🇪🇸 Spain <span>Verifactu · 2027</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="es" data-live="0" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" disabled title="Not yet live">Stay current</button></div></div>
            <div class="country-group-head">Live B2B clearance</div>
            <div class="country-tile"><div class="tile-head">🇵🇱 Poland <span>KSeF · Live</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="pl" data-live="1" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" data-code="pl" onclick="tileToggle(this)">Stay current</button></div></div>
            <div class="country-tile"><div class="tile-head">🇮🇹 Italy <span>SdI · Live</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="it" data-live="1" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" data-code="it" onclick="tileToggle(this)">Stay current</button></div></div>
            <div class="country-tile"><div class="tile-head">🇬🇷 Greece <span>myDATA · Live</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="gr" data-live="1" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" data-code="gr" onclick="tileToggle(this)">Stay current</button></div></div>
            <div class="country-tile"><div class="tile-head">🇭🇺 Hungary <span>RTIR · Live</span></div><div class="tile-btns"><button class="tile-btn tile-ready" data-code="hu" data-live="1" onclick="tileToggle(this)">New for us</button><button class="tile-btn tile-maint" data-code="hu" onclick="tileToggle(this)">Stay current</button></div></div>
