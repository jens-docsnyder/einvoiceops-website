  function entityFactor(n, erpKey) {
    if (n <= 1) return 1.0;
    const cfg = ERP_CONFIG[erpKey] || ERP_CONFIG.other;
    return 1.0 + (n - 1) * cfg.entityScale;
  }

  function fmt(n) {
    return '€' + Math.round(n).toLocaleString('de-DE');
  }

  function fmtShort(n) {
    if (n >= 1000000) return '€' + (n / 1000000).toFixed(1) + 'M';
    if (n >= 1000)    return '€' + Math.round(n / 1000) + 'K';
    return '€' + Math.round(n);
  }

  function calcUpdate() {
    var sendNewSel  = [...document.querySelectorAll('#cat-list .send-new.on')].map(function(b){ return b.dataset.code; });
    var recvNewSel  = [...document.querySelectorAll('#cat-list .recv-new.on')].map(function(b){ return b.dataset.code; });
    var sendLiveSel = [...document.querySelectorAll('#cat-list .send-live.on')].map(function(b){ return b.dataset.code; });
    var recvLiveSel = [...document.querySelectorAll('#cat-list .recv-live.on')].map(function(b){ return b.dataset.code; });

    const selectedERPs = [...document.querySelectorAll('input[name="calc-erp"]:checked')].map(i => i.value);
    const isMultiERP   = selectedERPs.length > 1;
    const avgMult = selectedERPs.length > 0
      ? selectedERPs.reduce((sum, key) => sum + (ERP_CONFIG[key]?.mult || 1), 0) / selectedERPs.length
      : 1.0;
    const erpMult = isMultiERP ? avgMult * (1 + MULTI_ERP_COORDINATION) : avgMult;
    const erpKey = selectedERPs.length > 0
      ? selectedERPs.reduce((best, key) =>
          (ERP_CONFIG[key]?.entityScale || 0.15) > (ERP_CONFIG[best]?.entityScale || 0.15) ? key : best
        , selectedERPs[0])
      : 'other';
    const rateEl = document.querySelector('input[name="calc-rate"]:checked');
    const rate   = rateEl ? parseInt(rateEl.value) : 85;

    const heroEl = document.getElementById('co-hero');
    const chipEl = document.getElementById('calc-comparison');
    const sumEl  = document.getElementById('penalty-summary');
    const penRow = document.getElementById('penalty-row');
    const penVal = document.getElementById('penalty-value');
    const plRow  = document.getElementById('poland-penalty-row');
    const deRow  = document.getElementById('germany-penalty-row');

    // ---- SECTION A: READINESS (send + recv new) ----
    let costLow = 0, costHigh = 0, hoursLow = 0, hoursHigh = 0;
    const rowReady = document.getElementById('co-row-ready');
    var hasReady = sendNewSel.length > 0 || recvNewSel.length > 0;

    if (hasReady) {
      let totalLow = 0, totalHigh = 0;
      sendNewSel.forEach(function(m) {
        if (MANDATE_BASE[m]) { totalLow += MANDATE_BASE[m].send.low; totalHigh += MANDATE_BASE[m].send.high; }
      });
      recvNewSel.forEach(function(m) {
        if (MANDATE_BASE[m]) { totalLow += MANDATE_BASE[m].recv.low; totalHigh += MANDATE_BASE[m].recv.high; }
      });
      hoursLow  = Math.round(totalLow  * erpMult);
      hoursHigh = Math.round(totalHigh * erpMult);
      costLow   = hoursLow  * rate;
      costHigh  = hoursHigh * rate;

      if (rowReady) {
        rowReady.style.display = 'flex';
        document.getElementById('co-ready-low').textContent  = fmtShort(costLow);
        document.getElementById('co-ready-high').textContent = fmtShort(costHigh);
        document.getElementById('co-ready-hrs').textContent  = hoursLow + ' - ' + hoursHigh + 'h';
      }

      const hasFr = sendNewSel.includes('fr') || recvNewSel.includes('fr');
      const hasPl = sendNewSel.includes('pl') || recvNewSel.includes('pl');
      const hasDe = sendNewSel.includes('de') || recvNewSel.includes('de');
      const penParts = [];
      if (hasFr) penParts.push('FR');
      if (hasPl) penParts.push('PL');
      if (hasDe) penParts.push('DE');
      if (penRow) penRow.style.display = hasFr ? 'flex' : 'none';
      if (penVal) penVal.textContent = hasFr ? 'Up to EUR 15K/entity/yr' : '';
      if (plRow)  plRow.style.display = hasPl ? 'flex' : 'none';
      if (deRow)  deRow.style.display = hasDe ? 'flex' : 'none';
      if (chipEl && sumEl) {
        if (penParts.length > 0) {
          sumEl.textContent = 'Statutory risk: ' + penParts.join(', ');
          chipEl.style.display = 'block';
        } else {
          chipEl.style.display = 'none';
        }
      }
    } else {
      if (rowReady) rowReady.style.display = 'none';
      if (chipEl)   chipEl.style.display = 'none';
    }

    // ---- SECTION B: MAINTENANCE (send + recv compliant) ----
    let mCostLow = 0, mCostHigh = 0;
    const rowMaint = document.getElementById('co-row-maint');
    var hasMaint = sendLiveSel.length > 0 || recvLiveSel.length > 0;

    if (hasMaint) {
      let mLow = 0, mHigh = 0;
      sendLiveSel.forEach(function(m) {
        if (MONITOR_BASE[m]) { mLow += MONITOR_BASE[m].send.low; mHigh += MONITOR_BASE[m].send.high; }
      });
      recvLiveSel.forEach(function(m) {
        if (MONITOR_BASE[m]) { mLow += MONITOR_BASE[m].recv.low; mHigh += MONITOR_BASE[m].recv.high; }
      });
      const mHoursLow  = Math.round(mLow);
      const mHoursHigh = Math.round(mHigh);
      mCostLow  = mHoursLow  * rate;
      mCostHigh = mHoursHigh * rate;

      if (rowMaint) {
        rowMaint.style.display = 'flex';
        document.getElementById('co-maint-low').textContent  = fmtShort(mCostLow);
        document.getElementById('co-maint-high').textContent = fmtShort(mCostHigh);
        document.getElementById('co-maint-hrs').textContent  = mHoursLow + ' - ' + mHoursHigh + 'h/yr';
      }
    } else {
      if (rowMaint) rowMaint.style.display = 'none';
    }

    // ---- HERO: YEAR 1 TOTAL ----
    const hasAny = sendNewSel.length > 0 || recvNewSel.length > 0 || sendLiveSel.length > 0 || recvLiveSel.length > 0;
    if (heroEl) heroEl.style.display = wizOutputReady ? 'block' : 'none';

    if (hasAny) {
      const y1Low  = costLow  + mCostLow;
      const y1High = costHigh + mCostHigh;
      document.getElementById('co-y1-low').textContent  = fmtShort(y1Low);
      document.getElementById('co-y1-high').textContent = fmtShort(y1High);

      const tagsEl = document.getElementById('co-hero-tags');
      const ERP_LABELS = {
        sap: 'SAP S/4HANA x1.5', oracle: 'Oracle Cloud x1.3', sage: 'Sage X3 x1.2',
        netsuite: 'NetSuite x1.0', dynamics: 'Dynamics 365 x1.0', other: 'Other ERP'
      };
      const tagStyle  = 'font-size:0.62rem;font-weight:600;color:rgba(255,255,255,0.72);background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:4px;padding:2px 7px;letter-spacing:0.05em;font-family:monospace;white-space:nowrap;';
      const warnStyle = 'font-size:0.62rem;font-weight:600;color:#fbbf24;background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3);border-radius:4px;padding:2px 7px;letter-spacing:0.05em;font-family:monospace;white-space:nowrap;cursor:pointer;animation:erp-warn-pulse 0.8s ease-in-out 3;';
      const tagHtmls = [];
      if (selectedERPs.length > 0) {
        if (isMultiERP) {
          tagHtmls.push('<span style="' + tagStyle + '">Multi-ERP x' + erpMult.toFixed(2) + '</span>');
        } else {
          const k = selectedERPs[0];
          if (ERP_LABELS[k]) tagHtmls.push('<span style="' + tagStyle + '">' + ERP_LABELS[k] + '</span>');
        }
      } else {
        tagHtmls.push('<span style=\"' + warnStyle + '\" onclick=\"wizUnlock(3);wizOpen(3);var el=document.getElementById(\'wstep-3\');if(el){el.scrollIntoView({behavior:\'smooth\',block:\'center\'});}\">' + 'Select ERP to refine estimate</span>');
      }
      const allCodes = new Set([...sendNewSel, ...recvNewSel, ...sendLiveSel, ...recvLiveSel]);
      tagHtmls.push('<span style="' + tagStyle + '">' + allCodes.size + (allCodes.size === 1 ? ' country' : ' countries') + '</span>');
      if (tagsEl) tagsEl.innerHTML = tagHtmls.join('');
    }
  }

  function toggleCheck(el) {
    var label = el.closest('.mandate-check');
    if (!label) return;
    if (el.checked) label.classList.add('checked');
    else label.classList.remove('checked');
  }

  function toggleRadioGroup(groupName) {
    document.querySelectorAll('input[name="calc-' + groupName + '"]').forEach(function(radio) {
      var label = radio.closest('.radio-option');
      if (radio.checked) label.classList.add('checked');
      else label.classList.remove('checked');
    });
  }

  // ── WIZARD ──────────────────────────────────────────────────────────────────
  var wizSelected = [];
  var wizOutputReady = false;

  function wizInit() {
    var grid = document.getElementById('country-sel-grid');
    if (!grid) return;
    var html = '';
    COUNTRIES_WIZ.forEach(function(c) {
      if (c.g) {
        html += '<div class="cs-group-head">' + c.g + '</div>';
      } else {
        html += '<div class="cs-row" id="csr-' + c.code + '" onclick="wizSelectCountry(\'' + c.code + '\')">'
          + '<span class="cs-flag">' + c.flag + '</span>'
          + '<span class="cs-name">' + c.name + '</span>'
          + '<div class="cs-tick" id="cstk-' + c.code + '"></div>'
          + '</div>';
      }
    });
    grid.innerHTML = html;
  }

  function wizSelectCountry(code) {
    var idx = wizSelected.indexOf(code);
    if (idx >= 0) wizSelected.splice(idx, 1);
    else wizSelected.push(code);
    var row = document.getElementById('csr-' + code);
    if (row) row.classList.toggle('selected', wizSelected.indexOf(code) >= 0);
    document.getElementById('ws1-next').disabled = wizSelected.length === 0;
    var s = document.getElementById('ws1-summary');
    if (s) s.textContent = wizSelected.length > 0 ? wizSelected.length + ' selected' : '';
  }

  function wizToggle(step) {
    var stepEl = document.getElementById('wstep-' + step);
    var body   = document.getElementById('ws' + step + '-body');
    if (!stepEl || !body || stepEl.classList.contains('locked')) return;
    var isOpen = stepEl.classList.contains('open');
    stepEl.classList.toggle('open', !isOpen);
    body.style.display = isOpen ? 'none' : 'block';
  }

  function wizUnlock(step) {
    var el = document.getElementById('wstep-' + step);
    if (el) el.classList.remove('locked');
  }

  function wizOpen(step) {
    var stepEl = document.getElementById('wstep-' + step);
    var body   = document.getElementById('ws' + step + '-body');
    if (stepEl) stepEl.classList.add('open');
    if (body)   body.style.display = 'block';
    if (stepEl) setTimeout(function(){
      stepEl.scrollIntoView({behavior:'smooth', block:'start'});
    }, 60);
  }

  function wizClose(step) {
    var stepEl = document.getElementById('wstep-' + step);
    var body   = document.getElementById('ws' + step + '-body');
    if (stepEl) stepEl.classList.remove('open');
    if (body)   body.style.display = 'none';
  }

  function wizNext(step) {
    if (step === 1) {
      buildCatList();
      wizClose(1);
      wizUnlock(2);
      wizOpen(2);
      var s1 = document.getElementById('ws1-summary');
      if (s1) s1.textContent = wizSelected.length + (wizSelected.length === 1 ? ' country' : ' countries');
    } else if (step === 2) {
      var incomplete = wizSelected.filter(function(code) {
        return document.querySelectorAll('#cat-list .cbtn[data-code="'+code+'"].on').length === 0;
      });
      if (incomplete.length > 0) {
        document.querySelectorAll('#cat-list .crow').forEach(function(crow) {
          var fb = crow.querySelector('.cbtn');
          if (fb && incomplete.indexOf(fb.dataset.code) >= 0) {
            crow.classList.remove('crow-warn');
            void crow.offsetWidth;
            crow.classList.add('crow-warn');
            setTimeout(function(){ crow.classList.remove('crow-warn'); }, 1800);
          }
        });
        return;
      }
      calcUpdate();
      wizClose(2);
      wizUnlock(3);
      wizOpen(3);
      var s2 = document.getElementById('ws2-summary');
      if (s2) s2.textContent = wizSelected.length + (wizSelected.length === 1 ? ' country' : ' countries');
    } else if (step === 3) {
      wizClose(3);
      wizUnlock(4);
      wizOpen(4);
      var erps = document.querySelectorAll('input[name="calc-erp"]:checked');
      var s3 = document.getElementById('ws3-summary');
      if (s3) s3.textContent = erps.length > 0 ? (erps.length === 1 ? erps[0].value : erps.length + ' ERPs') : 'Not specified';
    }
  }

  function buildCatList() {
    var list = document.getElementById('cat-list');
    if (!list) return;
    var metaMap = {};
    COUNTRIES_WIZ.forEach(function(c) { if (c.code) metaMap[c.code] = c; });

    list.innerHTML = '';
    wizSelected.forEach(function(code) {
      var m = metaMap[code];
      if (!m) return;
      var sLD = m.send_live ? '' : ' disabled';
      var rLD = m.recv_live ? '' : ' disabled';
      var row = document.createElement('div');
      row.className = 'crow';
      row.innerHTML =
          '<div class="cinfo">'
        + '<span class="cname">' + m.flag + ' ' + m.name + '</span>'
        + (m.sub ? '<span class="chint">' + m.sub + '</span>' : '')
        + '</div>'
        + '<div class="cdirs">'
        +   '<div class="cdir">'
        +     '<span class="cdir-lbl send-lbl">Sending obligation</span>'
        +     '<div class="cdir-btns">'
        +       '<button type="button" class="cbtn send-live" data-code="'+code+'" onclick="catToggle(this)"'+sLD+'>We are already live</button>'
        +       '<button type="button" class="cbtn send-new" data-code="'+code+'" onclick="catToggle(this)">We need to get ready</button>'
        +     '</div>'
        +   '</div>'
        +   '<div class="cdir">'
        +     '<span class="cdir-lbl recv-lbl">Receiving obligation</span>'
        +     '<div class="cdir-btns">'
        +       '<button type="button" class="cbtn recv-live" data-code="'+code+'" onclick="catToggle(this)"'+rLD+'>We are already live</button>'
        +       '<button type="button" class="cbtn recv-new" data-code="'+code+'" onclick="catToggle(this)">We need to get ready</button>'
        +     '</div>'
        +   '</div>'
        + '</div>';
      list.appendChild(row);
    });
  }

  function catToggle(btn) {
    var dirRow = btn.closest('.cdir');
    if (dirRow) { dirRow.querySelectorAll('.cbtn').forEach(function(b){ if(b!==btn) b.classList.remove('on'); }); }
    btn.classList.toggle('on');
    checkStep2Complete();
    calcUpdate();
  }

  function checkStep2Complete() {
    var btn = document.getElementById('ws2-next');
    if (btn) btn.disabled = false;
  }

  function wizShowOutput() {
    wizOutputReady = true;
    calcUpdate();
    var ph = document.getElementById('calc-placeholder');
    if (ph) ph.style.display = 'none';
    var cta = document.getElementById('calc-cta');
    if (cta) cta.style.display = 'block';
    var hero = document.getElementById('co-hero');
    if (hero) setTimeout(function(){
      hero.scrollIntoView({behavior:'smooth', block:'center'});
      hero.style.animation = 'none';
      void hero.offsetWidth;
      hero.style.animation = 'result-hum 0.9s ease-out 2';
      setTimeout(function(){ hero.style.animation = ''; }, 2000);
    }, 200);
  }

  function wizUpdateStep3() {
    var erps = document.querySelectorAll('input[name="calc-erp"]:checked');
    var s = document.getElementById('ws3-summary');
    if (!s) return;
    if (erps.length === 0) s.textContent = '';
    else if (erps.length === 1) { var v = erps[0].value; s.textContent = v.charAt(0).toUpperCase() + v.slice(1); }
    else s.textContent = erps.length + ' ERPs';
  }

  function wizUpdateStep4() {
    var rate = document.querySelector('input[name="calc-rate"]:checked');
    var s = document.getElementById('ws4-summary');
    if (s && rate) s.textContent = '\u20ac' + rate.value + '/h';
  }

  function togglePenalties() {
    const btn  = document.querySelector('#calc-comparison .penalty-chip');
    const body = document.getElementById('penalties-body');
    if (!btn || !body) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    body.style.display = isOpen ? 'none' : 'block';
  }

  function toggleMethodology() {
    const btn  = document.querySelector('.calc-methodology .meth-toggle');
    const body = document.getElementById('meth-body');
    if (!btn || !body) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    body.style.display = isOpen ? 'none' : 'block';
  }

  // Init
  wizInit();
  calcUpdate();

  /* ---- CONTACT FORM ---- */
  const cfForm = document.getElementById('contact-form');
  if (cfForm) {
    cfForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('cf-submit');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      const data = Object.fromEntries(new FormData(cfForm));
      try {
        const res = await fetch('https://formspree.io/f/xnjwvnvb', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.ok) {
          cfForm.style.display = 'none';
          document.getElementById('cf-success').style.display = 'block';
        } else {
          btn.disabled = false;
          btn.textContent = 'Send';
          alert('Something went wrong. Email jens@einvoiceops.eu directly.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Send';
        alert('Something went wrong. Email jens@einvoiceops.eu directly.');
      }
    });
  }
</script>

</body>
</html>
