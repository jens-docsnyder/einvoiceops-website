<!-- RANGE HOVER TOOLTIP -->
<div class="range-tooltip" id="range-tooltip"></div>

<script is:inline>
  /* ---- FAQ ---- */
  function toggleFaq(btn) {
    const item = btn.closest('.faq-item');
    item.classList.toggle('open');
  }

  /* ---- CALCULATOR ---- */

  // Base hours = readiness-only per mandate per entity
  // Low = 600h full impl × 45% readiness fraction; High = 900h × 45%
  // Source: Ardent Partners / Gartner 2024-26 lighter ERP benchmarks
  const MANDATE_BASE = {
    france:  { name: "France PDP",        low: 270, high: 405 },
    poland:  { name: "Poland KSeF",       low: 290, high: 430 },
    germany: { name: "Germany B2B",       low: 270, high: 405 },
    belgium: { name: "Belgium Peppol",    low: 200, high: 300 },
    romania: { name: "Romania e-Factura", low: 200, high: 300 }
  };

  // ERP multiplier and per-entity scaling by named ERP
  // NetSuite / Dynamics: 1.0x baseline — widely accepted, per SAPinsider / implementation patterns
  // Sage X3: 1.2x — directional estimate based on architecture complexity; no published benchmark
  // Oracle Cloud ERP: 1.3x — directional estimate; Forrester ERP Landscape Q1 2026 cites higher config complexity
  // SAP S/4HANA: 1.5x — supported by SAPinsider 2025 complexity benchmarks; Forrester ERP Landscape Q1 2026
  // Multi-ERP: avg mult + 17.5% coordination overhead — modelled on Hackett Group (18% higher IT ops in fragmented envs)
  const ERP_CONFIG = {
    netsuite:  { mult: 1.0, entityScale: 0.25 },
    dynamics:  { mult: 1.0, entityScale: 0.25 },
    sap:       { mult: 1.5, entityScale: 0.60 },
    oracle:    { mult: 1.3, entityScale: 0.50 },
    sage:      { mult: 1.2, entityScale: 0.30 },
    other:     { mult: 1.0, entityScale: 0.25 }
  };

  const MULTI_ERP_COORDINATION = 0.135; // 12-15% integration penalty for mixed ERP — IDC 2025 "SaaS ERP Multi-Cloud Complexity" (midpoint 13.5%)

  function entityFactor(n, erpKey) {
    if (n <= 1) return 1.0;
    const cfg = ERP_CONFIG[erpKey] || ERP_CONFIG.other;
    return 1.0 + (n - 1) * cfg.entityScale;
  }

  const SPRINT_PRICE = 24500;

  let _costLow = 0, _costHigh = 0, _scaleMax = 0;

  /* ---- HOVER TOOLTIP ON RANGE TRACK ---- */
  document.addEventListener('DOMContentLoaded', function() {
    const track   = document.getElementById('range-track-el');
    const tooltip = document.getElementById('range-tooltip');
    if (!track || !tooltip) return;
    track.addEventListener('mousemove', function(e) {
      if (!_scaleMax) return;
      const rect = track.getBoundingClientRect();
      const pct  = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const val  = pct * _scaleMax;
      tooltip.textContent    = fmtShort(val);
      tooltip.style.left     = e.clientX + 'px';
      tooltip.style.top      = e.clientY + 'px';
      tooltip.style.display  = 'block';
    });
    track.addEventListener('mouseleave', function() {
      tooltip.style.display = 'none';
    });

    /* ---- BANDEROLE RETIRE ---- */
    const title = document.querySelector('.range-viz-title');
    if (title) {
      title.addEventListener('animationend', function() {
        title.classList.add('banderole-done');
      });
    }
  });

  function fmt(n) {
    return '€' + Math.round(n).toLocaleString('de-DE');
  }

  function fmtShort(n) {
    if (n >= 1000000) return '€' + (n / 1000000).toFixed(1) + 'M';
    if (n >= 1000)    return '€' + Math.round(n / 1000) + 'K';
    return '€' + Math.round(n);
  }

  function updateRangeBar(costLow, costHigh, totalSprint) {
    const viz    = document.getElementById('range-viz');
    const band   = document.getElementById('range-band');
    const marker = document.getElementById('range-sprint-marker');
    const pip    = document.getElementById('sprint-marker-pip');

    // Scale: full track = costHigh * 2, so the team cost band always sits in the right half
    const scaleMax = costHigh * 2;
    _costLow  = costLow;
    _costHigh = costHigh;
    _scaleMax = scaleMax;

    viz.style.display = 'block';

    // Inner band: positioned at costLow..costHigh on the scale
    const bandLeftPct  = (costLow  / scaleMax) * 100;
    const bandWidthPct = ((costHigh - costLow) / scaleMax) * 100;
    band.style.left  = bandLeftPct + '%';
    band.style.width = bandWidthPct + '%';

    // Sprint marker: positioned at totalSprint on the same scale (left of band in typical cases)
    const sprintPct = Math.max(2, Math.min(96, (totalSprint / scaleMax) * 100));
    marker.style.left = sprintPct + '%';
    pip.textContent   = fmtShort(totalSprint);

    // Position point labels under band edges
    const lblLowEl  = document.getElementById('lbl-low-pos');
    const lblHighEl = document.getElementById('lbl-high-pos');
    const lblLow    = document.getElementById('range-label-low');
    const lblHigh   = document.getElementById('range-label-high');

    if (lblLowEl)  lblLowEl.style.left  = bandLeftPct + '%';
    if (lblHighEl) lblHighEl.style.left = (bandLeftPct + bandWidthPct) + '%';
    if (lblLow)    lblLow.textContent   = fmtShort(costLow);
    if (lblHigh)   lblHigh.textContent  = fmtShort(costHigh);
  }

  function calcUpdate() {
    const entities = parseInt(document.getElementById('calc-countries').value);
    document.getElementById('countries-display').textContent = entities + (entities >= 10 ? '+' : '');

    // Multi-ERP model: average multiplier across selected ERPs + 17.5% coordination overhead
    // Formula: Total = Σ(effort × ERP_i_mult / n_erps) × (1 + coordination) — Forrester TEI Q1 2026
    // Single ERP: straight multiplier, no coordination overhead
    const selectedERPs = [...document.querySelectorAll('input[name="calc-erp"]:checked')].map(i => i.value);
    const isMultiERP = selectedERPs.length > 1;
    const avgMult = selectedERPs.length > 0
      ? selectedERPs.reduce((sum, key) => sum + (ERP_CONFIG[key]?.mult || 1), 0) / selectedERPs.length
      : 1.0;
    const erpMult = isMultiERP ? avgMult * (1 + MULTI_ERP_COORDINATION) : avgMult;
    // Entity scaling: use worst-case ERP among selected
    const erpKey = selectedERPs.length > 0
      ? selectedERPs.reduce((best, key) =>
          (ERP_CONFIG[key]?.entityScale || 0.25) > (ERP_CONFIG[best]?.entityScale || 0.25) ? key : best
        , selectedERPs[0])
      : 'other';
    const rateEl  = document.querySelector('input[name="calc-rate"]:checked');
    const rate    = rateEl ? parseInt(rateEl.value) : 85;

    const selected = [...document.querySelectorAll('input[name="calc-mandate"]:checked')].map(i => i.value);

    const hoursEl     = document.getElementById('out-hours');
    const hoursNote   = document.getElementById('out-hours-note');
    const rangePills  = document.getElementById('out-range-pills');
    const scopeInt    = document.getElementById('out-scope-internal');
    const savingBadge = document.getElementById('saving-badge');
    const sprintLabel = document.getElementById('sprint-label');
    const sprintPriceEl = document.getElementById('sprint-price-display');
    const sprintNote  = document.getElementById('sprint-note');
    const penaltyRow        = document.getElementById('penalty-row');
    const penaltyVal        = document.getElementById('penalty-value');
    const polandPenaltyRow  = document.getElementById('poland-penalty-row');
    const germanyPenaltyRow = document.getElementById('germany-penalty-row');

    if (selected.length === 0) {
      hoursEl.textContent    = '—';
      hoursNote.textContent  = 'Select a mandate above';
      rangePills.innerHTML   = '';
      scopeInt.textContent   = '—';
      savingBadge.style.display    = 'none';
      const sh = document.getElementById('saving-hero');
      sh.style.display = 'none';
      document.getElementById('saving-hero-divider').style.display     = 'none';
      document.getElementById('saving-hero-annual-block').style.display = 'none';
      penaltyRow.style.display     = 'none';
      polandPenaltyRow.style.display  = 'none';
      germanyPenaltyRow.style.display = 'none';
      document.getElementById('range-viz').style.display = 'none';
      sprintNote.textContent = '';
      sprintPriceEl.textContent = '€24,500';
      return;
    }

    const eFactor = entityFactor(entities, erpKey);

    let totalLow = 0, totalHigh = 0;
    selected.forEach(m => {
      totalLow  += MANDATE_BASE[m].low;
      totalHigh += MANDATE_BASE[m].high;
    });

    const hoursLow  = Math.round(totalLow  * erpMult * eFactor);
    const hoursHigh = Math.round(totalHigh * erpMult * eFactor);
    const hoursMid  = Math.round((hoursLow + hoursHigh) / 2);

    const costLow  = hoursLow  * rate;
    const costHigh = hoursHigh * rate;
    const costMid  = hoursMid  * rate;

    const nSprints    = selected.length;
    const totalSprint = nSprints * SPRINT_PRICE;
    const savingLow   = costLow  - totalSprint;
    const savingHigh  = costHigh - totalSprint;

    hoursEl.textContent   = hoursLow.toLocaleString('de-DE') + ' – ' + hoursHigh.toLocaleString('de-DE') + 'h';
    hoursNote.textContent = selected.length + ' mandate' + (selected.length > 1 ? 's' : '') +
      ' · ' + entities + ' entit' + (entities > 1 ? 'ies' : 'y') + ' · readiness overhead only';

    rangePills.innerHTML =
      '<span style="font-size:0.72rem;background:var(--ice);color:var(--accent);border:1px solid #bfdbfe;padding:3px 10px;border-radius:100px;font-weight:600">Structured team: ' + hoursLow.toLocaleString('de-DE') + 'h</span>' +
      '<span style="font-size:0.72rem;background:#fffde7;color:#7c5000;border:1px solid #ffe082;padding:3px 10px;border-radius:100px;font-weight:600">Ad-hoc / reactive: ' + hoursHigh.toLocaleString('de-DE') + 'h</span>';

    updateRangeBar(costLow, costHigh, totalSprint);

    const countryShort = { france: 'France', poland: 'Poland', germany: 'Germany', belgium: 'Belgium', romania: 'Romania' };
    const selectedNames = selected.map(m => countryShort[m]);
    const headCountry = selectedNames.length <= 3
      ? selectedNames.join(' + ')
      : selectedNames.slice(0, 2).join(' + ') + ' +' + (selectedNames.length - 2) + ' more';

    scopeInt.textContent = fmt(costMid) + ' (typical midpoint)';

    sprintLabel.textContent = nSprints > 1
      ? nSprints + ' × Readiness Sprint (fixed fee)'
      : 'Readiness Sprint (fixed fee)';
    sprintPriceEl.textContent = fmt(totalSprint);

    // Saving hero — large, right under the graph
    const savingHero    = document.getElementById('saving-hero');
    const savingHeroAmt = document.getElementById('saving-hero-amount');
    const savingHeroSub = document.getElementById('saving-hero-sub');
    const savingHeroDivider     = document.getElementById('saving-hero-divider');
    const savingHeroAnnualBlock = document.getElementById('saving-hero-annual-block');
    const savingHeroAnnualAmt   = document.getElementById('saving-hero-annual-amount');
    const savingHeroAnnualSub   = document.getElementById('saving-hero-annual-sub');

    if (savingLow > 0) {
      savingHero.style.display  = 'block';
      savingHeroAmt.textContent = fmt(savingLow) + ' – ' + fmt(savingHigh);
      savingHeroSub.textContent = 'compared to your team handling this internally (' + headCountry + ')';
    } else if (savingHigh > 0) {
      savingHero.style.display  = 'block';
      savingHeroAmt.textContent = 'up to ' + fmt(savingHigh);
      savingHeroSub.textContent = 'potential saving in reactive scenarios (' + headCountry + ')';
    } else {
      savingHero.style.display = 'none';
    }

    // Annual mandate burden — Vertex Q4 2025: 11 events across 6 EU countries in one quarter
    // Weighted by event type: go-lives ~100% effort, schema updates ~40%, legislative tuning ~20%
    // Range: 2.5–3.5 full-mandate equivalents per year for a 4-6 country footprint
    if (nSprints > 0 && savingHero.style.display !== 'none') {
      const perMandateLow  = costLow  / nSprints;
      const perMandateHigh = costHigh / nSprints;
      const annualLow  = Math.round(perMandateLow  * 2.5);
      const annualHigh = Math.round(perMandateHigh * 3.5);
      savingHeroDivider.style.display     = 'block';
      savingHeroAnnualBlock.style.display = 'block';
      savingHeroAnnualAmt.textContent     = fmt(annualLow) + ' – ' + fmt(annualHigh) + '/year';
      savingHeroAnnualSub.textContent     = '4–7 mandate change events/year (Vertex Q4 2025: 11 events across 6 EU countries in one quarter) · ' +
        'weighted for event type: go-lives, schema updates, legislative tuning · based on your rate and ERP inputs';
    } else {
      savingHeroDivider.style.display     = 'none';
      savingHeroAnnualBlock.style.display = 'none';
    }

    savingBadge.style.display = 'none';

    sprintNote.textContent = isMultiERP
      ? 'Mixed ERP environment — estimate uses average multiplier across selected ERPs plus 13.5% integration overhead (IDC 2025). Actual cost depends on which entities run which system.'
      : nSprints > 1
        ? 'Pricing assumes one entity per mandate. For multi-entity engagements, contact us for a proposal.'
        : '';

    // France: €50/invoice capped at €15,000/year/entity (2026 Budget Law, confirmed Feb 2026)
    // Previously €15 — increased by 2026 Finance Act. Source: dynatos.com / vatcalc.com
    if (selected.includes('france')) {
      penaltyRow.style.display = 'flex';
      penaltyVal.textContent   = fmt(15000 * entities) + '/year';
    } else {
      penaltyRow.style.display = 'none';
    }

    // Poland: 100% of VAT per invoice, no cap (Art. 106ni VAT Act, post Jan 2027)
    polandPenaltyRow.style.display = selected.includes('poland') ? 'flex' : 'none';

    // Germany: €5K/invoice + €30K GoBD archiving (§26a UStG + BMF March 2026)
    germanyPenaltyRow.style.display = selected.includes('germany') ? 'flex' : 'none';
  }

  function toggleCheck(el) {
    const label = el.closest('.mandate-check');
    if (el.checked) label.classList.add('checked');
    else label.classList.remove('checked');
  }

  function toggleRadioGroup(groupName) {
    document.querySelectorAll('input[name="calc-' + groupName + '"]').forEach(radio => {
      const label = radio.closest('.radio-option');
      if (radio.checked) label.classList.add('checked');
      else label.classList.remove('checked');
    });
  }

  function toggleMethodology() {
    const btn  = document.querySelector('.meth-toggle');
    const body = document.getElementById('meth-body');
    if (!btn || !body) return;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    body.style.display = isOpen ? 'none' : 'block';
  }

  // Init
  calcUpdate();
</script>

</body>
</html>
