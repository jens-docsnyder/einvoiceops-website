---
// The home page (Website - page and site structure.md, part 2, "The home page under this standard"): the opening, the
// country pages as cards with their live counts, the six functions, starting and the limits, the countries again.
// The countries and their order come from src/data/countries.ts and each count from that country's fan-out file, counted
// exactly as the country page's proof strip counts it (publications() in format.ts), so the two never disagree.
// "Get in touch" and "Get started" go to the contact form at the foot of the page, the same form the country pages carry.
import Site from '../layouts/Site.astro';
import StartAndLimits from '../components/site/StartAndLimits.astro';
import ContactForm from '../components/site/ContactForm.astro';
import { countryPages, countryNav } from '../data/countries';
import { publications, longDate, withBodies } from '../components/site/format';
import { deBodies } from '../data/stories/de';
import { beBodies } from '../data/stories/be';
import fr from '../data/fanout/FR.json';
import de from '../data/fanout/DE.json';
import be from '../data/fanout/BE.json';

// Each file gets the same issuing-body fallback its country page gives it, so the two counts can never disagree.
const fanouts: Record<string, any> = {
  FR: withBodies(fr, {}, 'Home page: FR.json'),
  DE: withBodies(de, deBodies, 'Home page: DE.json'),
  BE: withBodies(be, beBodies, 'Home page: BE.json'),
};
const cards = countryPages.map((c) => {
  const d = fanouts[c.cc];
  const pubs = publications(d);
  if (!pubs) throw new Error(`Home page: ${c.cc}.json, the changes list does not agree with the released total`);
  return { ...c, changes: pubs.length, since: longDate(d.since), weekly: d.sources_weekly };
});

const names = countryPages.map((c) => c.name);
const listed = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names[0];

const functions = ['Outbound invoicing', 'Inbound invoicing', 'Connectivity', 'Tax engine', 'Master data', 'Archiving'];

// Starting and the limits: the country pages' onboarding steps word for word; the price per country, because the home page
// speaks for all of them; the limits as the country pages say them, without a country's source count.
const start = {
  h2: `We keep your invoicing teams up to date. Free onboarding, then €450 a month for each country.`,
  steps: [
    { text: `After your first message, we send you a form, about an hour's work, where you tell us who looks after each of your invoicing functions.` },
    { text: `We then have a short call with whoever signs off on your side, so they know what each person will hear from us and what we don't do.` },
    { text: `When we find a change, each person it affects hears from us what to check or prepare, and where it says so. We keep a record of each change we find and who we sent it to, so it never rests on one person remembering.` },
  ],
  cta: `Get started`,
};
const limits = {
  h2: `What we don't do`,
  lines: [
    { lead: `Give legal or tax advice.`, text: `What we send is our reading of what a change means for your invoicing, with the source beside it so you can check it.` },
    { lead: `Look beyond our sources.`, text: `For each country we read a fixed list of sources every week, and we tell you about the changes we find there and nowhere else.` },
    { lead: `Decide for you.`, text: `What to do about a change, and when, stays with you and the people who look after your invoicing.` },
  ],
};
// The contact form, as on the country pages: the start button lands here, so the heading names it.
const contact = {
  h2: `Get started, or tell us how you keep up today`,
  name: `Name and company`,
  email: `Email`,
  message: `Your message`,
  send: `Send message`,
  mailto: `jens@einvoiceops.eu`,
  hint: `Tell us who looks after your invoicing today, and whether that's one person, several, or a team for each function.`,
  person: {
    name: `Jens Anttila`,
    email: `jens@einvoiceops.eu`,
    photo: `/jens-anttila.jpg`,
    linkedin: `https://www.linkedin.com/in/jens-anttila/`,
  },
  done: `Thank you, your message has reached Jens. He will answer by email.`,
};
const t = (v: string) => v;
---
<Site
  title="einvoiceops | Changes to e-invoicing rules, sent to the people they affect"
  description={`We keep track of the e-invoicing rules in ${listed}, and when we find a change, we email the person who looks after the part of your invoicing it affects, with what changed for them and where it says so.`}
  countries={countryNav()}
  contact="#contact"
>
  <section class="band band-white home-open">
    <div class="wrap">
      <h1 class="home-h1">Go-live was the start, not the finish.</h1>
      <p class="home-sub">We keep track of the e-invoicing rules in {listed}, and when we find a change, we email the person who looks after the part of your invoicing it affects, with what changed for them and where it says so.</p>
    </div>
  </section>

  <section class="band band-tint band-ruled home-countries" id="countries">
    <div class="wrap">
      <h2 class="band-h home-h2">Find the country where you run your invoicing</h2>
      <ul class="cards">
        {cards.map((c) => (
          <li>
            <a class="card" href={c.href}>
              <span class="card-name">{c.name}</span>
              <span class="card-n">{c.changes}</span>
              <span class="card-l">changes we've counted since {c.since}</span>
              <span class="card-w">{c.weekly} sources we read every week</span>
              <span class="card-go">Read about {c.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-white home-fns">
    <div class="wrap">
      <h2 class="band-h home-h2">A change can touch one part of your invoicing or several</h2>
      <p class="home-fns-p">Whoever looks after each part a change touches hears from us about their own part, so nobody has to follow the change across all six.</p>
      <ul class="tiles">
        {functions.map((n) => <li class="tile">{n}</li>)}
      </ul>
    </div>
  </section>

  <StartAndLimits start={start} limits={limits} tone="tint" ctaHref="#contact" t={t} />

  <section class="band band-white home-close">
    <div class="wrap">
      <h2 class="band-h home-h2">Read what changed in your country</h2>
      <ul class="close-links">
        {countryPages.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
      </ul>
    </div>
  </section>

  <ContactForm copy={contact} page="home" segment="" country="" tone="tint" person={contact.person} t={t} />
</Site>

<style is:global>
  .home-open { padding: 64px 0 52px; }
  .home-h1 { max-width: 20ch; font-size: clamp(2.2rem, 5.4vw, 3.4rem); }
  .home-sub { max-width: 62ch; margin: 22px 0 0; font-size: 1.14rem; line-height: 1.5; font-weight: 500; }
  .home-h2 { max-width: 34ch; }

  .home-countries { padding: 44px 0 48px; }
  .cards { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .card { display: flex; flex-direction: column; height: 100%; background: var(--page); border: 1px solid var(--box-border); border-top: 3px solid var(--ink); padding: 22px 24px 20px; color: var(--ink); text-decoration: none; }
  .card:hover { border-color: var(--ink); text-decoration: none; }
  .card:hover .card-go { text-decoration-color: var(--accent); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card-name { font-family: var(--serif); font-size: 1.6rem; line-height: 1.2; font-weight: 700; margin-bottom: 18px; }
  .card-n { font-family: var(--serif); font-size: 3rem; line-height: 1; }
  .card-l { margin-top: 6px; font-weight: 600; }
  .card-w { margin-top: 4px; font-size: 0.95rem; color: var(--quiet); }
  .card-go { margin-top: auto; padding-top: 20px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--hairline); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }

  .home-fns-p { max-width: 62ch; margin: 14px 0 0; }
  .tiles { list-style: none; margin: 24px 0 8px; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .tile { background: var(--tint); border: 1px solid var(--box-border); border-top: 3px solid var(--ink); padding: 14px 12px; min-height: 64px; display: flex; align-items: center; font-weight: 600; font-size: 0.95rem; line-height: 1.3; }

  .close-links { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 12px; }
  .close-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid var(--ink); border-radius: 2px; text-decoration: none; font-weight: 600; }
  .close-links a:hover { background: var(--ink); color: #ffffff; }

  @media (max-width: 899px) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cards { gap: 16px; }
  }
  @media (max-width: 759px) {
    .home-open { padding: 36px 0 32px; }
    .home-sub { font-size: 1.02rem; }
    .cards { display: block; }
    .cards li { margin-bottom: 14px; }
    .card-n { font-size: 2.4rem; }
  }
  @media (max-width: 519px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
