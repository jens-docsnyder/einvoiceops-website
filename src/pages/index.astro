<script is:inline define:vars={{ homeCountryMap, mapCdata }}>
  (function() {
    var PATH_MAP = {
      path7015:'DE', path7031:'IT', path7041:'FR', path7019:'BE',
      path7017:'NL', path7039:'DK', path7021:'DK', path6999:'PL',
      path8142:'RO', path7033:'SE', path7029:'NO', path7025:'FI',
      path7043:'ES', path2122:'IE', path7013:'LU', path7009:'AT',
      path7011:'CH', path8303:'CZ', path8140:'SI', path8156:'HR',
      path8148:'HU', path8164:'SK', path7003:'LT', path7005:'LV',
      path7007:'EE', path8150:'BG', path7035:'PT', path8136:'GR'
    };

    function fmtD(d) {
      if (!d) return '—';
      return new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function getBadge(c) {
      if (c.b2b === 'mandatory') return '<span class="mec-badge mec-badge-live">B2B Live</span>';
      if (c.b2b === 'announced')  return '<span class="mec-badge mec-badge-announced">B2B Announced</span>';
      if (c.b2b === 'voluntary')  return '<span class="mec-badge mec-badge-partial">B2B Voluntary</span>';
      if (c.b2b === 'not-yet')    return '<span class="mec-badge mec-badge-partial">B2G Live &ndash; B2B Pending</span>';
      return '<span class="mec-badge mec-badge-none">B2G Only</span>';
    }

    function showCountry(cc) {
      var c = mapCdata[cc];
      if (!c) return;

      document.querySelectorAll('#home-eu-map path.hm-selected').forEach(function(p) { p.classList.remove('hm-selected'); });
      Object.keys(PATH_MAP).forEach(function(pid) {
        if (PATH_MAP[pid] === cc) { var el = document.getElementById(pid); if (el) el.classList.add('hm-selected'); }
      });
      document.querySelectorAll('.map-embed-btn').forEach(function(b) { b.classList.toggle('selected', b.dataset.cc === cc); });

      var dlHtml = c.deadlines.length
        ? c.deadlines.map(function(dl) { return '<div class="mec-dl-item"><div class="mec-dl-date">' + fmtD(dl[0]) + '</div><div class="mec-dl-desc">' + dl[1] + '</div></div>'; }).join('')
        : '<div class="mec-dl-item"><div class="mec-dl-desc" style="color:#334155">No upcoming deadlines logged.</div></div>';

      var fmtTags = c.formats.map(function(f) { return '<span class="mec-tag">' + f + '</span>'; }).join('');
      var platHtml = c.platform ? '<div class="mec-sec"><div class="mec-sec-label">Platform</div><div class="mec-tag-row"><span class="mec-tag mec-platform-tag">' + c.platform + '</span></div></div>' : '';
      var penaltyHtml = c.penalty ? '<div class="mec-penalty"><div class="label">Penalties</div><p>' + c.penalty + '</p></div>' : '';
      var futureHtml = c.future ? '<div class="mec-future"><div class="label">Direction</div><p>' + c.future + '</p></div>' : '';
      var confLabel = c.confidence === 'green'
        ? '<span class="mec-conf-dot green"></span><span class="mec-conf-text">GREEN &mdash; source-verified</span>'
        : c.confidence === 'red'
        ? '<span class="mec-conf-dot red"></span><span class="mec-conf-text">RED &mdash; review required</span>'
        : '<span class="mec-conf-dot amber"></span><span class="mec-conf-text">AMBER &mdash; cross-referenced, primary click pending</span>';

      document.getElementById('map-embed-empty').style.display = 'none';
      var panel = document.getElementById('map-embed-panel');
      panel.style.display = 'block';
      panel.innerHTML =
        '<div class="mec-header">' +
          '<div class="mec-flag">' + c.flag + '</div>' +
          '<div class="mec-title"><h2>' + c.name + '</h2><div class="code">' + cc + ' &bull; ' + c.mandate_type + '</div></div>' +
          '<a class="mec-full-btn" href="/map/' + cc + '/" target="_blank">See full country profile</a>' +
        '</div>' +
        getBadge(c) +
        '<div class="mec-dates">' +
          '<div class="mec-date-box"><div class="label">Receiving obligation</div><div class="val">' + fmtD(c.inbound) + '</div><div class="sub">When you must accept compliant e-invoices</div></div>' +
          '<div class="mec-date-box"><div class="label">Sending obligation</div><div class="val">' + fmtD(c.outbound) + '</div>' + (c.outbound2 ? '<div class="phase2">Phase 2: ' + fmtD(c.outbound2) + '</div>' : '') + '<div class="sub">When you must issue compliant e-invoices</div></div>' +
        '</div>' +
        '<div class="mec-sec"><div class="mec-sec-label">Formats</div><div class="mec-tag-row">' + fmtTags + '</div></div>' +
        platHtml +
        '<div class="mec-sec"><div class="mec-sec-label">Transport</div><div class="mec-tag-row"><span class="mec-tag">' + c.transport + '</span></div></div>' +
        '<div class="mec-sec"><div class="mec-sec-label">All key deadlines</div>' + dlHtml + '</div>' +
        '<div class="mec-sec"><div class="mec-sec-label">Operational details</div>' +
          '<div class="mec-info-row"><div class="mec-info-label">Master data ID</div><div class="mec-info-val">' + c.master_data + '</div></div>' +
          '<div class="mec-info-row"><div class="mec-info-label">Archiving</div><div class="mec-info-val">' + c.archiving + ' years</div></div>' +
          (c.cius ? '<div class="mec-info-row"><div class="mec-info-label">CIUS</div><div class="mec-info-val">' + c.cius + '</div></div>' : '') +
        '</div>' +
        penaltyHtml + futureHtml +
        '<div class="mec-conf-row">' + confLabel + '</div>';

      document.querySelector('.map-embed-right').scrollTop = 0;
    }

    function showSources() {
      document.querySelectorAll('#home-eu-map path.hm-selected').forEach(function(p) { p.classList.remove('hm-selected'); });
      document.querySelectorAll('.map-embed-btn').forEach(function(b) { b.classList.remove('selected'); });
      document.getElementById('sources-panel-btn').classList.add('selected');

      document.getElementById('map-embed-empty').style.display = 'none';
      var panel = document.getElementById('map-embed-panel');
      panel.style.display = 'block';

      var inner  = document.getElementById('sources-inner-content');
      var footer = document.getElementById('sources-footer-content');
      panel.innerHTML =
        '<div class="src-panel-wrap">' +
          '<div class="src-panel-title">Primary sources</div>' +
          (inner  ? inner.innerHTML  : '') +
          (footer ? '<div class="src-panel-footer">' + footer.textContent + '</div>' : '') +
        '</div>';

      document.querySelector('.map-embed-right').scrollTop = 0;
    }

    function initMap() {
      Object.keys(PATH_MAP).forEach(function(pid) {
        var cc = PATH_MAP[pid];
        var el = document.getElementById(pid);
        if (!el) return;
        var c = homeCountryMap[cc];
        if (c) {
          el.style.fill = c.color;
          el.classList.add('hm-click');
          el.addEventListener('click', function() { showCountry(cc); });
        }
      });
      document.querySelectorAll('.map-embed-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { showCountry(btn.dataset.cc); });
      });
      // Pre-select from hash (e.g. /#map + ?country=DE handled via hash)
      var hash = location.hash.replace('#', '').toUpperCase();
      if (hash && mapCdata[hash]) showCountry(hash);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }

    window.showSources = showSources;
  })();
</script>


<style is:global>
  /* ── WIZARD STEPS ── */
  .wiz-step { border: 1.5px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 8px; background: #fff; transition: border-color 0.18s, box-shadow 0.18s; scroll-margin-top: 72px; }
  .wiz-step.open { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.07); }
  .wiz-step.locked { opacity: 0.36; pointer-events: none; }

  .wiz-header { width: 100%; background: none; border: none; cursor: pointer; padding: 14px 18px; display: flex; align-items: center; gap: 12px; font-family: inherit; text-align: left; }
  .wiz-step:not(.locked) .wiz-header:hover { background: #f8fafc; }

  .wiz-num { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #94a3b8; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 3px 8px; flex-shrink: 0; white-space: nowrap; transition: background 0.18s, color 0.18s; }
  .wiz-step.open .wiz-num { background: #2563eb; color: #fff; border-color: #2563eb; }

  .wiz-title { font-size: 0.875rem; font-weight: 700; color: #0f172a; flex: 1; min-width: 0; line-height: 1.3; }
  .wiz-step.locked .wiz-title { color: #94a3b8; }

  .wiz-summary { font-size: 0.7rem; color: #2563eb; font-weight: 600; white-space: nowrap; }
  .wiz-chevron { font-size: 0.6rem; color: #94a3b8; transition: transform 0.2s; flex-shrink: 0; margin-left: 2px; }
  .wiz-step.open .wiz-chevron { transform: rotate(180deg); }

  .wiz-body { padding: 12px 16px 16px; border-top: 1px solid #e2e8f0; }

  .wiz-next { margin-top: 18px; width: 100%; padding: 11px 16px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-size: 0.875rem; font-weight: 700; font-family: inherit; cursor: pointer; transition: background 0.12s, opacity 0.12s; letter-spacing: -0.01em; }
  .wiz-next:hover:not([disabled]) { background: #1d4ed8; }
  .wiz-next[disabled] { opacity: 0.28; cursor: not-allowed; }

  /* ── Step 1: country selector grid ── */
  .country-sel-grid { margin-top: 10px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }

  .cs-group-head { grid-column: 1 / -1; font-size: 0.57rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; color: #94a3b8; padding: 8px 0 3px; border-top: 1px solid #e2e8f0; margin-top: 2px; }
  .cs-group-head:first-child { border-top: none; margin-top: 0; padding-top: 0; }

  .cs-row { display: flex; align-items: center; gap: 5px; padding: 6px 7px; border-radius: 7px; border: 1.5px solid #e2e8f0; cursor: pointer; transition: border-color 0.12s, background 0.12s; user-select: none; }
  .cs-row:hover { border-color: #93c5fd; background: #f0f6ff; }
  .cs-row.selected { border-color: #2563eb; background: #eff6ff; }

