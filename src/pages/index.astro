  // ERP multiplier and per-entity scaling by named ERP
  // NetSuite / Dynamics: 1.0x baseline - widely accepted, per SAPinsider / implementation patterns
  // Sage X3: 1.2x - directional estimate based on architecture complexity; no published benchmark
  // Oracle Cloud ERP: 1.3x - directional estimate; Forrester ERP Landscape Q1 2026 cites higher config complexity
  // SAP S/4HANA: 1.5x - supported by SAPinsider 2025 complexity benchmarks; Forrester ERP Landscape Q1 2026
  // Multi-ERP: avg mult + 17.5% coordination overhead - modelled on Hackett Group (18% higher IT ops in fragmented envs)
  const ERP_CONFIG = {
    netsuite:  { mult: 1.0, entityScale: 0.15 },
    dynamics:  { mult: 1.0, entityScale: 0.15 },
    sap:       { mult: 1.5, entityScale: 0.60 },
    oracle:    { mult: 1.3, entityScale: 0.40 },
    sage:      { mult: 1.2, entityScale: 0.25 },
    other:     { mult: 1.0, entityScale: 0.15 }
  };

  const MULTI_ERP_COORDINATION = 0.135; // 12-15% integration penalty for mixed ERP - IDC 2025 "SaaS ERP Multi-Cloud Complexity" (midpoint 13.5%)

  // send_live: outbound mandate currently active | recv_live: inbound mandate currently active + B2B required
  const COUNTRIES_WIZ = [
