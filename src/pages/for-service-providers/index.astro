<script>
  (function () {
    var cards = [
      { el: document.getElementById('sp2-fs'),  delay: 200 },
      { el: document.getElementById('sp2-tax'), delay: 550 },
      { el: document.getElementById('sp2-it'),  delay: 900 },
    ];
    var started = false;
    var svg = document.getElementById('sp-sprint-svg');
    if (svg) {
      function slideIn(el, delay) {
        setTimeout(function() {
          el.setAttribute('opacity', '1');
          el.setAttribute('transform', 'translate(0,0)');
          el.style.transition = 'transform 0.6s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease';
        }, delay);
      }
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && !started) {
          started = true;
          cards.forEach(function(c) { slideIn(c.el, c.delay); });
        }
      }, { threshold: 0.3 });
      obs.observe(svg);
    }

    document.querySelectorAll('.scenario-flipcard').forEach(function(card) {
      card.addEventListener('click', function() { card.classList.toggle('flipped'); });
    });

    var btn = document.getElementById('nav-hamburger');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    function closeMenu() {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', function() {
      var opening = !menu.classList.contains('open');
      if (opening) { btn.classList.add('open'); menu.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
      else closeMenu();
    });
    menu.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMenu); });
    document.addEventListener('click', function(e) {
      if (!btn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
  })();
</script>

