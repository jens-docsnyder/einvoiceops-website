---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>For Finance Platform Service Providers | einvoiceops</title>
  <meta name="description" content="Mandate readiness content for AP automation platforms and Peppol access points. White-label delivery - your customers get the operational preparation layer your platform does not cover, under your brand." />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:        #1a2b3c;
      --navy-soft:   #243447;
      --accent:      #2563eb;
      --accent-dark: #1d4ed8;
      --accent-glow: rgba(37,99,235,0.12);
      --text:        #111827;
      --sub:         #374151;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --bg:          #ffffff;
      --bg-alt:      #f8f9fa;
      --ice:         #eff6ff;
      --teal:        #0f766e;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); color: var(--text); background: var(--bg); line-height: 1.6; font-size: 16px; -webkit-font-smoothing: antialiased; }

    /* Nav */
    nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); padding: 0 2rem; height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
    .logo { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.03em; color: var(--navy); text-decoration: none; white-space: nowrap; }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a { font-size: 0.875rem; color: var(--muted); text-decoration: none; font-weight: 500; transition: color 0.15s; }
    .nav-links a:hover { color: var(--text); }
    nav a.btn-nav { font-size: 0.875rem; font-weight: 600; color: var(--bg); background: var(--accent); text-decoration: none; padding: 8px 18px; border-radius: 4px; transition: background 0.15s; }
    nav a.btn-nav:hover { background: var(--accent-dark); }
    .hamburger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 36px; height: 36px; background: none; border: none; cursor: pointer; padding: 4px; border-radius: 6px; transition: background 0.15s; }
    .hamburger:hover { background: rgba(0,0,0,0.06); }
    .hamburger span { display: block; width: 22px; height: 2px; background: var(--navy); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; transform-origin: center; }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu { display: none; position: fixed; top: 60px; left: 0; right: 0; background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); z-index: 99; flex-direction: column; padding: 1rem 1.5rem 1.5rem; }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { font-size: 1rem; font-weight: 500; color: var(--text); text-decoration: none; padding: 0.75rem 0; border-bottom: 1px solid var(--border); }
    .mobile-menu a:last-child { border-bottom: none; padding-bottom: 0; }
    .mobile-menu a:hover { color: var(--accent); }
    @media (max-width: 600px) { .nav-links .hide-mobile { display: none; } .hamburger { display: flex; } }

    /* Hero */
    .sp-hero { background: var(--navy); color: white; padding: 80px 2rem 72px; }
    .hero-inner { max-width: 820px; margin: 0 auto; }
    .sp-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #60a5fa; margin-bottom: 24px; }
    .sp-eyebrow span { width: 28px; height: 1px; background: #60a5fa; display: inline-block; }
    .sp-hero h1 { font-size: clamp(1.75rem, 3.8vw, 2.65rem); font-weight: 800; letter-spacing: -0.03em; color: #f9fafb; line-height: 1.15; margin-bottom: 22px; max-width: 720px; }
    .sp-hero h1 em { font-style: normal; color: #60a5fa; }
    .sp-hero p { font-size: 1rem; color: #9ca3af; max-width: 600px; line-height: 1.75; margin-bottom: 32px; }
    .btn-primary { display: inline-block; font-size: 0.95rem; font-weight: 700; text-decoration: none; padding: 13px 26px; border-radius: 4px; background: var(--accent); color: #fff; transition: background 0.15s; letter-spacing: 0.02em; }
    .btn-primary:hover { background: var(--accent-dark); }

    /* Layout */
    .inner { max-width: 960px; margin: 0 auto; padding: 0 2rem; }
    .section { padding: 88px 2rem; }
    .section.bg-alt { background: var(--bg-alt); }

    /* Eyebrows */
    .eyebrow-pill { display: inline-flex; align-items: center; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); background: var(--ice); border: 1px solid #bfdbfe; padding: 5px 14px; border-radius: 100px; margin-bottom: 20px; }
    .eyebrow-light { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #60a5fa; margin-bottom: 12px; display: block; }

    /* Section h2 */
    .sec-h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px; }
    .sec-h2-dark { color: var(--navy); }
    .sec-h2-light { color: #f9fafb; }
    .sec-lead { font-size: 1.05rem; color: var(--muted); max-width: 560px; line-height: 1.7; margin-bottom: 48px; }

    /* Gap section */
    .gap-section { background: var(--bg); border-top: 1px solid var(--border); padding: 72px 2rem 56px; }
    .gap-inner { max-width: 820px; margin: 0 auto; }
    .gap-stack { display: flex; flex-direction: column; gap: 14px; }
    .gap-panel { border-radius: 14px; padding: 28px 32px; display: flex; gap: 22px; align-items: flex-start; }
    @media (max-width: 600px) { .gap-panel { padding: 22px 20px; gap: 16px; } }
    .gap-icon { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.6rem; font-weight: 900; line-height: 1; }
    .gap-panel-body h3 { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 14px; line-height: 1.2; }
    .gap-panel-body ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .gap-panel-body li { font-size: 0.875rem; line-height: 1.55; padding-left: 18px; position: relative; }
    .gap-panel-body li::before { content: ""; position: absolute; left: 0; top: 8px; width: 5px; height: 5px; border-radius: 50%; }

    .gap-panel-green { background: #f0fdf4; border: 1.5px solid #86efac; }
    .gap-panel-green .gap-icon { background: #16a34a; color: #fff; }
    .gap-panel-green h3 { color: #14532d; }
    .gap-panel-green li { color: #166534; }
    .gap-panel-green li::before { background: #16a34a; }

    .gap-panel-orange { background: #fff7ed; border: 1.5px solid #fdba74; }
    .gap-panel-orange .gap-icon { background: #ea580c; color: #fff; font-size: 1.4rem; }
    .gap-panel-orange h3 { color: #7c2d12; }
    .gap-panel-orange li { color: #9a3412; }
    .gap-panel-orange li::before { background: #ea580c; }

    .gap-alarm { background: #dc2626; border-radius: 14px; padding: 28px 32px; display: flex; gap: 20px; align-items: center; margin-top: 8px; }
    @media (max-width: 600px) { .gap-alarm { padding: 22px 20px; gap: 14px; flex-direction: column; } }
    .gap-alarm-icon { font-size: 2.4rem; flex-shrink: 0; line-height: 1; }
    .gap-alarm p { font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 800; color: #fff; line-height: 1.3; letter-spacing: -0.02em; }

    /* Scenarios - flip cards */
    .scenario-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @media (max-width: 760px) { .scenario-grid { grid-template-columns: 1fr; } }
    .scenario-flipcard { perspective: 1200px; cursor: pointer; height: 360px; }
    .scenario-flipcard-inner { position: relative; width: 100%; height: 100%; transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1); transform-style: preserve-3d; }
    .scenario-flipcard.flipped .scenario-flipcard-inner { transform: rotateY(180deg); }
    .scenario-face { position: absolute; inset: 0; border-radius: 12px; background: var(--navy); backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; }
    .scenario-num-bg { position: absolute; top: -12px; right: 10px; font-size: 6.5rem; font-weight: 900; color: rgba(255,255,255,0.05); line-height: 1; pointer-events: none; user-select: none; }
    .scenario-front { display: flex; flex-direction: column; padding: 28px 24px; }
    .scenario-sc-label { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 10px; }
    .scenario-front h3 { font-size: 1.15rem; font-weight: 800; color: #f9fafb; line-height: 1.25; flex: 1; }
    @keyframes revealPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(37,99,235,0.65); } 50% { box-shadow: 0 0 0 9px rgba(37,99,235,0); } }
    .reveal-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--accent); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 8px 16px; border-radius: 6px; letter-spacing: 0.02em; animation: revealPulse 1.6s ease-in-out infinite; margin-top: 24px; align-self: flex-start; }
    .scenario-back { transform: rotateY(180deg); padding: 22px 20px; display: flex; flex-direction: column; }
    .scenario-tag { display: inline-block; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #60a5fa; margin-bottom: 10px; }
    .scenario-back h3 { font-size: 0.92rem; font-weight: 800; color: #f9fafb; line-height: 1.3; margin-bottom: 12px; }
    .scenario-back p { font-size: 0.82rem; color: #9ca3af; line-height: 1.6; }
    .scenario-quote { font-style: italic; color: #cbd5e1; font-size: 0.78rem; border-left: 2px solid rgba(255,255,255,0.15); padding-left: 10px; margin-top: 12px; line-height: 1.55; }

    /* Bridge section */
    .bridge-list { display: flex; flex-direction: column; margin-top: 40px; max-width: 680px; }
    .bridge-item { display: flex; gap: 20px; align-items: flex-start; padding: 22px 0; border-bottom: 1px solid var(--border); }
    .bridge-item:last-child { border-bottom: none; }
    .bridge-icon { width: 34px; height: 34px; border-radius: 50%; background: #dcfce7; border: 1.5px solid #86efac; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.85rem; font-weight: 900; color: #16a34a; margin-top: 2px; }
    .bridge-item h4 { font-size: 1.05rem; font-weight: 800; color: var(--navy); margin-bottom: 4px; line-height: 1.25; }
    .bridge-item p { font-size: 0.875rem; color: var(--muted); line-height: 1.55; }

    /* Sprint - white section with navy cutout */
    .sprint-section { padding: 88px 2rem; background: var(--bg); }
    .sprint-section .inner { max-width: 960px; margin: 0 auto; padding: 0 2rem; }
    .sprint-box { background: var(--navy); border-radius: 16px; padding: 52px 44px; margin-top: 40px; }
    @media (max-width: 600px) { .sprint-box { padding: 36px 24px; } }
    .sprint-box-header { text-align: center; margin-bottom: 36px; }
    .sprint-badge { display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; background: rgba(37,99,235,0.25); color: #93c5fd; padding: 4px 14px; border-radius: 100px; margin-bottom: 14px; }
    .sprint-box h3 { font-size: clamp(1.3rem, 2.5vw, 1.7rem); font-weight: 800; letter-spacing: -0.025em; color: #f9fafb; margin-bottom: 8px; line-height: 1.2; }
    .sprint-box-sub { font-size: 0.95rem; color: #9ca3af; max-width: 520px; margin: 0 auto; line-height: 1.65; }
    .sprint-svg-wrap { width: 100%; max-width: 860px; margin: 0 auto 0; }
    .sprint-svg-wrap svg { width: 100%; height: auto; display: block; }
    .sprint-checklist { list-style: none; display: flex; flex-direction: column; gap: 16px; max-width: 580px; margin: 32px 0 0; }
    .sprint-check-item { display: flex; gap: 14px; align-items: flex-start; }
    .sprint-check-dot { width: 22px; height: 22px; border-radius: 50%; background: rgba(34,197,94,0.15); border: 1.5px solid rgba(34,197,94,0.35); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.62rem; color: #22c55e; font-weight: 900; margin-top: 1px; }
    .sprint-check-item strong { font-size: 0.9rem; font-weight: 700; color: #f9fafb; display: block; margin-bottom: 3px; }
    .sprint-check-item span { font-size: 0.84rem; color: #9ca3af; line-height: 1.55; display: block; }
    .sprint-cta { text-align: center; margin-top: 28px; }
    .btn-sprint { display: inline-block; font-size: 0.9rem; font-weight: 700; text-decoration: none; padding: 12px 24px; border-radius: 4px; background: var(--accent); color: #fff; transition: background 0.15s; }
    .btn-sprint:hover { background: var(--accent-dark); }

    /* Retainer */
    .retainer-anim { background: var(--navy); border-radius: 14px; padding: 32px; margin-bottom: 32px; }
    .retainer-anim svg { width: 100%; height: auto; display: block; }
    .retainer-bullets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @media (max-width: 700px) { .retainer-bullets { grid-template-columns: 1fr; } }
    .retainer-bullet { display: flex; gap: 12px; align-items: flex-start; }
    .retainer-bullet-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); flex-shrink: 0; margin-top: 7px; }
    .retainer-bullet-text { font-size: 0.875rem; color: var(--sub); line-height: 1.6; }
    .retainer-bullet-text strong { color: var(--navy); }

    /* Retainer engine animation */
    .cevt rect { transition: fill 0.4s, stroke 0.4s; }
    .cevt text { transition: fill 0.4s; }
    .cevt.active rect { fill: #0f2040 !important; stroke: #3b82f6 !important; }
    .cevt.active text { fill: #93c5fd !important; }
    #fn-fs rect, #fn-tax rect, #fn-ap rect, #fn-it rect { transition: fill 0.3s, stroke 0.3s; }
    .fn-lit rect { fill: #071a0f !important; stroke: #22c55e !important; }
    .fn-lit text { fill: #86efac !important; }
    @keyframes ring-pulse { 0%,100% { stroke-width:0; opacity:0; } 40% { stroke-width:8; opacity:0.35; } }

    /* Contact */
    .contact-section { padding: 88px 2rem; background: var(--bg); }
    .contact-box { background: var(--navy); border-radius: 16px; padding: 56px 48px; text-align: center; max-width: 680px; margin: 0 auto; }
    @media (max-width: 600px) { .contact-box { padding: 40px 24px; } }
    .contact-box h2 { font-size: clamp(1.25rem, 2.5vw, 1.6rem); font-weight: 800; color: #f9fafb; letter-spacing: -0.025em; margin-bottom: 12px; line-height: 1.3; }
    .contact-box p { font-size: 0.95rem; color: #9ca3af; margin-bottom: 28px; line-height: 1.65; max-width: 460px; margin-left: auto; margin-right: auto; }
    .contact-btn { display: inline-block; font-size: 0.95rem; font-weight: 700; text-decoration: none; padding: 13px 26px; border-radius: 4px; background: var(--accent); color: #fff; transition: background 0.15s; letter-spacing: 0.02em; }
    .contact-btn:hover { background: var(--accent-dark); }

    footer { background: var(--navy); color: rgba(255,255,255,0.45); padding: 24px 2rem; text-align: center; font-size: 0.8rem; display: flex; flex-direction: column; gap: 6px; }
    footer a { color: rgba(255,255,255,0.45); text-decoration: none; }
    footer a:hover { color: white; }
    .disclaimer { background: var(--bg-alt); border-top: 1px solid var(--border); padding: 20px 2rem; text-align: center; }
    .disclaimer p { font-size: 0.72rem; color: #9ca3af; max-width: 720px; margin: 0 auto; line-height: 1.65; }

    /* Mobile animation replacements */
    .sprint-mobile { display: none; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 16px; }
    .sm-section-label { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #60a5fa; margin-bottom: 10px; }
    .sm-input-row { font-size: 0.78rem; color: #9ca3af; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; gap: 8px; }
    .sm-input-row:last-child { border-bottom: none; }
    .sm-dot { width: 6px; height: 6px; border-radius: 50%; background: #3b82f6; flex-shrink: 0; }
    .sm-down { text-align: center; font-size: 1.2rem; color: rgba(255,255,255,0.25); padding: 8px 0; }
    .sm-timeline { background: rgba(30,64,175,0.15); border: 1px solid rgba(96,165,250,0.2); border-radius: 8px; padding: 12px 14px; margin-bottom: 4px; }
    .sm-timeline-title { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; color: #f9fafb; text-transform: uppercase; margin-bottom: 10px; text-align: center; }
    .sm-week { font-size: 0.74rem; color: #9ca3af; padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; gap: 8px; }
    .sm-week:last-child { border-bottom: none; }
    .sm-week-num { font-size: 0.62rem; font-weight: 700; color: #60a5fa; min-width: 48px; }
    .sm-week-done { color: #22c55e; }
    .sm-week-done .sm-week-num { color: #22c55e; }
    .sm-card { border-radius: 8px; padding: 11px 13px; margin-bottom: 5px; }
    .sm-card:last-child { margin-bottom: 0; }
    .sm-card-title { font-size: 0.74rem; font-weight: 700; margin-bottom: 6px; }
    .sm-card-item { font-size: 0.68rem; color: #9ca3af; padding: 1px 0; }
    .sm-card-fs { background: rgba(30,64,175,0.2); border: 1px solid rgba(96,165,250,0.3); }
    .sm-card-fs .sm-card-title { color: #93c5fd; }
    .sm-card-tax { background: rgba(133,77,14,0.2); border: 1px solid rgba(251,191,36,0.25); }
    .sm-card-tax .sm-card-title { color: #fbbf24; }
    .sm-card-it { background: rgba(22,78,99,0.3); border: 1px solid rgba(103,232,249,0.2); }
    .sm-card-it .sm-card-title { color: #67e8f9; }
    .ret-mobile { display: none; }
    .rm-event { background: #141c2b; border: 1px solid #1e3a5f; border-radius: 6px; padding: 9px 12px; margin-bottom: 5px; }
    .rm-event:last-child { margin-bottom: 0; }
    .rm-event-name { font-size: 0.78rem; color: #94a3b8; font-family: -apple-system, sans-serif; }
    .rm-event-sub { font-size: 0.68rem; color: #64748b; font-family: monospace; display: block; margin-top: 2px; }
    .rm-down { text-align: center; font-size: 1.2rem; color: rgba(255,255,255,0.25); padding: 8px 0; }
    .rm-engine { background: linear-gradient(135deg, #1e3a5f, #0f1e2c); border: 1px solid #3b82f6; border-radius: 10px; padding: 14px; text-align: center; }
    .rm-engine-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #93c5fd; margin-bottom: 4px; }
    .rm-engine-sub { font-size: 0.62rem; color: #475569; font-family: monospace; }
    .rm-owner { background: #111827; border: 1px solid #1e293b; border-radius: 7px; padding: 9px 12px; margin-bottom: 5px; }
    .rm-owner:last-child { margin-bottom: 0; }
    .rm-owner-name { font-size: 0.78rem; font-weight: 600; color: #cbd5e1; }
    .rm-owner-sub { font-size: 0.65rem; color: #64748b; font-family: monospace; margin-top: 2px; }
    .rm-step-label { font-size: 0.72rem; font-weight: 700; color: #94a3b8; margin-bottom: 10px; letter-spacing: 0.02em; }
    .rm-countries-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
    .rm-flag-item { background: #141c2b; border: 1px solid #1e3a5f; border-radius: 6px; padding: 8px 12px; font-size: 0.78rem; font-weight: 600; color: #93c5fd; }
    .rm-plus-more { font-size: 0.65rem; color: #475569; margin-bottom: 2px; }

    @media (max-width: 768px) {
      .sp-hero { padding: 56px 1.25rem 48px; }
      .section { padding: 56px 1.25rem; }
      .contact-section { padding: 56px 1.25rem; }
      .inner { padding: 0 1.25rem; }
      .sprint-svg-wrap { display: none; }
      .sprint-mobile { display: block; }
      .retainer-anim { padding: 20px 16px; }
      .retainer-anim svg { display: none !important; }
      .ret-mobile { display: block; }
    }

    @media (max-width: 480px) {
      .sp-hero { padding: 44px 1rem 40px; }
      .section { padding: 44px 1rem; }
      .contact-section { padding: 44px 1rem; }
      .inner { padding: 0 1rem; }
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">einvoice<span>ops</span></a>
  <div class="nav-links">
    <a href="/for-enterprises/" class="hide-mobile">For Enterprises</a>
    <a href="/for-service-providers/" class="hide-mobile">For Finance Platform Service Providers</a>
    <a href="/#calculator" class="hide-mobile">Mandate Cost Calculator</a>
    <a href="/#map" class="hide-mobile">Compliance Map</a>
    <a href="/#faq" class="hide-mobile">FAQ</a>
    <a href="/#contact" class="btn-nav">Get in touch</a>
    <button class="hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
