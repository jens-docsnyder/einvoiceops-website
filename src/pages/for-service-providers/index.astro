<script>
(function() {
  var EVENTS = [
    { cc:'FR', yc:42,  targets:['fn-fs','fn-tax'] },
    { cc:'DE', yc:90,  targets:['fn-fs','fn-it']  },
    { cc:'PL', yc:138, targets:['fn-fs','fn-tax'] },
    { cc:'IT', yc:186, targets:['fn-tax','fn-ap'] },
    { cc:'BE', yc:234, targets:['fn-fs']           },
    { cc:'NL', yc:282, targets:['fn-it','fn-fs']  },
  ];
  var FN_Y = { 'fn-fs':90, 'fn-tax':166, 'fn-ap':242, 'fn-it':318 };
  var TRUNK_X = 614, ENGINE_OUTLET_X = 544, ENGINE_INLET_X = 336, ENGINE_CENTER_Y = 205;

  var deck = [];
  function nextEvt() {
    if (!deck.length) { deck = EVENTS.slice().sort(function() { return Math.random() - 0.5; }); }
    return deck.pop();
  }

  var doc  = document.getElementById('ret-doc');
  var wp   = document.getElementById('ret-wp');
  var arr  = document.getElementById('ret-active-arrow');
  var ring = document.getElementById('ret-engine-ring');
  var dots = ['ret-dot1','ret-dot2','ret-dot3'].map(function(id) { return document.getElementById(id); });
  var cites = ['ret-cite1','ret-cite2','ret-cite3','ret-cite4'].map(function(id) { return document.getElementById(id); });
  var scanLine = document.getElementById('ret-scanner');

  if (!doc) return;

  function setEl(el, x, y, op) {
    el.setAttribute('transform', 'translate(' + x + ',' + y + ')');
    el.setAttribute('opacity', op);
  }

  function moveTo(el, x0, y0, x1, y1, dur, ease, onDone) {
    var start = performance.now();
    function tick(now) {
      var t = Math.min((now - start) / dur, 1);
      t = ease(t);
      setEl(el, x0 + (x1-x0)*t, y0 + (y1-y0)*t, 1);
      if (t < 1) requestAnimationFrame(tick);
      else if (onDone) onDone();
    }
    requestAnimationFrame(tick);
  }

  var easeOut   = function(t) { return 1 - Math.pow(1-t, 2.5); };
  var easeInOut = function(t) { return t<0.5 ? 2*t*t : 1-Math.pow(-2*t+2,2)/2; };

  function showArrow(yc) {
    arr.setAttribute('d', 'M198,' + yc + ' C268,' + yc + ' 268,' + ENGINE_CENTER_Y + ' ' + ENGINE_INLET_X + ',' + ENGINE_CENTER_Y);
    arr.setAttribute('opacity', '1');
    setTimeout(function() { arr.setAttribute('opacity','0'); }, 2200);
  }

  function pulseRing() {
    ring.style.animation = 'none';
    void ring.offsetWidth;
    ring.style.animation = 'ring-pulse 1s ease-in-out';
  }

  var dotTimer = null, dotPhase = 0;
  function startDots() {
    if (dotTimer) return;
    dotTimer = setInterval(function() {
      dots.forEach(function(d, i) { d.setAttribute('fill', i === dotPhase % 3 ? '#3b82f6' : '#1e293b'); });
      dotPhase++;
    }, 200);
  }
  function stopDots() {
    clearInterval(dotTimer); dotTimer = null;
    dots.forEach(function(d) { d.setAttribute('fill', '#1e293b'); });
  }

  function runScanner(onDone) {
    var dur = 1400, x0 = 338, x1 = 570, start = performance.now();
    scanLine.setAttribute('opacity','0.7');
    cites.forEach(function(c) { c.setAttribute('opacity','0'); });
    var positions = [0.2, 0.4, 0.6, 0.8];
    function tick(now) {
      var t = Math.min((now - start) / dur, 1);
      scanLine.setAttribute('x', x0 + (x1-x0)*t);
      cites.forEach(function(c, i) {
        c.setAttribute('opacity', t > positions[i] ? Math.min((t - positions[i]) / 0.15, 1) * 0.85 : 0);
      });
      if (t < 1) requestAnimationFrame(tick);
      else { scanLine.setAttribute('opacity','0'); if (onDone) onDone(); }
    }
    requestAnimationFrame(tick);
  }

  function routeWP(fnId, delay, onDone) {
    var fnY = FN_Y[fnId];
    var ox = ENGINE_OUTLET_X, oy = ENGINE_CENTER_Y, tx = TRUNK_X;
    setTimeout(function() {
      setEl(wp, ox, oy, 1);
      moveTo(wp, ox, oy, tx, oy, 700, easeInOut, function() {
        moveTo(wp, tx, oy, tx, fnY, Math.abs(fnY-oy)*3.2, easeInOut, function() {
          moveTo(wp, tx, fnY, 630, fnY, 500, easeOut, function() {
            var fnEl = document.getElementById(fnId);
            if (fnEl) fnEl.classList.add('fn-lit');
            setTimeout(function() {
              if (fnEl) fnEl.classList.remove('fn-lit');
              wp.setAttribute('opacity','0');
              if (onDone) onDone();
            }, 800);
          });
        });
      });
    }, delay);
  }

  function runCycle() {
    var evt = nextEvt();
    document.querySelectorAll('.cevt').forEach(function(e) { e.classList.remove('active'); });
    var evtEl = document.getElementById('evt-' + evt.cc);
    if (evtEl) evtEl.classList.add('active');
    showArrow(evt.yc);
    setEl(doc, 196, evt.yc, 1);
    moveTo(doc, 196, evt.yc, ENGINE_INLET_X, ENGINE_CENTER_Y, 2000, easeInOut, function() {
      doc.setAttribute('opacity','0');
      pulseRing();
      startDots();
      runScanner(function() {
        evt.targets.forEach(function(fnId, i) {
          var isLast = i === evt.targets.length - 1;
          routeWP(fnId, i * 1800, isLast ? function() {
            stopDots();
            cites.forEach(function(c) { c.setAttribute('opacity','0'); });
            setTimeout(runCycle, 1400);
          } : null);
        });
      });
    });
  }

  var scene = document.getElementById('retainer-scene');
  if (scene) {
    var obs = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) { obs.disconnect(); runCycle(); }
    }, { threshold: 0.3 });
    obs.observe(scene);
  }
})();
</script>

