---
import StoryPage from '../../components/site/StoryPage.astro';
import { de as c, deBodies, deBodyKeys } from '../../data/stories/de';
import fanoutFile from '../../data/fanout/DE.json';
import { publications, withBodies, warnBodies } from '../../components/site/format';

// Published at /germany/ with noindex, linked from nowhere. Fan-out data: src/data/fanout/DE.json, written from the product
// data after each weekly run; no count on the page is typed.
//
// Every change in the file carries its issuing body (key "body": law, ministry, kosit, ferd). deBodies in de.ts is only a
// fallback for a change the file gives none; a change with neither stops the build and is named. The split by body, the
// count since January 2025 and the box count are computed from the file (format.ts). A body the copy does not list, or a day
// on which two bodies both published (so the split would add up to more than the boxes), only warns in the build log.
// What stops the build: the list of changes and the released total disagree (publications() has no answer then), or a
// change has no body.
if ((fanoutFile.changes ?? []).length !== fanoutFile.total) {
  throw new Error(`Germany page: DE.json holds ${(fanoutFile.changes ?? []).length} changes but a total of ${fanoutFile.total}; the boxes and the counts would disagree.`);
}
if (!publications(fanoutFile)) {
  throw new Error('Germany page: the changes list does not agree with the released total; the box count cannot be checked.');
}
const fanout = withBodies(fanoutFile, deBodies, 'Germany page: DE.json');
warnBodies('Germany page', fanout, deBodyKeys);
---
<StoryPage c={c} fanout={fanout} page="/germany/" segment="standalone" country="DE" fanoutDisclosure={c.disclosure} />
