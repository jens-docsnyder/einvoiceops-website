<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>For Enterprise Finance Teams | einvoiceops</title>
  <meta name="description" content="Structured mandate readiness for enterprise finance teams. Fixed scope, fixed fee. France PA, Poland KSeF, Germany B2B - mapped by internal role, routed to the right owners." />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:        #1a2b3c;
      --navy-soft:   #243447;
      --accent:      #2563eb;
      --accent-dark: #1d4ed8;
      --text:        #111827;
      --sub:         #374151;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --bg:          #ffffff;
      --bg-alt:      #f8f9fa;
      --ice:         #eff6ff;
      --teal:        #0f766e;
      --teal-light:  #f0fdfa;
      --teal-border: #99f6e4;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Nav ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem; height: 60px;
      display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    }
    .logo {
      font-size: 1.05rem; font-weight: 800;
      letter-spacing: -0.03em; color: var(--navy);
      text-decoration: none; white-space: nowrap;
    }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a {
      font-size: 0.875rem; color: var(--muted);
      text-decoration: none; font-weight: 500; transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--text); }
    nav a.btn-nav {
      font-size: 0.875rem; font-weight: 600;
      color: var(--bg); background: var(--accent);
      text-decoration: none; padding: 8px 18px;
      border-radius: 8px; transition: background 0.15s;
    }
    nav a.btn-nav:hover { background: var(--accent-dark); }
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 36px; height: 36px;
      background: none; border: none; cursor: pointer;
      padding: 4px; border-radius: 6px;
      transition: background 0.15s;
    }
    .hamburger:hover { background: rgba(0,0,0,0.06); }
    .hamburger span {
      display: block; width: 22px; height: 2px;
      background: var(--navy); border-radius: 2px;
      transition: transform 0.2s, opacity 0.2s;
      transform-origin: center;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu {
      display: none;
      position: fixed;
      top: 60px; left: 0; right: 0;
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 99;
      flex-direction: column;
      padding: 1rem 1.5rem 1.5rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-size: 1rem; font-weight: 500;
      color: var(--text); text-decoration: none;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }
    .mobile-menu a:last-child { border-bottom: none; padding-bottom: 0; }
    .mobile-menu a:hover { color: var(--accent); }
    @media (max-width: 600px) {
      .nav-links .hide-mobile { display: none; }
      .hamburger { display: flex; }
    }

    /* ── Hero ── */
    .page-hero {
      background: var(--navy);
      color: white;
      padding: 80px 2rem 72px;
      text-align: center;
    }
    .page-eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.5); margin-bottom: 20px;
    }
    .page-hero h1 {
      font-size: clamp(1.65rem, 3.5vw, 2.4rem);
      font-weight: 800; letter-spacing: -0.03em;
      color: #ffffff; max-width: 760px;
      margin: 0 auto 20px; line-height: 1.2;
    }
    .page-hero p {
      font-size: 1.05rem; color: rgba(255,255,255,0.65);
      max-width: 600px; margin: 0 auto; line-height: 1.7;
    }

    /* ── Layout ── */
    .inner { max-width: 1000px; margin: 0 auto; padding: 0 2rem; }
    .section { padding: 72px 0; }
    .section.bg-alt { background: var(--bg-alt); }

    /* ── Two-column cards ── */
    .angles-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 760px) {
      .angles-grid { grid-template-columns: 1fr; }
    }

    .angle-card {
      border-radius: 16px;
      padding: 36px 32px;
      border: 2px solid;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .angle-card.angle-sprint {
      background: var(--ice);
      border-color: var(--accent);
    }
    .angle-card.angle-retainer {
      background: var(--teal-light);
      border-color: var(--teal-border);
    }

    .angle-tag {
      display: inline-block;
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 100px;
    }
    .angle-sprint .angle-tag { background: var(--accent); color: #fff; }
    .angle-retainer .angle-tag { background: var(--teal); color: #fff; }

    .angle-card h2 {
      font-size: 1.25rem; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.25;
      color: var(--navy);
    }

    .angle-pain {
      font-size: 0.9rem; color: var(--sub);
      line-height: 1.7;
      padding: 14px 16px;
      background: rgba(255,255,255,0.7);
      border-radius: 10px;
      border-left: 3px solid;
    }
    .angle-sprint .angle-pain { border-color: var(--accent); }
    .angle-retainer .angle-pain { border-color: var(--teal); }

    .angle-what-label {
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--muted);
    }

    .angle-bullets {
      list-style: none; padding: 0;
      display: flex; flex-direction: column; gap: 10px;
    }
    .angle-bullets li {
      font-size: 0.875rem; color: var(--sub);
      line-height: 1.6;
      padding-left: 20px;
      position: relative;
    }
    .angle-bullets li::before {
      content: '\00B7';
      position: absolute; left: 4px;
      font-weight: 700; font-size: 1.1rem; line-height: 1.5;
    }
    .angle-sprint .angle-bullets li::before { color: var(--accent); }
    .angle-retainer .angle-bullets li::before { color: var(--teal); }

    .angle-price {
      font-size: 0.85rem; color: var(--sub);
      line-height: 1.6;
      padding: 12px 14px;
      background: rgba(255,255,255,0.6);
      border-radius: 8px;
      border-left: 3px solid;
    }
    .angle-sprint .angle-price { border-color: var(--accent); }
    .angle-retainer .angle-price { border-color: var(--teal); }
    .angle-price strong { color: var(--navy); }

    .angle-fit {
      font-size: 0.8rem; color: var(--muted);
      line-height: 1.6;
      border-top: 1px solid rgba(0,0,0,0.08);
      padding-top: 16px;
    }
    .angle-fit strong { color: var(--sub); }

    .angle-cta {
      display: inline-block;
      font-size: 0.875rem; font-weight: 700;
      text-decoration: none;
      padding: 10px 20px; border-radius: 8px;
      transition: opacity 0.15s;
      align-self: flex-start;
    }
    .angle-cta:hover { opacity: 0.85; }
    .angle-sprint .angle-cta { background: var(--accent); color: #fff; }
    .angle-retainer .angle-cta { background: var(--teal); color: #fff; }

    /* ── Intro strip ── */
    .intro-strip {
      text-align: center;
      padding-bottom: 48px;
    }
    .eyebrow {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 12px;
    }
    .intro-strip h2 {
      font-size: clamp(1.3rem, 2.5vw, 1.7rem);
      font-weight: 800; letter-spacing: -0.02em;
      color: var(--navy); line-height: 1.25;
      max-width: 640px; margin: 0 auto 14px;
    }
    .intro-strip p {
      font-size: 0.95rem; color: var(--sub);
      line-height: 1.7; max-width: 560px; margin: 0 auto;
    }

    /* ── Contact ── */
    .contact-box {
      background: var(--navy); border-radius: 20px;
      padding: 56px 48px; text-align: center;
    }
    @media (max-width: 600px) { .contact-box { padding: 40px 24px; } }
    .contact-box h2 {
      font-size: clamp(1.2rem, 2.5vw, 1.55rem);
      font-weight: 800; color: #ffffff;
      letter-spacing: -0.02em; margin-bottom: 12px; line-height: 1.3;
    }
    .contact-box p {
      font-size: 0.95rem; color: rgba(255,255,255,0.65);
      margin-bottom: 28px; line-height: 1.65;
      max-width: 460px; margin-left: auto; margin-right: auto;
    }
    .email-link {
      font-size: 1.1rem; font-weight: 700;
      color: #ffffff; text-decoration: none;
      border-bottom: 2px solid rgba(255,255,255,0.3);
      padding-bottom: 2px; transition: border-color 0.15s;
    }
    .email-link:hover { border-color: #ffffff; }

    footer {
      background: var(--navy); color: rgba(255,255,255,0.45);
      padding: 24px 2rem; text-align: center;
      font-size: 0.8rem; display: flex;
      flex-direction: column; gap: 6px;
    }
    footer a { color: rgba(255,255,255,0.45); text-decoration: none; }
    footer a:hover { color: white; }

    .disclaimer {
      background: var(--bg-alt); border-top: 1px solid var(--border);
      padding: 20px 2rem; text-align: center;
    }
    .disclaimer p {
      font-size: 0.72rem; color: #9ca3af;
      max-width: 720px; margin: 0 auto; line-height: 1.65;
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">einvoice<span>ops</span></a>
  <div class="nav-links">
    <a href="/#calculator" class="hide-mobile">Mandate Cost Calculator</a>
    <a href="/services/" class="hide-mobile">Services</a>
    <a href="/map/" class="hide-mobile">Compliance Map</a>
    <a href="/#faq" class="hide-mobile">FAQ</a>
    <a href="/#contact" class="btn-nav">Get in touch</a>
    <button class="hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/#calculator">Mandate Cost Calculator</a>
  <a href="/services/">Services</a>
  <a href="/map/">Compliance Map</a>
  <a href="/#faq">FAQ</a>
  <a href="/#contact">Get in touch</a>
</div>

<div class="page-hero">
  <span class="page-eyebrow">For enterprise finance teams</span>
  <h1>Three teams own e-invoice mandate preparation: Finance Systems, Tax, and Finance Ops. None has the full picture of what the others are doing. That gap is where go-lives break.</h1>
  <p>France: September 2026. Poland: already live. Germany: January 2027. We map what your organisation needs to have ready - role by role, mandate by mandate - and route the work to the right owners.</p>
</div>

<section class="section">
  <div class="inner">

    <div class="intro-strip">
      <span class="eyebrow">Two engagement models</span>
      <h2>One urgent deadline or a sequence across countries.</h2>
      <p>Whether you have one mandate landing imminently or several arriving across countries in the next 18 months, the internal preparation problem is the same: nobody has mapped it. Here is how we work together to close it.</p>
    </div>

    <div class="angles-grid">

      <!-- Card 1: Readiness Sprint -->
      <div class="angle-card angle-sprint">
        <span class="angle-tag">One mandate. One country.</span>
        <h2>Readiness Sprint - map the work before the deadline arrives</h2>

        <p class="angle-pain">The gap between "mandate known" and "ERP ready" is specific and mappable. Finance Systems, Tax, AP Operations, and IT each have distinct work to do - different owners, different timelines, rarely coordinated. We produce the full internal readiness picture before your deadline.</p>

        <span class="angle-what-label">What you receive</span>
        <ul class="angle-bullets">
          <li>ERP footprint audit for the mandate in scope - what your systems need to do</li>
          <li>Work items mapped by internal role: Finance Systems, Tax, AP Operations, IT</li>
          <li>Inbound and outbound flows covered separately - because the deadlines almost never match</li>
          <li>Named owners, clear action sequence, no ambiguity about who does what</li>
          <li>Source-linked, non-authoritative - every claim traceable, no compliance interpretation</li>
          <li>Delivered in 4 weeks</li>
        </ul>

        <p class="angle-price"><strong>EUR 24,500.</strong> 50% on engagement start, 50% on delivery. Fixed scope, fixed fee - no hourly billing, no scope creep.</p>

        <p class="angle-fit"><strong>Who this fits:</strong> Lean finance team with one urgent mandate deadline. No internal bandwidth to run the mapping exercise in parallel with BAU. Needs a clear owner map and work sequence in writing before go-live.</p>

        <a href="/#contact" class="angle-cta">Talk about the Sprint</a>
      </div>

      <!-- Card 2: Retainer -->
      <div class="angle-card angle-retainer">
        <span class="angle-tag">Multiple mandates. Multiple countries.</span>
        <h2>60-day Retainer - ongoing coverage as mandates arrive in sequence</h2>

        <p class="angle-pain">France and Germany and Poland are not a one-time event. Mandates update. Implementation guidance shifts. Your ERP configuration that was correct in January may need a delta check by June. And if you have entities in four countries with live or imminent mandates, a single Sprint does not cover the full footprint.</p>

        <span class="angle-what-label">What you receive</span>
        <ul class="angle-bullets">
          <li>Sprint deliverables for your primary mandate, plus delta monitoring for the 60-day window</li>
          <li>Mandate change alerts when official guidance updates in your active countries</li>
          <li>Coverage across mandates running in parallel - France + Germany + Poland treated as a coordinated programme</li>
          <li>Structured hand-off to your ERP team at each milestone</li>
          <li>One point of contact across all mandates in scope</li>
        </ul>

        <p class="angle-price"><strong>Pricing on scope.</strong> Typically scoped after an initial Sprint or in a joint scoping call. Depends on number of active mandates and entity footprint.</p>

        <p class="angle-fit"><strong>Who this fits:</strong> Multi-country group with mandates landing in sequence over the next 12-18 months. Or a single high-complexity mandate with ongoing uncertainty - KSeF update risk, PDP platform changes, or a mid-year ERP migration collision.</p>

        <a href="/#contact" class="angle-cta">Talk about the Retainer</a>
      </div>

    </div>
  </div>
</section>

<section class="section bg-alt" id="contact">
  <div class="inner">
    <div class="contact-box">
      <h2>Not sure which fits? Send your country footprint.</h2>
      <p>Tell us which mandates are live or imminent for your entities. We come back with a frank read of your situation in writing within 48 hours - no call required to start.</p>
      <a href="/#contact" class="angle-cta" style="background: var(--accent); color: #fff;">Get in touch</a>
    </div>
  </div>
</section>

<footer>
  <p>einvoiceops &nbsp;&middot;&nbsp; <a href="mailto:jens@einvoiceops.eu">jens@einvoiceops.eu</a> &nbsp;&middot;&nbsp; Finland</p>
  <p>&copy; 2026 einvoiceops &nbsp;&middot;&nbsp; <a href="/legal/">Legal Notice</a> &nbsp;&middot;&nbsp; <a href="/privacy/">Privacy Policy</a></p>
</footer>

<div class="disclaimer">
  <p>einvoiceops provides operational readiness support and is not a tax advisor, legal advisor, or compliance authority. All content is informational and operational planning support only. Customers remain responsible for all compliance decisions and their execution.</p>
</div>

<script>
  (function () {
    const btn = document.getElementById('nav-hamburger');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    function closeMenu() {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', () => {
      const opening = !menu.classList.contains('open');
      if (opening) { btn.classList.add('open'); menu.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
      else closeMenu();
    });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('click', e => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
  })();
</script>

</body>
</html>
